// ============================================================================
// StateSSA 08_midi_player: synth_pipeline.ssa
// Unified Synthesis Instrument Orchestrator (PreFilter -> MultiCore -> PostFilter)
// Backed by multichannel_fm_core.ssa and filter_shell.ssa (2D Adaptive Matrix)
// ============================================================================

include "midi_types.ssa";
include "multichannel_fm_core.ssa";
include "filter_shell.ssa";

extern "C" {
    fn malloc(sz: u32) -> *u8;
    fn free(p: *u8) -> void;
}

// ----------------------------------------------------------------------------
// Machine: SynthPipeline_Create
// ----------------------------------------------------------------------------
machine SynthPipeline_Create(total_blocks: u32, is_stereo: i1, nc_mode: u32) -> *UnifiedSynth {
    flow {
        reg synth_ptr: *UnifiedSynth = null;
    }
    states {
        Entry: {
            let p_mem = call malloc(64);
            let synth = cast(*UnifiedSynth) p_mem;

            // Scratch buffers: 2048 samples * 4 bytes (f32) = 8192 bytes
            let p_raw_l = call malloc(8192);
            let p_raw_r = call malloc(8192);
            // PCM buffer: 4096 samples * 2 bytes (i16) = 8192 bytes
            let p_pcm   = call malloc(8192);

            let core = call MultiChannel_Create(total_blocks, is_stereo);
            let filter = call Filter_Create(nc_mode, cast(f32) 44100.0);

            synth.core        <- core;
            synth.filter      <- filter;
            synth.is_stereo   <- is_stereo;
            synth.raw_l_buf   <- cast(*f32) p_raw_l;
            synth.raw_r_buf   <- cast(*f32) p_raw_r;
            synth.pcm_out_buf <- cast(*i16) p_pcm;

            _ => return synth;
        }
    }
}

// ----------------------------------------------------------------------------
// Machine: SynthPipeline_Destroy
// ----------------------------------------------------------------------------
machine SynthPipeline_Destroy(synth: *UnifiedSynth) -> void {
    flow {}
    states {
        Entry: {
            synth == null => Return;
            _ => DoDestroy;
        }

        DoDestroy: {
            let c = synth.core;
            let _ = call MultiChannel_Destroy(c);

            let f = synth.filter;
            let _ = call Filter_Destroy(f);

            let pl = synth.raw_l_buf;
            let pr = synth.raw_r_buf;
            let pp = synth.pcm_out_buf;

            let _ = call free(cast(*u8) pl);
            let _ = call free(cast(*u8) pr);
            let _ = call free(cast(*u8) pp);
            let _ = call free(cast(*u8) synth);
            _ => Return;
        }

        Return: {
            _ => return;
        }
    }
}

// ----------------------------------------------------------------------------
// Machine: SynthPipeline_SetPHSBase
// ----------------------------------------------------------------------------
machine SynthPipeline_SetPHSBase(synth: *UnifiedSynth, peak_voices: u32) -> void {
    flow {}
    states {
        Entry: {
            synth == null => Return;
            let f = synth.filter;
            let _ = call Filter_SetPHSBase(f, peak_voices);
            _ => Return;
        }
        Return: {
            _ => return;
        }
    }
}

// ----------------------------------------------------------------------------
// Machine: SynthPipeline_SetVoice
// Pre-filters voice parameters, then dispatches to multi-channel core
// ----------------------------------------------------------------------------
machine SynthPipeline_SetVoice(
    synth: *UnifiedSynth,
    voice_idx: u32,
    params: *SpatialVoiceParams
) -> void {
    flow {}
    states {
        Entry: {
            synth == null => Return;

            // 1. Pre-Filter Stage: Apply PHS & dynamic feedback trim
            let f = synth.filter;
            let _ = call Filter_PreProcessVoice(f, params);

            // 2. Dispatch to Multi-Channel FM Core
            let c = synth.core;
            let _ = call MultiChannel_SetVoice(c, voice_idx, params);
            _ => Return;
        }

        Return: {
            _ => return;
        }
    }
}

// ----------------------------------------------------------------------------
// Machine: SynthPipeline_SilenceVoice
// ----------------------------------------------------------------------------
machine SynthPipeline_SilenceVoice(synth: *UnifiedSynth, voice_idx: u32) -> void {
    flow {}
    states {
        Entry: {
            synth == null => Return;
            let c = synth.core;
            let _ = call MultiChannel_SilenceVoice(c, voice_idx);
            _ => Return;
        }

        Return: {
            _ => return;
        }
    }
}

// ----------------------------------------------------------------------------
// Machine: SynthPipeline_Render
// Renders num_samples through MultiCore -> PostFilter into out_pcm
// Handles arbitrary sample spans safely via 2048-sample chunking loop
// ----------------------------------------------------------------------------
machine SynthPipeline_Render(
    synth: *UnifiedSynth,
    out_pcm: *i16,
    num_samples: u32
) -> void {
    flow {
        reg total_rendered: u32 = 0;
        reg rem_samples:    u32 = 0;
        reg cur_chunk:      u32 = 0;
    }
    states {
        Entry: {
            num_samples == 0 => Return;
            _ => StartChunking [ rem_samples <= num_samples, total_rendered <= 0 ];
        }

        StartChunking: {
            rem_samples == 0 => Return;
            rem_samples > 2048 => ChunkIsMax;
            _ => ChunkIsRem;
        }

        ChunkIsMax: {
            _ => ExecChunkRender [ cur_chunk <= 2048 ];
        }

        ChunkIsRem: {
            _ => ExecChunkRender [ cur_chunk <= rem_samples ];
        }

        ExecChunkRender: {
            let c = synth.core;
            let f = synth.filter;
            let raw_l = synth.raw_l_buf;
            let raw_r = synth.raw_r_buf;
            let st = synth.is_stereo;

            // 1. Synthesize Raw float wave in Multi-Channel Core
            let _ = call MultiChannel_RenderRaw(c, raw_l, raw_r, cur_chunk);

            // 2. Post-Filter Stage: Stereo Link, PF IIR, Feedback & PCM conversion
            let _ = call Filter_PostProcessInterleave(f, raw_l, raw_r, out_pcm, cur_chunk, total_rendered, st);

            _ => AdvanceChunk;
        }

        AdvanceChunk: {
            let next_rem = rem_samples - cur_chunk;
            let next_total = total_rendered + cur_chunk;
            _ => StartChunking [ rem_samples <= next_rem, total_rendered <= next_total ];
        }

        Return: {
            _ => return;
        }
    }
}
