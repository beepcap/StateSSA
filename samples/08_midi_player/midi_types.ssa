// ============================================================================
// StateSSA 08_midi_player: midi_types.ssa
// Common Type Definitions & Data Structures for Multi-Track SMF Synthesizer
// ============================================================================

include "poly_fm_engine.ssa";

// ----------------------------------------------------------------------------
// Type: MidiHeader
// Parsed Standard MIDI File MThd Header
// ----------------------------------------------------------------------------
type MidiHeader = {
    format:     u16,   // 0 = single track, 1 = multi-track parallel
    num_tracks: u16,   // Total track chunks (M)
    division:   u16    // Ticks per quarter note (e.g. 384, 480)
};

// ----------------------------------------------------------------------------
// Type: TrackCursor
// Streaming state cursor for an active MTrk track
// ----------------------------------------------------------------------------
type TrackCursor = {
    ptr:            *u8,   // Current read pointer in track data
    end_ptr:        *u8,   // Track chunk boundary pointer
    wait_ticks:     u32,   // Remaining ticks until next event dispatch
    running_status: u8,    // Last active MIDI status byte for running status
    is_active:      u8     // 1: Track has pending events, 0: End of Track (0x2F)
};

// ----------------------------------------------------------------------------
// Type: SpatialVoiceParams
// Acoustic and physical parameters generated by spatial_stage.ssa
// ----------------------------------------------------------------------------
type SpatialVoiceParams = {
    dphi_L:    f32,   // Phase delta for Left FM pipeline
    dphi_R:    f32,   // Phase delta for Right FM pipeline
    cm_ratio:  f32,   // Carrier to Modulator frequency ratio
    base_mod:  f32,   // Modulation index (air-damped by stage depth Y)
    gain_L:    f32,   // Left channel amplitude gain
    gain_R:    f32,   // Right channel amplitude gain
    gain_mono: f32    // Folded mono amplitude gain
};

// ----------------------------------------------------------------------------
// Type: MidiEvent
// Dispatched event from midi_parser.ssa
// ----------------------------------------------------------------------------
type MidiEvent = {
    event_type: u8,   // 1: Note-On, 2: Note-Off, 3: Set-Tempo, 4: End-Of-Track, 0: Other
    channel:    u8,   // MIDI channel 0..15
    note:       u8,   // MIDI note number 0..127
    velocity:   u8,   // Velocity 0..127
    tempo_uspq: u32   // Tempo in microseconds per quarter note (e.g. 500000)
};

// ----------------------------------------------------------------------------
// Type: VoiceSlot
// Voice allocation tracker (maps physical slot 0..4K-1 to MIDI note)
// ----------------------------------------------------------------------------
type VoiceSlot = {
    is_active:    u8,    // 1: Voice sounding, 0: Voice idle
    track_id:     u8,    // Source track index (0..M-1)
    channel:      u8,    // MIDI channel (0..15)
    midi_note:    u8     // MIDI note number (0..127)
};

// ----------------------------------------------------------------------------
// Type: SynthPipeline
// Dual-pipeline synthesis orchestrator
// ----------------------------------------------------------------------------
type SynthPipeline = {
    engine_L:     *PolyFMEngine, // Left audio FM engine instance
    engine_R:     *PolyFMEngine, // Right audio FM engine instance (null in mono)
    is_stereo:    i1,            // 1: Stereo dual-pipe, 0: Mono single-pipe
    total_blocks: u32,           // Allocated SIMD voice blocks (K)
    pcm_L_buf:    *i16,          // Scratch PCM buffer for Left pipe
    pcm_R_buf:    *i16           // Scratch PCM buffer for Right pipe
};
