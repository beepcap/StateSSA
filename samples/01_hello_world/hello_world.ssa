// ============================================================================
// StateSSA Basics: 01. Hello World
// 外部C標準ライブラリの puts を呼び出してターミナルにメッセージを表示する
// ============================================================================

extern "C" {
    fn puts(str: *i8) -> i32;
}

machine main() -> i32 {

    flow {
        // 空のデータパス（本マシンはステートマシンと外部呼び出しのみ）
    }

    states {
        Entry: {
            let _ = call puts("Hello, StateSSA World!");
            _ => Exit;
        }

        Exit: {
            _ => return 0;
        }
    }
}
