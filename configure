#!/bin/sh
# ============================================================================
# StateSSA Configuration and Stage-3 Bootstrap Script (configure)
# POSIX-compliant configuration and automated compiler bootstrap
# ============================================================================

set -e

# カレントディレクトリをスクリプトのあるディレクトリに移動
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

echo "============================================================"
echo "Configuring StateSSA Build Environment"
echo "Root directory: $SCRIPT_DIR"
echo "============================================================"

# 1. ツールチェイン確認
echo -n "checking for clang... "
CLANG_BIN="$(command -v clang || true)"
if [ -z "$CLANG_BIN" ]; then
    echo "no"
    echo "Error: 'clang' is required to compile LLVM IR. Please install clang." >&2
    exit 1
fi
echo "$CLANG_BIN"

echo -n "checking for python3... "
PYTHON_BIN="$(command -v python3 || true)"
if [ -z "$PYTHON_BIN" ]; then
    echo "no"
    echo "Error: 'python3' is required for Stage-0 bootstrap. Please install python3." >&2
    exit 1
fi
echo "$PYTHON_BIN"

echo -n "checking for cmp... "
CMP_BIN="$(command -v cmp || true)"
if [ -z "$CMP_BIN" ]; then
    echo "no"
    echo "Error: 'cmp' is required for fixed-point verification." >&2
    exit 1
fi
echo "$CMP_BIN"

# 2. ディレクトリ準備
mkdir -p bin build

# 3. bin/ssac の存在確認
echo -n "checking for existing bin/ssac... "
if [ -x "bin/ssac" ]; then
    echo "yes"
    echo "Found existing StateSSA compiler binary: bin/ssac"
else
    echo "no"
    echo ""
    echo "------------------------------------------------------------"
    echo ">>> Bootstrapping StateSSA Stage-3 Compiler from Stage-0 <<<"
    echo "------------------------------------------------------------"

    # Stage-0 (Python) -> Stage-1 IR
    echo "[Step 1] Compiling Stage-1 LLVM IR via bootstrap/main.py (Stage-0 Python)..."
    PYTHONPATH=. "$PYTHON_BIN" -m bootstrap.main source/driver.ssa -o build/stage1.ll
    echo "  -> build/stage1.ll generated ($(wc -c < build/stage1.ll) bytes)"

    # Stage-1 ビルド
    echo "[Step 2] Building Stage-1 compiler binary via clang..."
    "$CLANG_BIN" -O2 build/stage1.ll -o build/stage1_ssac
    echo "  -> build/stage1_ssac created"

    # Stage-1 実行 -> Stage-2 IR
    echo "[Step 3] Compiling Stage-2 LLVM IR via Stage-1 compiler..."
    build/stage1_ssac source/driver.ssa -o build/stage2.ll
    echo "  -> build/stage2.ll generated ($(wc -c < build/stage2.ll) bytes)"

    # Stage-2 ビルド
    echo "[Step 4] Building Stage-2 compiler binary via clang..."
    "$CLANG_BIN" -O2 build/stage2.ll -o build/stage2_ssac
    echo "  -> build/stage2_ssac created"

    # Stage-2 実行 -> Stage-3 IR
    echo "[Step 5] Compiling Stage-3 LLVM IR via Stage-2 compiler..."
    build/stage2_ssac source/driver.ssa -o build/stage3.ll
    echo "  -> build/stage3.ll generated ($(wc -c < build/stage3.ll) bytes)"

    # 固定点検証 (Fixed-Point Verification)
    echo "[Step 6] Verifying Fixed-Point: Stage-2 IR == Stage-3 IR..."
    if "$CMP_BIN" -s build/stage2.ll build/stage3.ll; then
        echo "  >>> FIXED POINT REACHED: Stage-2 and Stage-3 IR match 100% exactly! <<<"
    else
        echo "Error: Fixed-point check failed between Stage-2 and Stage-3." >&2
        diff -u build/stage2.ll build/stage3.ll | head -n 30
        exit 1
    fi

    # Stage-3 インストール
    echo "[Step 7] Installing Stage-3 binary to bin/ssac..."
    "$CLANG_BIN" -O2 build/stage3.ll -o bin/ssac
    chmod +x bin/ssac
    echo "  -> bin/ssac successfully installed!"
    echo "------------------------------------------------------------"
fi

# 4. ルート Makefile の生成
echo "Generating root Makefile..."
cat << 'EOF' > Makefile
# ============================================================================
# StateSSA Root Makefile
# Automatically generated by ./configure
# ============================================================================

SSAC ?= $(CURDIR)/bin/ssac
CLANG ?= clang
PYTHON ?= python3

.PHONY: all test clean 01_hello_world 02_simple_loop 03_parallel_sum 04_xz 05_web_server 06_fixed_math

all: 01_hello_world 02_simple_loop 03_parallel_sum 04_xz 05_web_server 06_fixed_math
	@echo "All samples built successfully."

01_hello_world:
	@mkdir -p build/01
	$(SSAC) samples/01_hello_world/hello_world.ssa -o build/01/hello.ll
	$(CLANG) -O2 build/01/hello.ll -o build/01/hello

02_simple_loop:
	@mkdir -p build/02
	$(SSAC) samples/02_simple_loop/main.ssa -o build/02/simple_loop.ll
	$(CLANG) -O2 build/02/simple_loop.ll -o build/02/simple_loop

03_parallel_sum:
	@mkdir -p build/03
	$(SSAC) samples/03_parallel_sum/main.ssa -o build/03/parallel_sum.ll
	$(CLANG) -O2 build/03/parallel_sum.ll -lpthread -o build/03/parallel_sum

04_xz:
	@mkdir -p build/04
	$(SSAC) samples/04_xz/main.ssa -o build/04/xz_sample.ll
	$(CLANG) -O2 build/04/xz_sample.ll -o build/04/xz_sample

05_web_server:
	@mkdir -p build/05
	$(SSAC) samples/05_web_server/main.ssa -o build/05/web_server.ll
	$(CLANG) -O2 build/05/web_server.ll -o build/05/web_server

06_fixed_math:
	@mkdir -p build/06
	$(SSAC) samples/06_fixed_math/fixed_math.ssa -o build/06/fixed_math.ll
	$(CLANG) -O2 build/06/fixed_math.ll -lm -o build/06/fixed_math

test: all
	@echo ""
	@echo "============================================================"
	@echo "Running All StateSSA Sample Verifications"
	@echo "============================================================"
	@echo "--- [Test 1/6] 01_hello_world ---"
	@./build/01/hello
	@echo ""
	@echo "--- [Test 2/6] 02_simple_loop ---"
	@./build/02/simple_loop
	@echo ""
	@echo "--- [Test 3/6] 03_parallel_sum ---"
	@./build/03/parallel_sum
	@echo ""
	@echo "--- [Test 4/6] 04_xz ---"
	@./build/04/xz_sample
	@echo ""
	@echo "--- [Test 5/6] 05_web_server (Self-Test) ---"
	@./build/05/web_server & \
	PID=$$!; \
	sleep 0.3; \
	curl -s http://127.0.0.1:18080/ | grep -q "Hello from StateSSA!" && echo "GET / -> 200 OK & Hello verified!"; \
	curl -s "http://127.0.0.1:18080/baseline11?a=42&b=58" | grep -q "100" && echo "GET /baseline11 -> 200 OK & Sum 100 verified!"; \
	curl -s -X POST -d "StateSSA Pure Web Server" http://127.0.0.1:18080/echo | grep -q "StateSSA Pure Web Server" && echo "POST /echo -> 200 OK & Echo verified!"; \
	kill $$PID; \
	wait $$PID 2>/dev/null || true; \
	echo "web_server verification passed."
	@echo ""
	@echo "--- [Test 6/6] 06_fixed_math ---"
	@./build/06/fixed_math
	@echo ""
	@echo "============================================================"
	@echo ">>> ALL SAMPLES PASSED 100% ON STAGE-3 BINARY COMPILER! <<<"
	@echo "============================================================"

clean:
	rm -rf build
EOF

echo ""
echo "============================================================"
echo "Configuration complete!"
echo "Compiler binary : $SCRIPT_DIR/bin/ssac"
echo "You can now run 'make' to build all samples or 'make test' to verify them."
echo "============================================================"
