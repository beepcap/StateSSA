            let _ = call emit_str(ctx, " to i128", 8);
            let _ = call emit_nl(ctx);

            // %div128 = sdiv i128 %shl128, %sext_r
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, div128, call strlen(div128));
            let _ = call emit_str(ctx, " = sdiv i128 ", 12);
