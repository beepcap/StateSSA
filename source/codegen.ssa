}

machine emit_bridge_ret_to_q64(ctx: *CodegenCtx, ret_val: *u8, is_double: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            is_double != 0 => BridgeDouble;
            _              => BridgeFloat;
        }
        BridgeDouble: {
            let mul_res = call fresh_tmp_str(ctx, "fp_mul", 6);
            let q_res   = call fresh_tmp_str(ctx, "fp2q", 4);

            // %mul_res = fmul double %ret_val, 4294967296.0
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, mul_res, call strlen(mul_res));
            let _ = call emit_str(ctx, " = fmul double ", 15);
            let _ = call emit_str(ctx, ret_val, call strlen(ret_val));
            let _ = call emit_str(ctx, ", 4294967296.0", 14);
            let _ = call emit_nl(ctx);

            // %q_res = fptosi double %mul_res to i64
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, q_res, call strlen(q_res));
            let _ = call emit_str(ctx, " = fptosi double ", 17);
            let _ = call emit_str(ctx, mul_res, call strlen(mul_res));
            let _ = call emit_str(ctx, " to i64", 7);
            let _ = call emit_nl(ctx);

            _ => return q_res;
        }
        BridgeFloat: {
            let mul_res = call fresh_tmp_str(ctx, "fp_mul", 6);
            let q_res   = call fresh_tmp_str(ctx, "fp2q", 4);

            // %mul_res = fmul float %ret_val, 4294967296.0
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, mul_res, call strlen(mul_res));
            let _ = call emit_str(ctx, " = fmul float ", 14);
            let _ = call emit_str(ctx, ret_val, call strlen(ret_val));
            let _ = call emit_str(ctx, ", 4294967296.0", 14);
            let _ = call emit_nl(ctx);

            // %q_res = fptosi float %mul_res to i64
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, q_res, call strlen(q_res));
            let _ = call emit_str(ctx, " = fptosi float ", 16);
            let _ = call emit_str(ctx, mul_res, call strlen(mul_res));
            let _ = call emit_str(ctx, " to i64", 7);
            let _ = call emit_nl(ctx);

            _ => return q_res;
        }
    }
}

machine emit_call_expr(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg target_params:    *MachineParam = null;
        reg target_param_cnt: u32 = 0;
        reg target_ret_p:     *u8 = null;
        reg target_ret_l:     u32 = 0;
        reg slots:            *ArgValSlot = null;
        reg call_res:         *u8 = null;

        wire func_p = expr.str_ptr;
        wire func_l = expr.str_len;
        wire prog = ctx.prog;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            // 外部関数か？
            let ext = call find_extern_in_prog(prog, func_p, func_l);
            ext != null => EvalArgs [ target_params <= ext.params, target_param_cnt <= ext.param_count, target_ret_p <= ext.ret_type_ptr, target_ret_l <= ext.ret_type_len ];
            _           => SearchMachine;
        }
        SearchMachine: {
            // 内部マシンか？
            let mach = call find_machine_in_prog(prog, func_p, func_l);
            mach != null => EvalArgs [ target_params <= mach.params, target_param_cnt <= mach.param_count, target_ret_p <= mach.ret_type_ptr, target_ret_l <= mach.ret_type_len ];
            _            => SearchNetwork;
        }
        SearchNetwork: {
            let net = call find_network_in_prog(prog, func_p, func_l);
            net != null => EvalArgs [ target_params <= net.params, target_param_cnt <= net.param_count, target_ret_p <= net.ret_type_ptr, target_ret_l <= net.ret_type_len ];
            _           => UnresolvedSymbol;
        }
        UnresolvedSymbol: {
            // 未解決シンボルフォールバック
            _ => return "0";
        }
        EvalArgs: {
            // 引数式を先行評価し、SSA ID を一時スロットに保存 (引数数に基づき正確に事前計算)
            let cnt = expr.arg_count;
            let mul8 = cnt * 8;
            let slots_bytes = mul8 + 16;
            let slots_mem = call bump_alloc(alloc, slots_bytes, 8);
            let _ = call eval_call_args(ctx, func_p, func_l, expr.args, target_params, target_param_cnt, slots_mem);

            let ret_p = call map_type_ptr(ctx, target_ret_p, target_ret_l);
            let ret_l = call map_type_len(ctx, target_ret_p, target_ret_l);

            let is_void = call str_eq(ret_p, ret_l, "void", 4);
            is_void != 0 => EmitVoidCall  [ slots <= slots_mem ];
            _            => EmitValueCall [ slots <= slots_mem ];
        }
        EmitVoidCall: {
            let _ = call emit_str(ctx, "  call void @", 13);
            let _ = call emit_str(ctx, func_p, func_l);
            let _ = call emit_char(ctx, 40); // '('
            let _ = call emit_assembled_args(ctx, target_params, target_param_cnt, slots, expr.arg_count);
            let _ = call emit_char(ctx, 41); // ')'
            let _ = call emit_nl(ctx);
            _ => return "void";
        }
        EmitValueCall: {
            let res_var = call fresh_tmp_str(ctx, "t", 1);
            let ret_p = call map_type_ptr(ctx, target_ret_p, target_ret_l);
            let ret_l = call map_type_len(ctx, target_ret_p, target_ret_l);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = call ", 8);
            let _ = call emit_str(ctx, ret_p, ret_l);
            let _ = call emit_str(ctx, " @", 2);
            let _ = call emit_str(ctx, func_p, func_l);
            let _ = call emit_char(ctx, 40); // '('
            let _ = call emit_assembled_args(ctx, target_params, target_param_cnt, slots, expr.arg_count);
            let _ = call emit_char(ctx, 41); // ')'
            let _ = call emit_nl(ctx);

            let is_ret_f64 = call str_eq(target_ret_p, target_ret_l, "f64", 3);
            is_ret_f64 != 0 => BridgeRetDouble [ call_res <= res_var ];
            let is_ret_dbl = call str_eq(target_ret_p, target_ret_l, "double", 6);
            is_ret_dbl != 0 => BridgeRetDouble [ call_res <= res_var ];

            let is_ret_f32 = call str_eq(target_ret_p, target_ret_l, "f32", 3);
            is_ret_f32 != 0 => BridgeRetFloat [ call_res <= res_var ];
            let is_ret_flt = call str_eq(target_ret_p, target_ret_l, "float", 5);
            is_ret_flt != 0 => BridgeRetFloat [ call_res <= res_var ];

            _ => return res_var;
        }
        BridgeRetDouble: {
            let q_res = call emit_bridge_ret_to_q64(ctx, call_res, 1);
            _ => return q_res;
        }
        BridgeRetFloat: {
            let q_res = call emit_bridge_ret_to_q64(ctx, call_res, 0);
            _ => return q_res;
        }
    }
}

machine find_extern_in_prog(prog: *ProgramDef, name_p: *u8, name_l: u32) -> *ExternFn {
    flow {
        reg i: u32 = 0;
        wire cnt = prog.extern_count;
        wire has_more = i < cnt;
        wire fld_ext = prog.externs;
        wire ext = fld_ext + i;
        wire is_match = call str_eq(ext.name_ptr, ext.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return ext;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine eval_call_args(ctx: *CodegenCtx, fn_p: *u8, fn_l: u32, first_arg: *ExprNode, params: *MachineParam, param_cnt: u32, slots: *ArgValSlot) -> u32 {
    flow {
        reg i:       u32 = 0;
        reg cur:     *ExprNode = null;
        reg cur_val: *u8 = null;
        reg cur_t:   *u8 = null;
        reg arg_bt:  *TypeDef = null;
        wire has_more = cur != null;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0, cur <= first_arg ];
        }
        Loop: {
            has_more != 0 => Step;
            _             => Exit;
        }
        Step: {
            let val = call emit_expr(ctx, cur);
            let ct = call get_expr_type(ctx, cur);
            let ctl = call strlen(ct);
            let exp_p = call get_param_type_ptr(ctx, params, param_cnt, i);
            let exp_l = call get_param_type_len(ctx, params, param_cnt, i);
            let raw_p = call get_raw_param_type_ptr(params, param_cnt, i);
            let raw_l = call get_raw_param_type_len(params, param_cnt, i);

            let ok = call validate_type(ctx, 1, fn_p, fn_l, i + 1, raw_p, raw_l, ct, ctl, cur);

            let is_q = call is_type_q64(ct);
            is_q != 0 => CheckBridgeArg [ cur_val <= val, cur_t <= ct ];

            let is_exp_i32 = call str_eq(exp_p, exp_l, "i32", 3);
            is_exp_i32 != 0 => CheckExtI32 [ cur_val <= val, cur_t <= ct ];
            let is_exp_i64 = call str_eq(exp_p, exp_l, "i64", 3);
            is_exp_i64 != 0 => CheckExtI64 [ cur_val <= val, cur_t <= ct ];
            _ => SaveArg [ cur_val <= val ];
        }
        CheckBridgeArg: {
            let exp_p = call get_param_type_ptr(ctx, params, param_cnt, i);
            let exp_l = call get_param_type_len(ctx, params, param_cnt, i);

            let is_f64 = call str_eq(exp_p, exp_l, "f64", 3);
            is_f64 != 0 => BridgeF64;
            let is_dbl = call str_eq(exp_p, exp_l, "double", 6);
            is_dbl != 0 => BridgeF64;

            let is_f32 = call str_eq(exp_p, exp_l, "f32", 3);
            is_f32 != 0 => BridgeF32;
            let is_flt = call str_eq(exp_p, exp_l, "float", 5);
            is_flt != 0 => BridgeF32;

            _ => SaveArg;
        }
        BridgeF64: {
            let bv = call emit_bridge_q64_to_f64(ctx, cur_val);
            _ => SaveArg [ cur_val <= bv ];
        }
        BridgeF32: {
            let bv = call emit_bridge_q64_to_f32(ctx, cur_val);
            _ => SaveArg [ cur_val <= bv ];
        }
        CheckExtI32: {
            let is_sm = call is_type_small(cur_t);
            is_sm != 0 => ExtArgI32;
            _          => SaveArg;
        }
        ExtArgI32: {
            let ext_v = call emit_ext_to_type(ctx, cur_t, "i32", cur_val);
            _ => SaveArg [ cur_val <= ext_v ];
        }
        CheckExtI64: {
            cur_t == null => ExtArg64;
            let c0 = *cur_t;
            c0 == 42    => SaveArg;
            let is_i64 = call is_type_64(cur_t);
            is_i64 != 0 => SaveArg;
            _           => ExtArg64;
        }
        ExtArg64: {
            let ext_v = call emit_ext_to_type(ctx, cur_t, "i64", cur_val);
            _ => SaveArg [ cur_val <= ext_v ];
        }
        SaveArg: {
            let exp_p = call get_param_type_ptr(ctx, params, param_cnt, i);
            let exp_l = call get_param_type_len(ctx, params, param_cnt, i);
            let btype = call find_bounded_type(ctx.prog, exp_p, exp_l);
            btype != null => ClampCallArg [ arg_bt <= btype ];
            _             => StoreSlot;
        }
        ClampCallArg: {
            let cv = call emit_clamp(ctx, cur_val, arg_bt);
            _ => StoreSlot [ cur_val <= cv ];
        }
        StoreSlot: {
            let slot = slots + i;
            slot.val_ptr <- cur_val;
            _ => Loop [ i <= i + 1, cur <= cur.next_arg ];
        }
        Exit: {
            _ => return i;
        }
    }
}

machine emit_assembled_args(ctx: *CodegenCtx, params: *MachineParam, param_cnt: u32, slots: *ArgValSlot, count: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire has_more = i < count;
        wire is_first = i == 0;
        wire slot = slots + i;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitOne;
            _             => Exit;
        }
        EmitOne: {
            is_first == 0 => EmitComma;
            _             => EmitVal;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitVal;
        }
        EmitVal: {
            let param_type_p = call get_param_type_ptr(ctx, params, param_cnt, i);
            let param_type_l = call get_param_type_len(ctx, params, param_cnt, i);

            let _ = call emit_str(ctx, param_type_p, param_type_l);
            let _ = call emit_char(ctx, 32); // ' '
            let _ = call emit_str(ctx, slot.val_ptr, call strlen(slot.val_ptr));

            _ => Loop [ i <= i + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine get_raw_param_type_ptr(params: *MachineParam, param_cnt: u32, idx: u32) -> *u8 {
    flow {
        wire ok = idx < param_cnt;
        wire p = params + idx;
    }
    states {
        Entry: {
            ok == 0 => DefaultType;
            _       => RetRaw;
        }
        RetRaw: {
            _ => return p.type_ptr;
        }
        DefaultType: {
            _ => return "i32";
        }
    }
}

machine get_raw_param_type_len(params: *MachineParam, param_cnt: u32, idx: u32) -> u32 {
    flow {
        wire ok = idx < param_cnt;
        wire p = params + idx;
    }
    states {
        Entry: {
            ok == 0 => DefaultType;
            _       => RetRaw;
        }
        RetRaw: {
            _ => return p.type_len;
        }
        DefaultType: {
            _ => return 3;
        }
    }
}

machine get_param_type_ptr(ctx: *CodegenCtx, params: *MachineParam, param_cnt: u32, idx: u32) -> *u8 {
    flow {
        wire ok = idx < param_cnt;
        wire p = params + idx;
    }
    states {
        Entry: {
            ok == 0 => DefaultType;
            _       => MapParam;
        }
        MapParam: {
            let mapped_p = call map_type_ptr(ctx, p.type_ptr, p.type_len);
            _ => return mapped_p;
        }
        DefaultType: {
            _ => return "i32";
        }
    }
}

machine get_param_type_len(ctx: *CodegenCtx, params: *MachineParam, param_cnt: u32, idx: u32) -> u32 {
    flow {
        wire ok = idx < param_cnt;
        wire p = params + idx;
    }
    states {
        Entry: {
            ok == 0 => DefaultType;
            _       => MapParam;
        }
        MapParam: {
            let mapped_l = call map_type_len(ctx, p.type_ptr, p.type_len);
            _ => return mapped_l;
        }
        DefaultType: {
            _ => return 3;
        }
    }
}

machine coerce_store_val(ctx: *CodegenCtx, val_str: *u8, val_llvm_p: *u8, val_llvm_l: u32, dst_type_p: *u8, dst_type_l: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            let is_null = call str_eq(val_str, call strlen(val_str), "null", 4);
            is_null != 0 => ReturnDirect;
            let is_same = call str_eq(dst_type_p, dst_type_l, val_llvm_p, val_llvm_l);
            is_same != 0 => ReturnDirect;
            let is_i8 = call str_eq(dst_type_p, dst_type_l, "i8", 2);
            is_i8 != 0   => DoTrunc;
            let is_i16 = call str_eq(dst_type_p, dst_type_l, "i16", 3);
            is_i16 != 0  => DoTrunc;

            // ポインタ同士の型不一致か？
            let dst_last_ptr = dst_type_p + (dst_type_l - 1);
            let dst_last = *dst_last_ptr;
            let val_last_ptr = val_llvm_p + (val_llvm_l - 1);
            let val_last = *val_last_ptr;
            let both_ptr = (dst_last == 42) && (val_last == 42);
            both_ptr => DoBitcast;
            _        => ReturnDirect;
        }
        ReturnDirect: {
            _ => return val_str;
        }
        DoTrunc: {
            let tr_val = call fresh_tmp_str(ctx, "trunc", 5);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, tr_val, call strlen(tr_val));
            let _ = call emit_str(ctx, " = trunc ", 9);
            let _ = call emit_str(ctx, val_llvm_p, val_llvm_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, val_str, call strlen(val_str));
            let _ = call emit_str(ctx, " to ", 4);
            let _ = call emit_str(ctx, dst_type_p, dst_type_l);
            let _ = call emit_nl(ctx);
            _ => return tr_val;
        }
        DoBitcast: {
            let bc_val = call fresh_tmp_str(ctx, "bitcast", 7);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, bc_val, call strlen(bc_val));
            let _ = call emit_str(ctx, " = bitcast ", 11);
            let _ = call emit_str(ctx, val_llvm_p, val_llvm_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, val_str, call strlen(val_str));
            let _ = call emit_str(ctx, " to ", 4);
            let _ = call emit_str(ctx, dst_type_p, dst_type_l);
            let _ = call emit_nl(ctx);
            _ => return bc_val;
        }
    }
}

machine emit_store(ctx: *CodegenCtx, target: *ExprNode, expr: *ExprNode) -> u32 {
    flow {
        reg val_str:    *u8 = null;
        reg val_type:   *u8 = null;
        reg val_llvm_p: *u8 = null;
        reg val_llvm_l: u32 = 0;
        reg dst_ptr:    *u8 = null;
        reg dst_type_p: *u8 = null;
        reg dst_type_l: u32 = 0;
        reg raw_ft_p:   *u8 = null;
        reg raw_ft_l:   u32 = 0;

        reg sname:      *u8 = null;
    }
    states {
        Entry: {
            target == null => Exit;
            let v = call emit_expr(ctx, expr);
            let vt = call get_expr_type(ctx, expr);
            let vt_l = call strlen(vt);
            let v_lp = call map_type_ptr(ctx, vt, vt_l);
            let v_ll = call map_type_len(ctx, vt, vt_l);

            let tk = target.kind;
            tk == 7 => CheckFieldStore [ val_str <= v, val_type <= vt, val_llvm_p <= v_lp, val_llvm_l <= v_ll ];
            tk == 6 => CheckUnary [ val_str <= v, val_type <= vt, val_llvm_p <= v_lp, val_llvm_l <= v_ll ];
            _       => BadStoreTarget;
        }

        BadStoreTarget: {
            let _ = call diag_nl();
            let _ = call diag_str("[StateSSA Store Error]: Invalid store target. Memory store ('<-') target must be a dereference ('*ptr') or pointer field access ('ptr.field').");
            let _ = call diag_nl();
            ctx.error_code <- -50;
            _ => Exit;
        }

        CheckUnary: {
            let op = target.op;
            op == 70 => UnaryStore; // '*' (TOK_STAR = 70)
            _        => BadStoreTarget;
        }

        CheckFieldStore: {
            let base_e = target.left;
            let bt = call get_expr_type(ctx, base_e);
            let c0 = *bt;
            c0 == 42 => FieldStore [ sname <= bt + 1 ];
            _        => BadFieldStore;
        }

        BadFieldStore: {
            let _ = call diag_nl();
            let _ = call diag_str("[StateSSA Store Error]: Cannot store into field of non-pointer value. Memory store ('<-') requires a pointer to struct ('*Struct').");
            let _ = call diag_nl();
            ctx.error_code <- -50;
            _ => Exit;
        }

        FieldStore: {
            let gep_val = call emit_field_ptr(ctx, target);
            let ec = ctx.error_code;
            ec != 0 => Exit;
            _ => ResolveFldType [ dst_ptr <= gep_val ];
        }

        ResolveFldType: {
            let raw_ftype = call find_struct_field_type(ctx.prog, ctx.alloc, sname, target.str_ptr, target.str_len);
            let raw_flen = call strlen(raw_ftype);
            let mapped_p = call map_type_ptr(ctx, raw_ftype, raw_flen);
            let mapped_l = call map_type_len(ctx, raw_ftype, raw_flen);
            _ => DoStoreCheck [ dst_type_p <= mapped_p, dst_type_l <= mapped_l, raw_ft_p <= raw_ftype, raw_ft_l <= raw_flen ];
        }

        UnaryStore: {
            let ptr_e = target.left;
            let ptr_v = call emit_expr(ctx, ptr_e);
            let ptr_t = call get_expr_type(ctx, ptr_e);
            let elem_t = ptr_t + 1;
            let elem_l = call strlen(elem_t);
            let mapped_p = call map_type_ptr(ctx, elem_t, elem_l);
            let mapped_l = call map_type_len(ctx, elem_t, elem_l);

            _ => DoStoreCheck [ dst_ptr <= ptr_v, dst_type_p <= mapped_p, dst_type_l <= mapped_l, raw_ft_p <= elem_t, raw_ft_l <= elem_l ];
        }

        DoStoreCheck: {
            let vt_len = call strlen(val_type);
            let ok = call validate_type(ctx, 2, target.str_ptr, target.str_len, 0, raw_ft_p, raw_ft_l, val_type, vt_len, expr);
            ok == 0 => Exit;
            let fv = call coerce_store_val(ctx, val_str, val_llvm_p, val_llvm_l, dst_type_p, dst_type_l);

            let _ = call emit_str(ctx, "  store ", 8);
            let _ = call emit_str(ctx, dst_type_p, dst_type_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, fv, call strlen(fv));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, dst_type_p, dst_type_l);
            let _ = call emit_str(ctx, "* ", 2);
            let _ = call emit_str(ctx, dst_ptr, call strlen(dst_ptr));
            let align_str = call get_type_align_str(dst_type_p, dst_type_l);
            let _ = call emit_str(ctx, ", align ", 8);
            let _ = call emit_str(ctx, align_str, call strlen(align_str));
            let _ = call emit_nl(ctx);
            _ => Exit;
        }

        Exit: {
            _ => return 0;
        }
    }
}

// ============================================================================
// StateSSA Compiler: FSM Topology & Phi Junction Engine (emit_fsm.ssa)
// マシン・状態ノード・遷移エッジ・レジスタラッチ・Phi結合の調停
// ============================================================================




machine find_machine_in_prog(prog: *ProgramDef, name_p: *u8, name_l: u32) -> *MachineDef {
    flow {
        reg i: u32 = 0;
        wire cnt = prog.machine_count;
        wire has_more = i < cnt;
        wire fld_m = prog.machines;
        wire m = fld_m + i;
        wire is_match = call str_eq(m.name_ptr, m.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return m;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine emit_machine_param_types(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg i: u32 = 0;
        wire cnt = m.param_count;
        wire has_more = i < cnt;
        wire fld_p = m.params;
        wire p = fld_p + i;
        wire is_first = i == 0;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitOne;
            _             => Exit;
        }
        EmitOne: {
            is_first == 0 => EmitComma;
            _             => EmitType;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitType;
        }
        EmitType: {
            let mapped_p = call map_type_ptr(ctx, p.type_ptr, p.type_len);
            let mapped_l = call map_type_len(ctx, p.type_ptr, p.type_len);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            _ => Loop [ i <= i + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_machine_body(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        wire ret_p = call map_type_ptr(ctx, m.ret_type_ptr, m.ret_type_len);
        wire ret_l = call map_type_len(ctx, m.ret_type_ptr, m.ret_type_len);
    }
    states {
        Entry: {
            ctx.out_buf <- ctx.main_buf;
            ctx.out_pos <- ctx.main_pos;
            ctx.max_len <- ctx.main_cap;

            let _ = call emit_str(ctx, "define ", 7);
            let _ = call emit_str(ctx, ret_p, ret_l);
            let _ = call emit_str(ctx, " @", 2);
            let _ = call emit_str(ctx, m.name_ptr, m.name_len);
            let _ = call emit_char(ctx, 40); // '('
            let _ = call emit_machine_params(ctx, m);
            let _ = call emit_str(ctx, ") {", 3);
            let _ = call emit_nl(ctx);

            let _ = call assemble_machine_blocks(ctx, m);

            let _ = call emit_char(ctx, 125); // '}'
            let _ = call emit_nl(ctx);
            let _ = call emit_nl(ctx);
            ctx.main_pos <- ctx.out_pos;
            _ => return ctx.out_pos;
        }
    }
}

machine emit_machine(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        wire is_sealed = m.is_sealed;
    }
    states {
        Entry: {
            // [Shield 3]: Prefix Sanitization
            ctx.node_prefix_p <- null;
            ctx.node_prefix_l <- 0;

            is_sealed != 0 => SkipSealed;
            _              => DoEmit;
        }
        SkipSealed: {
            _ => return ctx.out_pos;
        }
        DoEmit: {
            ctx.cur_machine <- m;
            ctx.cur_env_cnt <- 0;
            ctx.phi_cnt     <- 0;
            ctx.block_cnt   <- 0;

            let _ = call emit_entry_block(ctx, m);
            let _ = call emit_machine_states(ctx, m);
            let res = call emit_machine_body(ctx, m);
            _ => return res;
        }
    }
}

machine emit_machine_params(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg p_idx: u32 = 0;
        wire cnt = m.param_count;
        wire has_more = p_idx < cnt;
        wire fld_p = m.params;
        wire p = fld_p + p_idx;
        wire is_first = p_idx == 0;
    }
    states {
        Entry: {
            _ => Loop [ p_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitParam;
            _             => Exit;
        }
        EmitParam: {
            is_first == 0 => EmitComma;
            _             => EmitOne;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitOne;
        }
        EmitOne: {
            let mapped_p = call map_type_ptr(ctx, p.type_ptr, p.type_len);
            let mapped_l = call map_type_len(ctx, p.type_ptr, p.type_len);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            p.is_distinct != 0 => EmitDistinct;
            _                  => EmitArgName;
        }
        EmitDistinct: {
            let _ = call emit_str(ctx, " noalias", 8);
            _ => EmitArgName;
        }
        EmitArgName: {
            let _ = call emit_str(ctx, " %arg_", 6);
            let _ = call emit_str(ctx, p.name_ptr, p.name_len);
            _ => Loop [ p_idx <= p_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_bind_param_clamps(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg p_idx:  u32 = 0;
        reg cur_bt: *TypeDef = null;
        wire cnt = m.param_count;
        wire has_more = p_idx < cnt;
        wire fld_p = m.params;
        wire p = fld_p + p_idx;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            _ => Loop [ p_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => CheckParam;
            _             => Exit;
        }
        CheckParam: {
            let btype = call find_bounded_type(ctx.prog, p.type_ptr, p.type_len);
            btype != null => ClampParam [ cur_bt <= btype ];
            _             => NextParam;
        }
        ClampParam: {
            let b_arg = alloc.base_ptr;
            let off_arg = alloc.offset;
            let arg_p = b_arg + off_arg;
            let _ = call append_str_to_alloc(alloc, "%arg_", 5);
            let _ = call append_str_to_alloc(alloc, p.name_ptr, p.name_len);
            let _ = call append_char_to_alloc(alloc, 0);
            let cv = call emit_clamp(ctx, arg_p, cur_bt);
            let cv_l = call strlen(cv);
            let _ = call env_set(ctx, p.name_ptr, p.name_len, cv, cv_l);
            _ => NextParam;
        }
        NextParam: {
            _ => Loop [ p_idx <= p_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_init_expr_val(ctx: *CodegenCtx, reg_def: *RegDef) -> *u8 {
    flow {
        reg raw_val: *u8 = null;
        reg reg_bt:  *TypeDef = null;
    }
    states {
        Entry: {
            let val = call emit_expr(ctx, reg_def.init_expr);
            let btype = call find_bounded_type(ctx.prog, reg_def.type_ptr, reg_def.type_len);
            btype != null => DoClamp [ raw_val <= val, reg_bt <= btype ];
            _             => return val;
        }
        DoClamp: {
            let cv = call emit_clamp(ctx, raw_val, reg_bt);
            _ => return cv;
        }
    }
}

machine emit_entry_regs_init(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg r_idx: u32 = 0;
        wire cnt = m.reg_count;
        wire has_more = r_idx < cnt;
        wire fld_reg_def = m.regs;
        wire reg_def = fld_reg_def + r_idx;
        wire init_e = reg_def.init_expr;
    }
    states {
        Entry: {
            _ => InitRegsLoop [ r_idx <= 0 ];
        }
        InitRegsLoop: {
            has_more != 0 => InitOneReg;
            _             => Exit;
        }
        InitOneReg: {
            init_e != null => HasInit;
            _              => NoInit;
        }
        HasInit: {
            let val = call emit_init_expr_val(ctx, reg_def);
            let val_l = call strlen(val);
            let _ = call env_set(ctx, reg_def.name_ptr, reg_def.name_len, val, val_l);
            _ => NextReg;
        }
        NoInit: {
            let default_val = call get_default_reg_val(reg_def.type_ptr, reg_def.type_len);
            let val_l = call strlen(default_val);
            let _ = call env_set(ctx, reg_def.name_ptr, reg_def.name_len, default_val, val_l);
            _ => NextReg;
        }
        NextReg: {
            _ => InitRegsLoop [ r_idx <= r_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_entry_block(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg entry_bb: *BasicBlock = null;
        wire entry_s = m.state_defs;
        wire ret_cnt = ctx.fused_ret_cnt;
        wire is_fused = ctx.node_prefix_p != null;
    }
    states {
        Entry: {
            let cap = call calc_bb_required_size(entry_s, m);
            let bb = call add_basic_block(ctx, "entry", 5, 0, cap);
            let _ = call switch_to_bb(ctx, bb);

            let is_main = call str_eq(m.name_ptr, m.name_len, "main", 4);
            is_main != 0 => EmitMxcsr [ entry_bb <= bb ];

            ret_cnt > 0 => EmitPhi [ entry_bb <= bb ];
            _           => CheckEnv [ entry_bb <= bb ];
        }
        EmitMxcsr: {
            let _ = call emit_str(ctx, "  %mxcsr_ptr = alloca i32, align 4", 34);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  %mxcsr_i8 = bitcast i32* %mxcsr_ptr to i8*", 45);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  call void @llvm.x86.sse.stmxcsr(i8* %mxcsr_i8)", 49);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  %old_mxcsr = load i32, i32* %mxcsr_ptr, align 4", 50);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  %new_mxcsr = or i32 %old_mxcsr, 32832", 40);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  store i32 %new_mxcsr, i32* %mxcsr_ptr, align 4", 49);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  call void @llvm.x86.sse.ldmxcsr(i8* %mxcsr_i8)", 49);
            let _ = call emit_nl(ctx);
            ret_cnt > 0 => EmitPhi;
            _           => CheckEnv;
        }
        EmitPhi: {
            let res_p = call make_fused_reg_name(ctx.alloc, ctx.node_prefix_p, ctx.node_prefix_l);
            let res_l = call strlen(res_p);
            let _ = call emit_phi_bridge(ctx, ctx.fused_prev_type_p, ctx.fused_prev_type_l, res_p, res_l);
            ctx.fused_ret_cnt <- 0;
            _ => CheckEnv;
        }
        CheckEnv: {
            is_fused == 0 => ResetEnv;
            _             => AfterEnv;
        }
        ResetEnv: {
            ctx.cur_env_cnt <- 0;
            _ => AfterEnv;
        }
        AfterEnv: {
            let _ = call emit_bind_param_clamps(ctx, m);
            let _ = call emit_entry_regs_init(ctx, m);
            let _ = call emit_state_actions(ctx, entry_s);
            let _ = call emit_state_rules(ctx, m, entry_s, 0, entry_bb);
            _ => return 0;
        }
    }
}

machine has_char_x(s: *u8, l: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire has_more = i < l;
        wire p = s + i;
        wire c = *p;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            c == 120 => Found; // 'x'
            _ => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return 1;
        }
        NotFound: {
            _ => return 0;
        }
    }
}

machine get_default_reg_val(type_p: *u8, type_l: u32) -> *u8 {
    flow {
        wire c0 = *type_p;
    }
    states {
        Entry: {
            c0 == 42 => ReturnNull; // '*'
            c0 == 102 => CheckFloat; // 'f'
            let is_v = call has_char_x(type_p, type_l);
            is_v != 0 => ReturnZeroInit;
            _ => ReturnZero;
        }
        CheckFloat: {
            let is_f32 = call str_eq(type_p, type_l, "f32", 3);
            is_f32 != 0 => ReturnFloatZero;
            let is_f64 = call str_eq(type_p, type_l, "f64", 3);
            is_f64 != 0 => ReturnFloatZero;
            let is_v = call has_char_x(type_p, type_l);
            is_v != 0 => ReturnZeroInit;
            _ => ReturnZero;
        }
        ReturnNull: {
            _ => return "null";
        }
        ReturnFloatZero: {
            _ => return "0.0";
        }
        ReturnZeroInit: {
            _ => return "zeroinitializer";
        }
        ReturnZero: {
            _ => return "0";
        }
    }
}

machine emit_state_actions(ctx: *CodegenCtx, s: *StateDef) -> u32 {
    flow {
        reg cur_act: *ActionStmt = null;
        wire has_more = cur_act != null;
    }
    states {
        Entry: {
            ctx.cur_state_p <- s.name_ptr;
            ctx.cur_state_l <- s.name_len;
            _ => Loop [ cur_act <= s.actions ];
        }
        Loop: {
            has_more != 0 => EmitAct;
            _             => Exit;
        }
        EmitAct: {
            let k = cur_act.kind;
            k == 1 => EmitLet;
            k == 2 => EmitCall;
            k == 3 => EmitStore;
            _      => NextAct;
        }
        EmitLet: {
            let res = call emit_expr(ctx, cur_act.expr);
            let res_l = call strlen(res);
            let _ = call env_set(ctx, cur_act.target_ptr, cur_act.target_len, res, res_l);
            _ => NextAct;
        }
        EmitCall: {
            let _ = call emit_expr(ctx, cur_act.expr);
            _ => NextAct;
        }
        EmitStore: {
            let _ = call emit_store(ctx, cur_act.target_expr, cur_act.expr);
            _ => NextAct;
        }
        NextAct: {
            _ => Loop [ cur_act <= cur_act.next ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine make_reg_var_name(alloc: *BumpAlloc, pfx_p: *u8, pfx_l: u32, reg_p: *u8, reg_l: u32, s_p: *u8, s_l: u32) -> *u8 {
    flow {
        reg start_ptr: *u8 = null;
    }
    states {
        Entry: {
            let b = alloc.base_ptr;
            let off = alloc.offset;
            let res = b + off;
            let _ = call append_str_to_alloc(alloc, "%reg_", 5);
            pfx_p != null => WithPrefix [ start_ptr <= res ];
            _             => NoPrefix [ start_ptr <= res ];
        }
        WithPrefix: {
            let _ = call append_str_to_alloc(alloc, pfx_p, pfx_l);
            let _ = call append_char_to_alloc(alloc, 95); // '_'
            _ => NoPrefix;
        }
        NoPrefix: {
            let _ = call append_str_to_alloc(alloc, reg_p, reg_l);
            let _ = call append_char_to_alloc(alloc, 95); // '_'
            let _ = call append_str_to_alloc(alloc, s_p, s_l);
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return start_ptr;
        }
    }
}

machine prepare_state_regs(ctx: *CodegenCtx, m: *MachineDef, s: *StateDef) -> u32 {
    flow {
        reg r_idx: u32 = 0;
        wire cnt = m.reg_count;
        wire has_more = r_idx < cnt;
        wire fld_reg_def = m.regs;
        wire reg_def = fld_reg_def + r_idx;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            _ => Loop [ r_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => Step;
            _             => Exit;
        }
        Step: {
            let reg_var = call make_reg_var_name(alloc, ctx.node_prefix_p, ctx.node_prefix_l, reg_def.name_ptr, reg_def.name_len, s.name_ptr, s.name_len);
            let _ = call env_set(ctx, reg_def.name_ptr, reg_def.name_len, reg_var, call strlen(reg_var));
            _ => Loop [ r_idx <= r_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_machine_states(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg cur_s: *StateDef = null;
        reg s_idx: u32 = 1;
        wire has_more = cur_s != null;
    }
    states {
        Entry: {
            let s0 = m.state_defs;
            s0 == null => Exit;
            let s1 = s0.next;
            s1 == null => Exit;
            _ => Loop [ cur_s <= s1, s_idx <= 1 ];
        }
        Loop: {
            has_more != 0 => EmitOneState;
            _             => Exit;
        }
        EmitOneState: {
            // ステート先頭ブロックを作成
            let cap = call calc_bb_required_size(cur_s, m);
            let state_bb = call add_basic_block(ctx, cur_s.name_ptr, cur_s.name_len, s_idx, cap);
            let _ = call switch_to_bb(ctx, state_bb);

            // 環境をクリア
            ctx.cur_env_cnt <- 0;

            // このステートにおけるレジスタ名を環境に登録
            let _ = call prepare_state_regs(ctx, m, cur_s);

            // ステートのアクションを出力
            let _ = call emit_state_actions(ctx, cur_s);

            // ステートのルールを出力
            let _ = call emit_state_rules(ctx, m, cur_s, s_idx, state_bb);

            _ => NextState;
        }
        NextState: {
            _ => Loop [ cur_s <= cur_s.next, s_idx <= s_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine count_phi_entries(ctx: *CodegenCtx, s_idx: u32, r_idx: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        reg match_cnt: u32 = 0;
        wire cnt = ctx.phi_cnt;
        wire has_more = i < cnt;
        wire fld_entry = ctx.phi_entries;
        wire entry = fld_entry + i;
        wire val_is_match_s = entry.state_idx;
        wire is_match_s = val_is_match_s == s_idx;
        wire val_is_match_r = entry.reg_idx;
        wire is_match_r = val_is_match_r == r_idx;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0, match_cnt <= 0 ];
        }
        Loop: {
            has_more != 0 => CheckEntry;
            _             => Exit;
        }
        CheckEntry: {
            is_match_s == 0 => NextIter;
            is_match_r != 0 => IncCnt;
            _               => NextIter;
        }
        IncCnt: {
            _ => Loop [ i <= i + 1, match_cnt <= match_cnt + 1 ];
        }
        NextIter: {
            _ => Loop [ i <= i + 1, match_cnt <= match_cnt ];
        }
        Exit: {
            _ => return match_cnt;
        }
    }
}

machine emit_state_phi_nodes(ctx: *CodegenCtx, m: *MachineDef, s: *StateDef, s_idx: u32) -> u32 {
    flow {
        reg r_idx: u32 = 0;
        wire cnt = m.reg_count;
        wire has_more = r_idx < cnt;
        wire fld_reg_def = m.regs;
        wire reg_def = fld_reg_def + r_idx;
    }
    states {
        Entry: {
            _ => Loop [ r_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => CheckPhi;
            _             => Exit;
        }
        CheckPhi: {
            let in_cnt = call count_phi_entries(ctx, s_idx, r_idx);
            in_cnt != 0 => EmitOnePhi;
            _           => NextReg;
        }
        EmitOnePhi: {
            let rtype_p = call map_type_ptr(ctx, reg_def.type_ptr, reg_def.type_len);
            let rtype_l = call map_type_len(ctx, reg_def.type_ptr, reg_def.type_len);
            let reg_var = call make_reg_var_name(ctx.alloc, ctx.node_prefix_p, ctx.node_prefix_l, reg_def.name_ptr, reg_def.name_len, s.name_ptr, s.name_len);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, reg_var, call strlen(reg_var));
            let _ = call emit_str(ctx, " = phi ", 7);
            let _ = call emit_str(ctx, rtype_p, rtype_l);
            let _ = call emit_char(ctx, 32); // ' '

            // PhiTable からこの state_idx と reg_idx に対応する流入値を結合出力
            let _ = call emit_phi_entries(ctx, s_idx, r_idx);
            let _ = call emit_nl(ctx);

            _ => NextReg;
        }
        NextReg: {
            _ => Loop [ r_idx <= r_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_phi_entries(ctx: *CodegenCtx, s_idx: u32, r_idx: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        reg emitted_cnt: u32 = 0;
        wire cnt = ctx.phi_cnt;
        wire has_more = i < cnt;
        wire fld_entry = ctx.phi_entries;
        wire entry = fld_entry + i;
        wire val_is_match_s = entry.state_idx;
        wire is_match_s = val_is_match_s == s_idx;
        wire val_is_match_r = entry.reg_idx;
        wire is_match_r = val_is_match_r == r_idx;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0, emitted_cnt <= 0 ];
        }
        Loop: {
            has_more != 0 => CheckEntry;
            _             => Exit;
        }
        CheckEntry: {
            is_match_s == 0 => NextIter;
            is_match_r != 0 => EmitOneIn;
            _               => NextIter;
        }
        EmitOneIn: {
            emitted_cnt != 0 => EmitComma;
            _                => DoEmit;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => DoEmit;
        }
        DoEmit: {
            // [ val, %from_bb ]
            let _ = call emit_str(ctx, "[ ", 2);
            let _ = call emit_str(ctx, entry.val_p, entry.val_l);
            let _ = call emit_str(ctx, ", %", 3);
            let _ = call emit_str(ctx, entry.from_bb_p, entry.from_bb_l);
            let _ = call emit_str(ctx, " ]", 2);
            _ => Loop [ i <= i + 1, emitted_cnt <= emitted_cnt + 1 ];
        }
        NextIter: {
            _ => Loop [ i <= i + 1, emitted_cnt <= emitted_cnt ];
        }
        Exit: {
            _ => return emitted_cnt;
        }
    }
}

machine record_fused_return(ctx: *CodegenCtx, val_p: *u8, cur_bb: *BasicBlock) -> u32 {
    flow {
        wire cnt = ctx.fused_ret_cnt;
        wire fld_ret = ctx.fused_ret_vals;
        wire slot = fld_ret + cnt;
    }
    states {
        Entry: {
            slot.val_p <- val_p;
            slot.val_l <- call strlen(val_p);
            slot.bb_p  <- cur_bb.name_ptr;
            slot.bb_l  <- cur_bb.name_len;
            ctx.fused_ret_cnt <- cnt + 1;
            _ => return 0;
        }
    }
}

machine emit_branch_target(ctx: *CodegenCtx, target_p: *u8, target_l: u32) -> u32 {
    flow {
        wire pfx_p = ctx.node_prefix_p;
        wire pfx_l = ctx.node_prefix_l;
    }
    states {
        Entry: {
            let _ = call emit_str(ctx, "  br label %", 12);
            pfx_p != null => WithPrefix;
            _             => NoPrefix;
        }
        WithPrefix: {
            let _ = call emit_str(ctx, pfx_p, pfx_l);
            let _ = call emit_char(ctx, 95); // '_'
            _ => NoPrefix;
        }
        NoPrefix: {
            let _ = call emit_str(ctx, target_p, target_l);
            let _ = call emit_nl(ctx);
            _ => return 0;
        }
    }
}

machine emit_ret_inst(ctx: *CodegenCtx, m: *MachineDef, val: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            let ret_p = call map_type_ptr(ctx, m.ret_type_ptr, m.ret_type_len);
            let ret_l = call map_type_len(ctx, m.ret_type_ptr, m.ret_type_len);
            let v_len = call strlen(val);
            let _ = call emit_str(ctx, "  ret ", 6);
            let _ = call emit_str(ctx, ret_p, ret_l);
            let _ = call emit_char(ctx, 32);
            let _ = call emit_str(ctx, val, v_len);
            let _ = call emit_nl(ctx);
            _ => return ctx.out_pos;
        }
    }
}

machine emit_ret_value(ctx: *CodegenCtx, m: *MachineDef, expr: *ExprNode, cur_bb: *BasicBlock) -> u32 {
    flow {
        reg cur_val: *u8 = null;
        reg cur_bt:  *TypeDef = null;
    }
    states {
        Entry: {
            let val = call emit_expr(ctx, expr);
            let vt = call get_expr_type(ctx, expr);
            let vtl = call strlen(vt);
            let ok = call validate_type(ctx, 4, m.name_ptr, m.name_len, 0, m.ret_type_ptr, m.ret_type_len, vt, vtl, expr);

            let btype = call find_bounded_type(ctx.prog, m.ret_type_ptr, m.ret_type_len);
            btype != null => DoClamp [ cur_val <= val, cur_bt <= btype ];
            _             => CheckFused [ cur_val <= val ];
        }
        DoClamp: {
            let cv = call emit_clamp(ctx, cur_val, cur_bt);
            _ => CheckFused [ cur_val <= cv ];
        }
        CheckFused: {
            let is_fused = ctx.node_prefix_p != null;
            is_fused != 0 => CheckLast;
            _             => DoRet;
        }
        CheckLast: {
            let is_last = ctx.fused_is_last;
            is_last == 0 => EmitBranchNext;
            _            => DoRet;
        }
        EmitBranchNext: {
            let _ = call record_fused_return(ctx, cur_val, cur_bb);
            let _ = call emit_str(ctx, "  br label %", 12);
            let _ = call emit_str(ctx, ctx.fused_next_bb_p, ctx.fused_next_bb_l);
            let _ = call emit_nl(ctx);
            _ => return ctx.out_pos;
        }
        DoRet: {
            let _ = call emit_ret_inst(ctx, m, cur_val);
            _ => return ctx.out_pos;
        }
    }
}

machine emit_state_rules(ctx: *CodegenCtx, m: *MachineDef, s: *StateDef, s_idx: u32, start_bb: *BasicBlock) -> u32 {
    flow {
        reg r_idx: u32 = 0;
        reg cur_bb: *BasicBlock = start_bb;
        reg cur_rule: *TransitionRule = null;
        reg then_bb_r: *BasicBlock = null;
        reg else_bb_p_r: *u8 = null;
        reg else_bb_l_r: u32 = 0;
        reg branch_cap_r: u32 = 0;
        wire has_more = cur_rule != null;
        wire rule = cur_rule;
        wire rule_ret = cur_rule.ret_expr;
        wire rule_guard = cur_rule.guard;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            ctx.cur_state_p <- s.name_ptr;
            ctx.cur_state_l <- s.name_len;
            _ => Loop [ r_idx <= 0, cur_bb <= start_bb, cur_rule <= s.rules ];
        }
        Loop: {
            has_more != 0 => CheckGuarded;
            _             => UnterminatedTrap;
        }
        CheckGuarded: {
            rule_guard != null => GuardedBranch;
            _                  => UnguardedRule;
        }
        GuardedBranch: {
            let gt_p = call get_expr_type(ctx, rule_guard);
            let gt_l = call strlen(gt_p);
            let is_vec_mask = call is_type_vector_mask(gt_p, gt_l);
            is_vec_mask != 0 => VectorGuardError;

            let cond_val = call emit_expr(ctx, rule_guard);

            // then_bb: "{s.name}_then_{r_idx}"
            let b_then_bb_p = alloc.base_ptr;
            let off_then_bb_p = alloc.offset;
            let then_bb_p = b_then_bb_p + off_then_bb_p;
            let _ = call append_str_to_alloc(alloc, s.name_ptr, s.name_len);
            let _ = call append_str_to_alloc(alloc, "_then_", 6);
            let _ = call append_u32_to_alloc(alloc, r_idx);
            let _ = call append_char_to_alloc(alloc, 0);
            let then_bb_l = call strlen(then_bb_p);

            // else_bb: "{s.name}_else_{r_idx}"
            let b_else_bb_p = alloc.base_ptr;
            let off_else_bb_p = alloc.offset;
            let else_bb_p = b_else_bb_p + off_else_bb_p;
            let _ = call append_str_to_alloc(alloc, s.name_ptr, s.name_len);
            let _ = call append_str_to_alloc(alloc, "_else_", 6);
            let _ = call append_u32_to_alloc(alloc, r_idx);
            let _ = call append_char_to_alloc(alloc, 0);
            let else_bb_l = call strlen(else_bb_p);

            // 現在のブロックに分岐を出力
            let _ = call emit_str(ctx, "  br i1 ", 8);
            let _ = call emit_str(ctx, cond_val, call strlen(cond_val));
            let _ = call emit_str(ctx, ", label %", 9);
            let _ = call emit_str(ctx, then_bb_p, then_bb_l);
            let _ = call emit_str(ctx, ", label %", 9);
            let _ = call emit_str(ctx, else_bb_p, else_bb_l);
            let _ = call emit_nl(ctx);
            let _ = call finish_cur_bb(ctx, cur_bb);

            // then_bb を追加して switch_to_bb
            let branch_cap = call calc_branch_bb_size(m);
            let then_bb = call add_basic_block(ctx, then_bb_p, then_bb_l, -1, branch_cap);
            let _ = call switch_to_bb(ctx, then_bb);

            rule.is_return != 0 => EmitThenReturn [ then_bb_r <= then_bb, else_bb_p_r <= else_bb_p, else_bb_l_r <= else_bb_l, branch_cap_r <= branch_cap ];
            rule.is_panic != 0  => EmitThenPanic  [ then_bb_r <= then_bb, else_bb_p_r <= else_bb_p, else_bb_l_r <= else_bb_l, branch_cap_r <= branch_cap ];
            _                   => EmitThenTrans  [ then_bb_r <= then_bb, else_bb_p_r <= else_bb_p, else_bb_l_r <= else_bb_l, branch_cap_r <= branch_cap ];
        }
        EmitThenReturn: {
            rule_ret != null => ThenRetVal;
            _                => ThenRetVoid;
        }
        ThenRetVal: {
            let _ = call emit_ret_value(ctx, m, rule_ret, then_bb_r);
            _ => FinishThenBb;
        }
        ThenRetVoid: {
            let _ = call emit_str(ctx, "  ret void", 10);
            let _ = call emit_nl(ctx);
            _ => FinishThenBb;
        }
        EmitThenPanic: {
            let _ = call emit_str(ctx, "  call void @exit(i32 255)", 26);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  unreachable", 13);
            let _ = call emit_nl(ctx);
            _ => FinishThenBb;
        }
        EmitThenTrans: {
            let _ = call record_latches_for_rule(ctx, m, rule, then_bb_r.name_ptr, then_bb_r.name_len);
            let _ = call emit_branch_target(ctx, rule.target_ptr, rule.target_len);
            _ => FinishThenBb;
        }
        FinishThenBb: {
            let _ = call finish_cur_bb(ctx, then_bb_r);

            // else_bb を追加して switch_to_bb し、次のルールへ
            let else_bb = call add_basic_block(ctx, else_bb_p_r, else_bb_l_r, -1, branch_cap_r);
            let _ = call switch_to_bb(ctx, else_bb);

            _ => Loop [ r_idx <= r_idx + 1, cur_bb <= else_bb, cur_rule <= cur_rule.next ];
        }
        UnguardedRule: {
            rule.is_return != 0 => UnguardedReturn;
            rule.is_panic != 0  => UnguardedPanic;
            _                   => UnguardedTrans;
        }
        UnguardedReturn: {
            rule_ret != null => UnguardedRetVal;
            _                => UnguardedRetVoid;
        }
        UnguardedRetVal: {
            let _ = call emit_ret_value(ctx, m, rule_ret, cur_bb);
            _ => FinishStateBlock;
        }
        UnguardedRetVoid: {
            let _ = call emit_str(ctx, "  ret void", 10);
            let _ = call emit_nl(ctx);
            _ => FinishStateBlock;
        }
        UnguardedPanic: {
            let _ = call emit_str(ctx, "  call void @exit(i32 255)", 26);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  unreachable", 13);
            let _ = call emit_nl(ctx);
            _ => FinishStateBlock;
        }
        UnguardedTrans: {
            let _ = call record_latches_for_rule(ctx, m, rule, cur_bb.name_ptr, cur_bb.name_len);
            let _ = call emit_branch_target(ctx, rule.target_ptr, rule.target_len);
            _ => FinishStateBlock;
        }
        VectorGuardError: {
            let _ = call write(2, "error: Vector comparison (<N x i1>) cannot be used directly as a state transition guard (SPEC_V0_14)\n", 104);
            _ => panic(1);
        }
        UnterminatedTrap: {
            let _ = call emit_str(ctx, "  call void @exit(i32 255)", 26);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  unreachable", 13);
            let _ = call emit_nl(ctx);
            _ => FinishStateBlock;
        }
        FinishStateBlock: {
            let _ = call finish_cur_bb(ctx, cur_bb);
            _ => return 0;
        }
    }
}

machine find_state_by_idx(m: *MachineDef, target_idx: u32) -> *StateDef {
    flow {
        reg cur_s: *StateDef = null;
        reg idx:   u32 = 0;
        wire has_more = cur_s != null;
        wire is_match = idx == target_idx;
    }
    states {
        Entry: {
            _ => Loop [ cur_s <= m.state_defs, idx <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Next;
        }
        Found: {
            _ => return cur_s;
        }
        Next: {
            _ => Loop [ cur_s <= cur_s.next, idx <= idx + 1 ];
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine assemble_machine_blocks(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg b_idx: u32 = 0;
        wire cnt = ctx.block_cnt;
        wire has_more = b_idx < cnt;
        wire fld_bb = ctx.blocks;
        wire bb = fld_bb + b_idx;
    }
    states {
        Entry: {
            _ => Loop [ b_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitBlock;
            _             => Exit;
        }
        EmitBlock: {
            // ラベル
            let _ = call emit_str(ctx, bb.name_ptr, bb.name_len);
            let _ = call emit_char(ctx, 58); // ':'
            let _ = call emit_nl(ctx);

            let s_idx = bb.state_idx;
            s_idx >= 1 => EmitPhis;
            _          => EmitInsts;
        }
        EmitPhis: {
            let s = call find_state_by_idx(m, bb.state_idx);
            s != null => DoEmitPhis;
            _         => EmitInsts;
        }
        DoEmitPhis: {
            let s = call find_state_by_idx(m, bb.state_idx);
            let _ = call emit_state_phi_nodes(ctx, m, s, bb.state_idx);
            _ => EmitInsts;
        }
        EmitInsts: {
            let _ = call emit_str(ctx, bb.buf_ptr, bb.buf_pos);
            _ => Loop [ b_idx <= b_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine record_one_latch_phi(
    ctx: *CodegenCtx,
    reg_def: *RegDef,
    rule: *TransitionRule,
    target_s_idx: i32,
    r_idx: u32,
    from_bb_p: *u8,
    from_bb_l: u32
) -> u32 {
    flow {
        reg cur_val: *u8 = null;
        reg cur_bt:  *TypeDef = null;
        wire latch_e = call find_latch_expr(rule, reg_def.name_ptr, reg_def.name_len);
        wire ssa_p = call env_get_ptr(ctx, reg_def.name_ptr, reg_def.name_len);
    }
    states {
        Entry: {
            latch_e != null => HasLatch;
            _               => DefaultLatch;
        }
        HasLatch: {
            let val = call emit_expr(ctx, latch_e);
            let lt = call get_expr_type(ctx, latch_e);
            let ltl = call strlen(lt);
            let ok = call validate_type(ctx, 3, reg_def.name_ptr, reg_def.name_len, 0, reg_def.type_ptr, reg_def.type_len, lt, ltl, latch_e);
            let btype = call find_bounded_type(ctx.prog, reg_def.type_ptr, reg_def.type_len);
            btype != null => ClampLatch [ cur_val <= val, cur_bt <= btype ];
            _             => RecordLatch [ cur_val <= val ];
        }
        ClampLatch: {
            let cv = call emit_clamp(ctx, cur_val, cur_bt);
            _ => RecordLatch [ cur_val <= cv ];
        }
        RecordLatch: {
            let val_l = call strlen(cur_val);
            let _ = call record_phi_incoming(ctx, target_s_idx, r_idx, from_bb_p, from_bb_l, cur_val, val_l);
            _ => return 0;
        }
        DefaultLatch: {
            ssa_p != null => EmitEnvVal;
            _             => EmitDefVal;
        }
        EmitEnvVal: {
            let val_l = call strlen(ssa_p);
            let _ = call record_phi_incoming(ctx, target_s_idx, r_idx, from_bb_p, from_bb_l, ssa_p, val_l);
            _ => return 0;
        }
        EmitDefVal: {
            let def_val = call get_default_reg_val(reg_def.type_ptr, reg_def.type_len);
            let val_l = call strlen(def_val);
            let _ = call record_phi_incoming(ctx, target_s_idx, r_idx, from_bb_p, from_bb_l, def_val, val_l);
            _ => return 0;
        }
    }
}

machine record_latches_for_rule(ctx: *CodegenCtx, m: *MachineDef, rule: *TransitionRule, from_bb_p: *u8, from_bb_l: u32) -> u32 {
    flow {
        reg r_idx: u32 = 0;
        wire cnt = m.reg_count;
        wire has_more = r_idx < cnt;
        wire fld_reg_def = m.regs;
        wire reg_def = fld_reg_def + r_idx;
        wire target_s_idx = call find_state_idx(m, rule.target_ptr, rule.target_len);
    }
    states {
        Entry: {
            target_s_idx < 0 => Exit;
            _                => Loop [ r_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => ProcessOneReg;
            _             => Exit;
        }
        ProcessOneReg: {
            let _ = call record_one_latch_phi(ctx, reg_def, rule, target_s_idx, r_idx, from_bb_p, from_bb_l);
            _ => Loop [ r_idx <= r_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine find_state_idx(m: *MachineDef, name_p: *u8, name_l: u32) -> i32 {
    flow {
        reg cur_s: *StateDef = null;
        reg idx:   u32 = 0;
        wire has_more = cur_s != null;
        wire is_match = call str_eq(cur_s.name_ptr, cur_s.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ cur_s <= m.state_defs, idx <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Next;
        }
        Found: {
            _ => return idx;
        }
        Next: {
            _ => Loop [ cur_s <= cur_s.next, idx <= idx + 1 ];
        }
        NotFound: {
            _ => return -1;
        }
    }
}

machine find_latch_expr(rule: *TransitionRule, name_p: *u8, name_l: u32) -> *ExprNode {
    flow {
        reg cur_l: *LatchAssign = null;
        wire has_more = cur_l != null;
        wire is_match = call str_eq(cur_l.reg_ptr, cur_l.reg_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ cur_l <= rule.latches ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Next;
        }
        Found: {
            _ => return cur_l.expr;
        }
        Next: {
            _ => Loop [ cur_l <= cur_l.next ];
        }
        NotFound: {
            _ => return null;
        }
    }
}

