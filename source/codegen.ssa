// StateSSA Compiler: Semantic Analysis & Static Type Validator (sema.ssa)
// 型環境・型推論・静的型バリデータ・型診断出力
// ============================================================================


machine register_type_map(ctx: *CodegenCtx, src_p: *u8, src_l: u32, llvm_p: *u8, llvm_l: u32) -> u32 {
    flow {
        wire idx = ctx.type_map_cnt;
        wire fld_entry = ctx.type_map;
        wire entry = fld_entry + idx;
    }
    states {
        Entry: {
            entry.src_ptr  <- src_p;
            entry.src_len  <- src_l;
            entry.llvm_ptr <- llvm_p;
            entry.llvm_len <- llvm_l;
            ctx.type_map_cnt <- idx + 1;
            _ => return ctx.type_map_cnt;
        }
    }
}

machine init_builtin_types(ctx: *CodegenCtx) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call register_type_map(ctx, "i32", 3, "i32", 3);
            let _ = call register_type_map(ctx, "*i32", 4, "i32*", 4);
            let _ = call register_type_map(ctx, "u32", 3, "i32", 3);
            let _ = call register_type_map(ctx, "*u32", 4, "i32*", 4);
            let _ = call register_type_map(ctx, "i64", 3, "i64", 3);
            let _ = call register_type_map(ctx, "*i64", 4, "i64*", 4);
            let _ = call register_type_map(ctx, "u64", 3, "i64", 3);
            let _ = call register_type_map(ctx, "*u64", 4, "i64*", 4);
            let _ = call register_type_map(ctx, "u16", 3, "i16", 3);
            let _ = call register_type_map(ctx, "*u16", 4, "i16*", 4);
            let _ = call register_type_map(ctx, "u8", 2, "i8", 2);
            let _ = call register_type_map(ctx, "*u8", 3, "i8*", 3);
            let _ = call register_type_map(ctx, "i8", 2, "i8", 2);
            let _ = call register_type_map(ctx, "*i8", 3, "i8*", 3);
            let _ = call register_type_map(ctx, "*void", 5, "i8*", 3);
            let _ = call register_type_map(ctx, "void", 4, "void", 4);
            let _ = call register_type_map(ctx, "q64", 3, "i64", 3);
            let _ = call register_type_map(ctx, "*q64", 4, "i64*", 4);
            let _ = call register_type_map(ctx, "f32", 3, "float", 5);
            let _ = call register_type_map(ctx, "*f32", 4, "float*", 6);
            let _ = call register_type_map(ctx, "f64", 3, "double", 6);
            let _ = call register_type_map(ctx, "*f64", 4, "double*", 7);
            _ => return 0;
        }
    }
}

machine register_struct_type_map(ctx: *CodegenCtx, name_p: *u8, name_l: u32) -> u32 {
    flow {
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            // "%struct.Name"
            let b_s_start = alloc.base_ptr;
            let off_s_start = alloc.offset;
            let s_start = b_s_start + off_s_start;
            let _ = call append_str_to_alloc(alloc, "%struct.", 8);
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let s_len = name_l + 8;
            let _ = call register_type_map(ctx, name_p, name_l, s_start, s_len);

            // "*Name" -> "%struct.Name*"
            let b_star_start = alloc.base_ptr;
            let off_star_start = alloc.offset;
            let star_start = b_star_start + off_star_start;
            let _ = call append_char_to_alloc(alloc, 42); // '*'
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let star_src_len = name_l + 1;

            let b_sptr_start = alloc.base_ptr;
            let off_sptr_start = alloc.offset;
            let sptr_start = b_sptr_start + off_sptr_start;
            let _ = call append_str_to_alloc(alloc, "%struct.", 8);
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let _ = call append_char_to_alloc(alloc, 42); // '*'
            let sptr_len = name_l + 9;

            let _ = call register_type_map(ctx, star_start, star_src_len, sptr_start, sptr_len);
            _ => return 0;
        }
    }
}

machine init_type_registry(ctx: *CodegenCtx) -> u32 {
    flow {
        reg t_idx: u32 = 0;
        wire prog = ctx.prog;
        wire t_cnt = prog.type_count;
        wire has_more_types = t_idx < t_cnt;
        wire fld_t_ptr = prog.types;
        wire t_ptr = fld_t_ptr + t_idx;
    }
    states {
        Entry: {
            let _ = call init_builtin_types(ctx);
            _ => TypesLoop [ t_idx <= 0 ];
        }
        TypesLoop: {
            has_more_types != 0 => ProcessType;
            _                   => Exit;
        }
        ProcessType: {
            let f_cnt = t_ptr.field_count;
            f_cnt == 1 => CheckAlias;
            _          => RegStruct;
        }
        CheckAlias: {
            let f0 = t_ptr.fields;
            let f0_nl = f0.name_len;
            f0_nl == 0 => RegAlias;
            _          => RegStruct;
        }
        RegAlias: {
            let f0 = t_ptr.fields;
            let target_p = f0.type_ptr;
            let target_l = f0.type_len;
            let mapped_llvm = call map_type_ptr(ctx, target_p, target_l);
            let mapped_len = call map_type_len(ctx, target_p, target_l);
            let _ = call register_type_map(ctx, t_ptr.name_ptr, t_ptr.name_len, mapped_llvm, mapped_len);
            _ => NextType;
        }
        RegStruct: {
            let _ = call register_struct_type_map(ctx, t_ptr.name_ptr, t_ptr.name_len);
            _ => NextType;
        }
        NextType: {
            _ => TypesLoop [ t_idx <= t_idx + 1 ];
        }
        Exit: {
            _ => return ctx.type_map_cnt;
        }
    }
}

machine find_type_map_entry(ctx: *CodegenCtx, type_p: *u8, type_l: u32) -> *TypeMapEntry {
    flow {
        reg i: u32 = 0;
        wire cnt = ctx.type_map_cnt;
        wire has_more = i < cnt;
        wire fld_entry = ctx.type_map;
        wire cur_entry = fld_entry + i;
        wire is_match = call str_eq(cur_entry.src_ptr, cur_entry.src_len, type_p, type_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return cur_entry;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine map_type_ptr(ctx: *CodegenCtx, type_p: *u8, type_l: u32) -> *u8 {
    flow {
        reg m_matched: *TypeMapEntry = null;
    }
    states {
        Entry: {
            let m = call find_type_map_entry(ctx, type_p, type_l);
            m == null => ReturnDefault;
            _         => ReturnMapped [ m_matched <= m ];
        }
        ReturnMapped: {
            let p = m_matched.llvm_ptr;
            _ => return p;
        }
        ReturnDefault: {
            _ => return type_p;
        }
    }
}

machine map_type_len(ctx: *CodegenCtx, type_p: *u8, type_l: u32) -> u32 {
    flow {
        reg m_matched: *TypeMapEntry = null;
    }
    states {
        Entry: {
            let m = call find_type_map_entry(ctx, type_p, type_l);
            m == null => ReturnDefault;
            _         => ReturnMapped [ m_matched <= m ];
        }
        ReturnMapped: {
            let l = m_matched.llvm_len;
            _ => return l;
        }
        ReturnDefault: {
            _ => return type_l;
        }
    }
}

machine is_type_64(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetZero;
            let l = call strlen(t);
            let is_i64 = call str_eq(t, l, "i64", 3);
            is_i64 != 0 => RetOne;
            let is_u64 = call str_eq(t, l, "u64", 3);
            is_u64 != 0 => RetOne;
            let is_q64 = call str_eq(t, l, "q64", 3);
            is_q64 != 0 => RetOne;
            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine is_type_q64(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetZero;
            let l = call strlen(t);
            let is_q = call str_eq(t, l, "q64", 3);
            is_q != 0 => RetOne;
            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine get_type_bit_width(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetDefault;
            let l = call strlen(t);

            // i64, u64, q64
            let is_i64 = call str_eq(t, l, "i64", 3);
            is_i64 != 0 => Ret64;
            let is_u64 = call str_eq(t, l, "u64", 3);
            is_u64 != 0 => Ret64;
            let is_q64 = call str_eq(t, l, "q64", 3);
            is_q64 != 0 => Ret64;

            // i16, u16
            let is_i16 = call str_eq(t, l, "i16", 3);
            is_i16 != 0 => Ret16;
            let is_u16 = call str_eq(t, l, "u16", 3);
            is_u16 != 0 => Ret16;

            // i8, u8
            let is_i8 = call str_eq(t, l, "i8", 2);
            is_i8 != 0 => Ret8;
            let is_u8 = call str_eq(t, l, "u8", 2);
            is_u8 != 0 => Ret8;

            // i1
            let is_i1 = call str_eq(t, l, "i1", 2);
            is_i1 != 0 => Ret1;

            // ポインタ (*...) は 64bit
            let c0 = *t;
            c0 == 42 => Ret64;

            _ => Ret32;
        }
        Ret64:   { _ => return 64; }
        Ret32:   { _ => return 32; }
        Ret16:   { _ => return 16; }
        Ret8:    { _ => return 8;  }
        Ret1:    { _ => return 1;  }
        RetDefault: { _ => return 32; }
    }
}

machine diag_nl() -> u32 {
    flow {}
    states {
        Entry: {
            let m = call malloc(2);
            *m <- 10;
            let _ = call write(2, m, 1);
            let _ = call free(m);
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine diag_write(buf: *u8, len: u32) -> u32 {
    flow {}
    states {
        Entry: {
            buf == null => Exit;
            len == 0    => Exit;
            let _ = call write(2, buf, len);
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine diag_str(s: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            s == null => Exit;
            let len = call strlen(s);
            let _ = call diag_write(s, len);
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine diag_u32(val: u32) -> u32 {
    flow {
        reg buf: *u8 = null;
        reg v:   u32 = 0;
        reg idx: u32 = 15;
    }
    states {
        Entry: {
            let m = call malloc(16);
            *(m + 15) <- 0;
            val == 0 => Zero [ buf <= m ];
            _        => Loop [ buf <= m, v <= val, idx <= 15 ];
        }
        Zero: {
            *(buf + 14) <- 48;
            let _ = call write(2, buf + 14, 1);
            let _ = call free(buf);
            _ => Exit;
        }
        Loop: {
            v == 0 => Flush;
            _      => Step;
        }
        Step: {
            let next_v = v / 10;
            let mul10 = next_v * 10;
            let digit = v - mul10;
            let ch_int = digit + 48;
            let ch = cast(u8) ch_int;
            let cur_idx = idx - 1;
            *(buf + cur_idx) <- ch;
            _ => Loop [ v <= next_v, idx <= cur_idx ];
        }
        Flush: {
            let start = buf + idx;
            let len = 15 - idx;
            let _ = call write(2, start, len);
            let _ = call free(buf);
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine diag_expr_name(expr: *ExprNode) -> u32 {
    flow {}
    states {
        Entry: {
            expr == null => PrintNullExpr;
            let k = expr.kind;
            k == 4  => PrintVar;
            k == 1  => PrintInt;
            k == 2  => PrintStr;
            k == 3  => PrintNullLit;
            k == 7  => PrintField;
            k == 8  => PrintCall;
            k == 10 => PrintCast;
            _       => PrintGeneric;
        }
        PrintNullExpr: {
            let _ = call diag_str("<null>");
            _ => Exit;
        }
        PrintVar: {
            let _ = call diag_write(expr.str_ptr, expr.str_len);
            _ => Exit;
        }
        PrintInt: {
            let iv = expr.int_val;
            let v32 = cast(u32) iv;
            let _ = call diag_u32(v32);
            _ => Exit;
        }
        PrintStr: {
            let _ = call diag_str("'");
            let _ = call diag_write(expr.str_ptr, expr.str_len);
            let _ = call diag_str("'");
            _ => Exit;
        }
        PrintNullLit: {
            let _ = call diag_str("null");
            _ => Exit;
        }
        PrintField: {
            let _ = call diag_expr_name(expr.left);
            let _ = call diag_str(".");
            let _ = call diag_write(expr.str_ptr, expr.str_len);
            _ => Exit;
        }
        PrintCall: {
            let _ = call diag_str("call ");
            let _ = call diag_write(expr.str_ptr, expr.str_len);
            let _ = call diag_str("(...)");
            _ => Exit;
        }
        PrintCast: {
            let _ = call diag_str("cast(");
            let _ = call diag_write(expr.str_ptr, expr.str_len);
            let _ = call diag_str(") ");
            let _ = call diag_expr_name(expr.left);
            _ => Exit;
        }
        PrintGeneric: {
            let _ = call diag_str("<expr>");
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine is_ptr_type_str(p: *u8, len: u32) -> u32 {
    flow {}
    states {
        Entry: {
            p == null => RetZero;
            len == 0  => RetZero;

            let c0 = *p;
            c0 == 42 => RetOne;

            let last_idx = len - 1;
            let c_last = *(p + last_idx);
            c_last == 42 => RetOne;

            let is_ptr = call str_eq(p, len, "ptr", 3);
            is_ptr != 0 => RetOne;

            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine is_ptr_type(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetZero;
            let l = call strlen(t);
            let r = call is_ptr_type_str(t, l);
            _     => return r;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine is_abi_bridge_arg(exp_p: *u8, exp_l: u32, act_p: *u8, act_l: u32) -> u32 {
    flow {}
    states {
        Entry: {
            exp_p == null => RetZero;
            act_p == null => RetZero;
            let is_act_q64 = call str_eq(act_p, act_l, "q64", 3);
            is_act_q64 == 0 => RetZero;

            let is_f64 = call str_eq(exp_p, exp_l, "f64", 3);
            is_f64 != 0 => RetOne;
            let is_f32 = call str_eq(exp_p, exp_l, "f32", 3);
            is_f32 != 0 => RetOne;
            let is_dbl = call str_eq(exp_p, exp_l, "double", 6);
            is_dbl != 0 => RetOne;
            let is_flt = call str_eq(exp_p, exp_l, "float", 5);
            is_flt != 0 => RetOne;

            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine is_type_compatible(kind: u32, exp_p: *u8, exp_l: u32, act_p: *u8, act_l: u32, expr: *ExprNode) -> u32 {
    flow {}
    states {
        Entry: {
            exp_p == null => RetPass;
            act_p == null => RetPass;
            exp_l == 0    => RetPass;
            act_l == 0    => RetPass;

            let is_bridge = call is_abi_bridge_arg(exp_p, exp_l, act_p, act_l);
            is_bridge != 0 => RetPass;

            let is_eq = call str_eq(exp_p, exp_l, act_p, act_l);
            is_eq != 0 => RetPass;

            let is_exp_ptr = call is_ptr_type_str(exp_p, exp_l);
            let is_act_ptr = call is_ptr_type_str(act_p, act_l);

            is_exp_ptr != 0 => CheckExpPtr;
            is_act_ptr != 0 => RetFail;
            _               => CheckNumeric;
        }
        CheckExpPtr: {
            let is_act_ptr = call is_ptr_type_str(act_p, act_l);
            is_act_ptr != 0 => RetPass;

            let is_null = call str_eq(act_p, act_l, "null", 4);
            is_null != 0 => RetPass;

            let is_vptr = call str_eq(act_p, act_l, "*void", 5);
            is_vptr != 0 => RetPass;

            _ => RetFail;
        }
        CheckNumeric: {
            expr == null => CheckWidth;
            let ek = expr.kind;
            ek == 1 => RetPass;
            _       => CheckWidth;
        }
        CheckWidth: {
            let exp_w = call get_type_bit_width(exp_p);
            let act_w = call get_type_bit_width(act_p);

            exp_w == act_w => RetPass;
            act_w < exp_w  => RetPass;

            kind == 2 => CheckByteStore;
            _         => RetFail;
        }
        CheckByteStore: {
            let exp_w = call get_type_bit_width(exp_p);
            exp_w <= 16 => RetPass;
            _           => RetFail;
        }
        RetPass: {
            _ => return 1;
        }
        RetFail: {
            _ => return 0;
        }
    }
}

machine get_diag_kind_str(kind: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            kind == 1 => RetCallArg;
            kind == 2 => RetStore;
            kind == 3 => RetLatch;
            kind == 4 => RetReturn;
            _         => RetUnknown;
        }
        RetCallArg: { _ => return "Function Call Argument"; }
        RetStore:   { _ => return "Memory / Field Store"; }
        RetLatch:   { _ => return "Register Latch Assignment"; }
        RetReturn:  { _ => return "Machine Return Value"; }
        RetUnknown: { _ => return "Unknown Expression"; }
    }
}

machine emit_diag_context(ctx: *CodegenCtx, target_p: *u8, target_l: u32, kind: u32, arg_idx: u32) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call diag_str("  Machine:   ");
            let cur_m = ctx.cur_machine;
            cur_m != null => MachName;
            _             => MachUnknown;
        }
        MachName: {
            let m = ctx.cur_machine;
            let _ = call diag_write(m.name_ptr, m.name_len);
            let _ = call diag_nl();
            _ => StateEntry;
        }
        MachUnknown: {
            let _ = call diag_str("<unknown>");
            let _ = call diag_nl();
            _ => StateEntry;
        }
        StateEntry: {
            let _ = call diag_str("  State:     ");
            let sp = ctx.cur_state_p;
            sp != null => StateName;
            _          => StateUnknown;
        }
        StateName: {
            let _ = call diag_write(ctx.cur_state_p, ctx.cur_state_l);
            let _ = call diag_nl();
            _ => TargetEntry;
        }
        StateUnknown: {
            let _ = call diag_str("<unknown>");
            let _ = call diag_nl();
            _ => TargetEntry;
        }
        TargetEntry: {
            let _ = call diag_str("  Target:    ");
            target_p != null => TargetStr;
            _                => TargetNone;
        }
        TargetStr: {
            let _ = call diag_write(target_p, target_l);
            kind == 1 => ArgIdx;
            _         => TargetNl;
        }
        ArgIdx: {
            let _ = call diag_str(" (Argument #");
            let _ = call diag_u32(arg_idx);
            let _ = call diag_str(")");
            let _ = call diag_nl();
            _ => return 0;
        }
        TargetNone: {
            let _ = call diag_str("<anonymous>");
            let _ = call diag_nl();
            _ => return 0;
        }
        TargetNl: {
            let _ = call diag_nl();
            _ => return 0;
        }
    }
}

machine emit_type_diagnostic(
    ctx: *CodegenCtx,
    kind: u32,
    target_p: *u8,
    target_l: u32,
    arg_idx: u32,
    exp_p: *u8,
    exp_l: u32,
    act_p: *u8,
    act_l: u32,
    expr: *ExprNode
) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            let _ = call diag_str("[StateSSA Type Error]: Incompatible type detected!");
            let _ = call diag_nl();

            let _ = call diag_str("  Kind:      ");
            let k_str = call get_diag_kind_str(kind);
            let _ = call diag_str(k_str);
            let _ = call diag_nl();

            let _ = call emit_diag_context(ctx, target_p, target_l, kind, arg_idx);

            let _ = call diag_str("  Expected:  ");
            let _ = call diag_write(exp_p, exp_l);
            let _ = call diag_nl();

            let _ = call diag_str("  Actual:    ");
            let _ = call diag_write(act_p, act_l);
            let _ = call diag_str(" (expression: '");
            let _ = call diag_expr_name(expr);
            let _ = call diag_str("')");
            let _ = call diag_nl();

            let _ = call diag_str("  Fix Hint:  Explicit conversion required. Use 'cast(");
            let _ = call diag_write(exp_p, exp_l);
            let _ = call diag_str(") ");
            let _ = call diag_expr_name(expr);
            let _ = call diag_str("'");
            let _ = call diag_nl();

            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            let _ = call diag_nl();

            ctx.error_code <- -50;
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine validate_type(
    ctx: *CodegenCtx,
    kind: u32,
    target_p: *u8,
    target_l: u32,
    arg_idx: u32,
    exp_p: *u8,
    exp_l: u32,
    act_p: *u8,
    act_l: u32,
    expr: *ExprNode
) -> u32 {
    flow {}
    states {
        Entry: {
            let is_comp = call is_type_compatible(kind, exp_p, exp_l, act_p, act_l, expr);
            is_comp != 0 => RetPass;
            _            => DoDiag;
        }
        DoDiag: {
            let _ = call emit_type_diagnostic(ctx, kind, target_p, target_l, arg_idx, exp_p, exp_l, act_p, act_l, expr);
            _ => RetFail;
        }
        RetPass: {
            _ => return 1;
        }
        RetFail: {
            _ => return 0;
        }
    }
}

machine get_expr_type(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg m: *MachineDef = null;
    }
    states {
        Entry: {
            expr == null => ReturnVoid;
            let m_cur = ctx.cur_machine;
            let k = expr.kind;
            k == 1 => ReturnI32;       // INT
            k == 2 => ReturnU8Ptr;     // STR
            k == 3 => ReturnVoidPtr;   // NULL
            k == 4 => ResolveVar      [ m <= m_cur ]; // VAR
            k == 5 => ResolveBinOp    [ m <= m_cur ]; // BINOP
            k == 6 => ResolveUnOp     [ m <= m_cur ]; // UNOP
            k == 7 => ResolveField    [ m <= m_cur ]; // FIELD
            k == 8 => ResolveCall     [ m <= m_cur ]; // CALL
            k == 9  => ResolveStruct   [ m <= m_cur ]; // STRUCT
            k == 10 => ReturnCastType;                 // CAST
            k == 11 => ReturnQ64;                      // Q64
            _       => ReturnI32;
        }
        ReturnVoid: {
            _ => return "void";
        }
        ReturnI32: {
            _ => return "i32";
        }
        ReturnQ64: {
            _ => return "q64";
        }
        ReturnU8Ptr: {
            _ => return "*u8";
        }
        ReturnVoidPtr: {
            _ => return "*void";
        }
        ResolveVar: {
            let res = call get_var_type(ctx, m, expr.str_ptr, expr.str_len);
            _ => return res;
        }
        ResolveBinOp: {
            let res = call get_binop_type(ctx, expr);
            _ => return res;
        }
        ResolveUnOp: {
            let res = call get_unop_type(ctx, expr);
            _ => return res;
        }
        ResolveField: {
            let res = call get_field_type(ctx, expr);
            _ => return res;
        }
        ResolveCall: {
            let res = call find_func_ret_type(ctx.prog, ctx.alloc, expr.str_ptr, expr.str_len);
            let rl = call strlen(res);
            let is_f64 = call str_eq(res, rl, "f64", 3);
            is_f64 != 0 => ReturnQ64;
            let is_f32 = call str_eq(res, rl, "f32", 3);
            is_f32 != 0 => ReturnQ64;
            _ => return res;
        }
        ResolveStruct: {
            let res = call make_cstr(ctx.alloc, expr.str_ptr, expr.str_len);
            _ => return res;
        }
        ReturnCastType: {
            let res = call make_cstr(ctx.alloc, expr.str_ptr, expr.str_len);
            _ => return res;
        }
    }
}

machine find_let_var_type(ctx: *CodegenCtx, m: *MachineDef, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        reg cur_s:   *StateDef = null;
        reg cur_act: *ActionStmt = null;
    }
    states {
        Entry: {
            m == null => NotFound;
            _ => StateLoop [ cur_s <= m.state_defs ];
        }
        StateLoop: {
            cur_s == null => NotFound;
            _             => ActionLoop [ cur_act <= cur_s.actions ];
        }
        ActionLoop: {
            cur_act == null => NextState;
            _               => CheckAction;
        }
        CheckAction: {
            let k = cur_act.kind;
            k != 1 => NextAction; // 1: LET
            let tp = cur_act.target_ptr;
            tp == null => NextAction;
            let tl = cur_act.target_len;
            let is_match = call str_eq(tp, tl, name_p, name_l);
            is_match != 0 => FoundTarget;
            _             => NextAction;
        }
        FoundTarget: {
            let t = call get_expr_type(ctx, cur_act.expr);
            _ => return t;
        }
        NextAction: {
            _ => ActionLoop [ cur_act <= cur_act.next ];
        }
        NextState: {
            _ => StateLoop [ cur_s <= cur_s.next ];
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine get_var_type(ctx: *CodegenCtx, m: *MachineDef, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        reg res_type: *u8 = "i32";
    }
    states {
        Entry: {
            m == null => Exit;
            let pt = call find_param_type(ctx, m, name_p, name_l);
            pt != null => Exit [ res_type <= pt ];
            let rt = call find_reg_type(ctx, m, name_p, name_l);
            rt != null => Exit [ res_type <= rt ];
            let wt = call find_wire_type(ctx, m, name_p, name_l);
            wt != null => Exit [ res_type <= wt ];
            let lt = call find_let_var_type(ctx, m, name_p, name_l);
            lt != null => Exit [ res_type <= lt ];
            _          => Exit;
        }
        Exit: {
            _ => return res_type;
        }
    }
}

machine find_param_idx(m: *MachineDef, name_p: *u8, name_l: u32) -> i32 {
    flow {
        reg i: u32 = 0;
        wire cnt = m.param_count;
        wire has_more = i < cnt;
        wire fld_p = m.params;
        wire p = fld_p + i;
        wire is_match = call str_eq(p.name_ptr, p.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return i;
        }
        NotFound: {
            _ => return -1;
        }
    }
}

machine find_param_type(ctx: *CodegenCtx, m: *MachineDef, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        reg p_idx: i32 = -1;
    }
    states {
        Entry: {
            let idx = call find_param_idx(m, name_p, name_l);
            idx < 0 => ReturnNull;
            _       => ReturnFound [ p_idx <= idx ];
        }
        ReturnFound: {
            let u_idx = cast(u32) p_idx;
            let fld_p = m.params;
            let p = fld_p + u_idx;
            let res = call make_cstr(ctx.alloc, p.type_ptr, p.type_len);
            _ => return res;
        }
        ReturnNull: {
            _ => return null;
        }
    }
}

machine find_reg_type(ctx: *CodegenCtx, m: *MachineDef, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        reg i: u32 = 0;
        wire cnt = m.reg_count;
        wire has_more = i < cnt;
        wire fld_r = m.regs;
        wire r = fld_r + i;
        wire is_match = call str_eq(r.name_ptr, r.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            let res = call make_cstr(ctx.alloc, r.type_ptr, r.type_len);
            _ => return res;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine find_wire(m: *MachineDef, name_p: *u8, name_l: u32) -> *WireDef {
    flow {
        reg i: u32 = 0;
        wire cnt = m.wire_count;
        wire has_more = i < cnt;
        wire fld_w = m.wires;
        wire w = fld_w + i;
        wire is_match = call str_eq(w.name_ptr, w.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return w;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine find_wire_type(ctx: *CodegenCtx, m: *MachineDef, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        reg w_matched: *WireDef = null;
    }
    states {
        Entry: {
            let w = call find_wire(m, name_p, name_l);
            w == null => ReturnNull;
            _         => ReturnFound [ w_matched <= w ];
        }
        ReturnFound: {
            let res = call get_expr_type(ctx, w_matched.expr);
            _ => return res;
        }
        ReturnNull: {
            _ => return null;
        }
    }
}

machine get_binop_type(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg left_t: *u8 = "i32";
        wire op = expr.op;
    }
    states {
        Entry: {
            op == 46 => ReturnI1; // ==
            op == 47 => ReturnI1; // !=
            op == 60 => ReturnI1; // <
            op == 44 => ReturnI1; // <=
            op == 61 => ReturnI1; // >
            op == 48 => ReturnI1; // >=
            op == 50 => ReturnI1; // &&
            op == 49 => ReturnI1; // ||
            op == 71 => CheckAdd; // +
            _        => CheckArith;
        }
        ReturnI1: {
            _ => return "i1";
        }
        CheckAdd: {
            let lt = call get_expr_type(ctx, expr.left);
            let c0_is_ptr = *lt;
            let is_ptr = c0_is_ptr == 42;
            is_ptr != 0 => ReturnLeft [ left_t <= lt ];
            _           => CheckArith;
        }
        CheckArith: {
            let lt = call get_expr_type(ctx, expr.left);
            let is_lq64 = call is_type_q64(lt);
            is_lq64 != 0 => ReturnQ64;
            let rt = call get_expr_type(ctx, expr.right);
            let is_rq64 = call is_type_q64(rt);
            is_rq64 != 0 => ReturnQ64;

            let is_l64 = call is_type_64(lt);
            is_l64 != 0 => ReturnI64;
            let is_r64 = call is_type_64(rt);
            is_r64 != 0 => ReturnI64;
            _           => ReturnI32;
        }
        ReturnQ64: {
            _ => return "q64";
        }
        ReturnLeft: {
            _ => return left_t;
        }
        ReturnI64: {
            _ => return "i64";
        }
        ReturnI32: {
            _ => return "i32";
        }
    }
}

machine get_unop_type(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg sub_type: *u8 = "i32";
        wire op = expr.op;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            op == 62 => HandleAddr;  // '&' (token 62)
            op == 70 => HandleDeref; // '*' (token 70)
            _        => HandleOther;
        }
        HandleAddr: {
            let sub_t = call get_expr_type(ctx, expr.left);
            let b_ptr_start = alloc.base_ptr;
            let off_ptr_start = alloc.offset;
            let ptr_start = b_ptr_start + off_ptr_start;
            let _ = call append_char_to_alloc(alloc, 42); // '*'
            let _ = call append_str_to_alloc(alloc, sub_t, call strlen(sub_t));
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return ptr_start;
        }
        HandleDeref: {
            let sub_t = call get_expr_type(ctx, expr.left);
            let c0_is_ptr = *sub_t;
            let is_ptr = c0_is_ptr == 42;
            is_ptr != 0 => StripStar [ sub_type <= sub_t ];
            _           => ReturnI32;
        }
        StripStar: {
            _ => return sub_type + 1;
        }
        ReturnI32: {
            _ => return "i32";
        }
        HandleOther: {
            let sub_t = call get_expr_type(ctx, expr.left);
            _ => return sub_t;
        }
    }
}

machine get_field_type(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg base_type: *u8 = null;
    }
    states {
        Entry: {
            let bt = call get_expr_type(ctx, expr.left);
            let c0_is_ptr = *bt;
            let is_ptr = c0_is_ptr == 42;
            is_ptr != 0 => FromPtrType [ base_type <= bt ];
            _           => FromValType [ base_type <= bt ];
        }
        FromPtrType: {
            let sname = base_type + 1;
            let res = call find_struct_field_type(ctx.prog, ctx.alloc, sname, expr.str_ptr, expr.str_len);
            _ => return res;
        }
        FromValType: {
            let res = call find_struct_field_type(ctx.prog, ctx.alloc, base_type, expr.str_ptr, expr.str_len);
            _ => return res;
        }
    }
}

machine find_struct_def(prog: *ProgramDef, sname_p: *u8, sname_l: u32) -> *TypeDef {
    flow {
        reg i: u32 = 0;
        wire cnt = prog.type_count;
        wire has_more = i < cnt;
        wire fld_t = prog.types;
        wire cur_t = fld_t + i;
        wire is_match = call str_eq(cur_t.name_ptr, cur_t.name_len, sname_p, sname_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return cur_t;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine find_field_idx_in_type(t: *TypeDef, fname_p: *u8, fname_l: u32) -> i32 {
    flow {
        reg i: u32 = 0;
        wire cnt = t.field_count;
        wire has_more = i < cnt;
        wire fld_f = t.fields;
        wire cur_f = fld_f + i;
        wire is_match = call str_eq(cur_f.name_ptr, cur_f.name_len, fname_p, fname_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return cast(i32) i;
        }
        NotFound: {
            _ => return -1;
        }
    }
}

machine find_field_in_type(alloc: *BumpAlloc, t: *TypeDef, fname_p: *u8, fname_l: u32) -> *u8 {
    flow {
        reg res: *u8 = "i32";
    }
    states {
        Entry: {
            let idx = call find_field_idx_in_type(t, fname_p, fname_l);
            idx < 0 => Exit;
            let u_idx = cast(u32) idx;
            let fld_f = t.fields;
            let f = fld_f + u_idx;
            let s = call make_cstr(alloc, f.type_ptr, f.type_len);
            _       => Exit [ res <= s ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine find_struct_field_type(prog: *ProgramDef, alloc: *BumpAlloc, sname_p: *u8, fname_p: *u8, fname_l: u32) -> *u8 {
    flow {
        reg res: *u8 = "i32";
    }
    states {
        Entry: {
            let sl = call strlen(sname_p);
            let t = call find_struct_def(prog, sname_p, sl);
            t == null => Exit;
            let r = call find_field_in_type(alloc, t, fname_p, fname_l);
            _         => Exit [ res <= r ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine find_func_ret_type(prog: *ProgramDef, alloc: *BumpAlloc, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        wire ext = call find_extern_in_prog(prog, name_p, name_l);
        wire mach = call find_machine_in_prog(prog, name_p, name_l);
    }
    states {
        Entry: {
            ext != null  => FromExt;
            mach != null => FromMach;
            _            => DefaultVoid;
        }
        FromExt: {
            let res = call make_cstr(alloc, ext.ret_type_ptr, ext.ret_type_len);
            _ => return res;
        }
        FromMach: {
            let res = call make_cstr(alloc, mach.ret_type_ptr, mach.ret_type_len);
            _ => return res;
        }
        DefaultVoid: {
            _ => return "void";
        }
    }
}

machine is_pointer_add(left_type: *u8, op: u32) -> u32 {
    flow {}
    states {
        Entry: {
            left_type == null => RetZero;
            op != 71          => RetZero; // 71 is '+'
            let c0 = *left_type;
            c0 == 42          => RetOne;  // 42 is '*'
            _                 => RetZero;
        }
        RetOne: {
            _ => return 1;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine is_pointer_diff(left_type: *u8, right_type: *u8, op: u32) -> u32 {
    flow {}
    states {
        Entry: {
            left_type == null  => RetZero;
            right_type == null => RetZero;
            op != 72           => RetZero; // 72 is '-'
            let cl = *left_type;
            cl != 42           => RetZero; // '*'
            let cr = *right_type;
            cr == 42           => RetOne;  // '*'
            _                  => RetZero;
        }
        RetOne: {
            _ => return 1;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine is_pointer_cmp(left_type: *u8, right_type: *u8, op: u32) -> u32 {
    flow {
        wire is_eq = op == 46;
        wire is_ne = op == 47;
        wire is_cmp = is_eq || is_ne;
    }
    states {
        Entry: {
            is_cmp == 0 => RetZero;
            left_type != null => CheckLeft;
            _                 => CheckRight;
        }
        CheckLeft: {
            let cl = *left_type;
            cl == 42 => RetOne;
            _        => CheckRight;
        }
        CheckRight: {
            right_type == null => RetZero;
            let cr = *right_type;
            cr == 42 => RetOne;
            _        => RetZero;
        }
        RetOne: {
            _ => return 1;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine is_i1_type(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => NoMatch;
            let c0 = *t;
            c0 != 105 => NoMatch; // 'i'
            let p1 = t + 1;
            let c1 = *p1;
            c1 != 49  => NoMatch; // '1'
            let p2 = t + 2;
            let c2 = *p2;
            c2 == 0   => Match;
            _         => NoMatch;
        }
        Match:   { _ => return 1; }
        NoMatch: { _ => return 0; }
    }
}

machine is_type_small(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetZero;
            let l = call strlen(t);
            let is_i8 = call str_eq(t, l, "i8", 2);
            is_i8 != 0 => RetOne;
            let is_u8 = call str_eq(t, l, "u8", 2);
            is_u8 != 0 => RetOne;
            let is_i16 = call str_eq(t, l, "i16", 3);
            is_i16 != 0 => RetOne;
            let is_u16 = call str_eq(t, l, "u16", 3);
            is_u16 != 0 => RetOne;
            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine is_unsigned_type(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetZero;
            let l = call strlen(t);
            let is_u8 = call str_eq(t, l, "u8", 2);
            is_u8 != 0 => RetOne;
            let is_u16 = call str_eq(t, l, "u16", 3);
            is_u16 != 0 => RetOne;
            let is_u32 = call str_eq(t, l, "u32", 3);
            is_u32 != 0 => RetOne;
            let is_u64 = call str_eq(t, l, "u64", 3);
            is_u64 != 0 => RetOne;
            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine get_struct_field_idx(prog: *ProgramDef, sname_p: *u8, sname_l: u32, fname_p: *u8, fname_l: u32) -> i32 {
    flow {
        reg res: i32 = -1;
    }
    states {
        Entry: {
            let t = call find_struct_def(prog, sname_p, sname_l);
            t == null => Exit;
            let idx = call find_field_idx_in_type(t, fname_p, fname_l);
            _       => Exit [ res <= idx ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine get_struct_field_type_by_idx(prog: *ProgramDef, alloc: *BumpAlloc, sname_p: *u8, sname_l: u32, idx: u32) -> *u8 {
    flow {
        reg res: *u8 = "i32";
    }
    states {
        Entry: {
            let t = call find_struct_def(prog, sname_p, sname_l);
            t == null => Exit;
            let fc = t.field_count;
            let has_fld = idx < fc;
            has_fld == 0 => Exit;
            let fld_f = t.fields;
            let f = fld_f + idx;
            let s = call make_cstr(alloc, f.type_ptr, f.type_len);
            _            => Exit [ res <= s ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine resolve_var_struct_type(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg sname: *u8 = null;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            let stype = call get_expr_type(ctx, expr);
            let c0_is_ptr = *stype;
            let is_ptr = c0_is_ptr == 42;
            is_ptr != 0 => BuildStructType [ sname <= stype + 1 ];
            _           => BuildStructType [ sname <= stype ];
        }
        BuildStructType: {
            let b_s_start = alloc.base_ptr;
            let off_s_start = alloc.offset;
            let s_start = b_s_start + off_s_start;
            let _ = call append_str_to_alloc(alloc, "%struct.", 8);
            let _ = call append_str_to_alloc(alloc, sname, call strlen(sname));
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return s_start;
        }
    }
}

// ============================================================================
// StateSSA Compiler: Expression Codegen & Instruction Lowering (emit_expr.ssa)
// 式・二項演算・キャスト・構造体・関数呼び出しの LLVM IR 生成
// ============================================================================


machine emit_cast_op(ctx: *CodegenCtx, op_p: *u8, op_l: u32, src_t: *u8, src_l: u32, dst_t: *u8, dst_l: u32, val: *u8) -> *u8 {
    flow {}
    states {
        Entry: {
            let res = call fresh_tmp_str(ctx, op_p, op_l);
            let map_src_p = call map_type_ptr(ctx, src_t, src_l);
            let map_src_l = call map_type_len(ctx, src_t, src_l);
            let map_dst_p = call map_type_ptr(ctx, dst_t, dst_l);
            let map_dst_l = call map_type_len(ctx, dst_t, dst_l);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res, call strlen(res));
            let _ = call emit_str(ctx, " = ", 3);
            let _ = call emit_str(ctx, op_p, op_l);
            let _ = call emit_char(ctx, 32); // ' '
            let _ = call emit_str(ctx, map_src_p, map_src_l);
            let _ = call emit_char(ctx, 32); // ' '
            let _ = call emit_str(ctx, val, call strlen(val));
            let _ = call emit_str(ctx, " to ", 4);
            let _ = call emit_str(ctx, map_dst_p, map_dst_l);
            let _ = call emit_nl(ctx);
            _ => return res;
        }
    }
}

machine emit_cast_expr(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg src_is_ptr: u32 = 0;
        reg dst_is_ptr: u32 = 0;
        reg src_bits:   u32 = 32;
        reg dst_bits:   u32 = 32;
        reg val_str:    *u8 = null;
        reg s_type:     *u8 = null;
        reg d_type:     *u8 = null;

        wire operand = expr.left;
        wire target_t_p = expr.str_ptr;
        wire target_t_l = expr.str_len;
    }
    states {
        Entry: {
            let val = call emit_expr(ctx, operand);
            let st = call get_expr_type(ctx, operand);
            let dt = call make_cstr(ctx.alloc, target_t_p, target_t_l);

            let s_ptr = call is_ptr_type(st);
            let d_ptr = call is_ptr_type(dt);

            _ => Classify [ val_str <= val, s_type <= st, d_type <= dt, src_is_ptr <= s_ptr, dst_is_ptr <= d_ptr ];
        }
        Classify: {
            let s_l = call strlen(s_type);
            let d_l = call strlen(d_type);
            let is_same = call str_eq(s_type, s_l, d_type, d_l);
            is_same != 0 => ReturnNop;

            src_is_ptr != 0 => SrcIsPtr;
            _               => SrcIsInt;
        }
        ReturnNop: {
            _ => return val_str;
        }
        SrcIsPtr: {
            dst_is_ptr != 0 => PtrToPtr;
            _               => PtrToInt;
        }
        SrcIsInt: {
            dst_is_ptr != 0 => IntToPtr;
            _               => IntToInt;
        }
        PtrToPtr: {
            let res = call emit_cast_op(ctx, "bitcast", 7, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        PtrToInt: {
            let res = call emit_cast_op(ctx, "ptrtoint", 8, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        IntToPtr: {
            let res = call emit_cast_op(ctx, "inttoptr", 8, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        IntToInt: {
            let s_bits = call get_type_bit_width(s_type);
            let d_bits = call get_type_bit_width(d_type);

            s_bits < d_bits => DoZext;
            s_bits > d_bits => DoTrunc;
            _               => ReturnNop;
        }
        DoZext: {
            let res = call emit_cast_op(ctx, "zext", 4, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        DoTrunc: {
            let res = call emit_cast_op(ctx, "trunc", 5, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
    }
}

machine emit_expr(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        wire kind = expr.kind;
    }
    states {
        Entry: {
            expr == null => ReturnNull;
            kind == 1    => EmitIntLit;
            kind == 2    => EmitStringLit;
            kind == 3    => EmitNullLit;
            kind == 4    => EmitVarExpr;
            kind == 5    => EmitBinaryExpr;
            kind == 6    => EmitUnaryExpr;
            kind == 7    => EmitFieldExpr;
            kind == 8    => EmitCallExpr;
            kind == 9    => EmitStructLit;
            kind == 10   => EmitCastExpr;
            kind == 11   => EmitIntLit;
            _            => ReturnNull;
        }
        ReturnNull: {
            _ => return "null";
        }
        EmitVarExpr: {
            let res = call emit_var(ctx, expr);
            _ => return res;
        }
        EmitIntLit: {
            let res = call emit_int_lit(ctx, expr);
            _ => return res;
        }
        EmitStringLit: {
            let res = call emit_string_lit(ctx, expr);
            _ => return res;
        }
        EmitNullLit: {
            _ => return "null";
        }
        EmitBinaryExpr: {
            let res = call emit_bin_expr(ctx, expr);
            _ => return res;
        }
        EmitUnaryExpr: {
            let res = call emit_un_expr(ctx, expr);
            _ => return res;
        }
        EmitCallExpr: {
            let res = call emit_call_expr(ctx, expr);
            _ => return res;
        }
        EmitFieldExpr: {
            let res = call emit_field_expr(ctx, expr);
            _ => return res;
        }
        EmitStructLit: {
            let res = call emit_struct_lit(ctx, expr);
            _ => return res;
        }
        EmitCastExpr: {
            let res = call emit_cast_expr(ctx, expr);
            _ => return res;
        }
    }
}

machine emit_var(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg res_p: *u8 = null;
        wire name_p = expr.str_ptr;
        wire name_l = expr.str_len;
        wire m = ctx.cur_machine;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            // "null" チェック
            let is_null = call str_eq(name_p, name_l, "null", 4);
            is_null != 0 => ReturnNull;

            // マシンパラメータか？ -> "%arg_name"
            let is_param = call find_param_idx(m, name_p, name_l);
            is_param >= 0 => ReturnParam;

            // 現在のブロック環境 (cur_env) に登録されているか？
            let ssa_p = call env_get_ptr(ctx, name_p, name_l);
            ssa_p != null => ReturnEnv [ res_p <= ssa_p ];

            // マシンのワイヤーか？ -> オンデマンド展開して env に記録
            let wire_ptr = call find_wire(m, name_p, name_l);
            wire_ptr != null => ExpandWire;

            // デフォルト: "%name"
            let b_def_p = alloc.base_ptr;
            let off_def_p = alloc.offset;
            let def_p = b_def_p + off_def_p;
            let _ = call append_char_to_alloc(alloc, 37); // '%'
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return def_p;
        }
        ReturnNull: {
            _ => return "null";
        }
        ReturnParam: {
            let b_p_start = alloc.base_ptr;
            let off_p_start = alloc.offset;
            let p_start = b_p_start + off_p_start;
            let _ = call append_str_to_alloc(alloc, "%arg_", 5);
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return p_start;
        }
        ReturnEnv: {
            _ => return res_p;
        }
        ExpandWire: {
            let wire_ptr = call find_wire(m, name_p, name_l);
            let wire_res = call emit_expr(ctx, wire_ptr.expr);
            _ => return wire_res;
        }
    }
}

machine emit_int_lit(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg start_p: *u8 = null;
        wire val = expr.int_val;
        wire alloc = ctx.alloc;
        wire b_cur_p = alloc.base_ptr;
        wire off_cur_p = alloc.offset;
        wire cur_p = b_cur_p + off_cur_p;
    }
    states {
        Entry: {
            _ => Emit [ start_p <= cur_p ];
        }
        Emit: {
            let _ = call append_i64_to_alloc(alloc, val);
            let _ = call append_char_to_alloc(alloc, 0); // null終端
            _ => Exit;
        }
        Exit: {
            _ => return start_p;
        }
    }
}

machine emit_string_lit(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {}
    states {
        Entry: {
            let sym_id = call collect_string_const(ctx, expr.str_ptr, expr.str_len);
            let res_var = call fresh_tmp_str(ctx, "str", 3);
            let fld_byte_len = expr.str_len;
            let byte_len = fld_byte_len + 1;

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = getelementptr inbounds [", 27);
            let _ = call emit_u32(ctx, byte_len);
            let _ = call emit_str(ctx, " x i8], [", 9);
            let _ = call emit_u32(ctx, byte_len);
            let _ = call emit_str(ctx, " x i8]* @.str_", 14);
            let _ = call emit_u32(ctx, sym_id);
            let _ = call emit_str(ctx, ", i64 0, i64 0", 14);
            let _ = call emit_nl(ctx);

            _ => return res_var;
        }
    }
}

machine emit_ptr_cmp_op(ctx: *CodegenCtx, op: u32) -> u32 {
    flow {}
    states {
        Entry: {
            op == 46 => EmitEq;
            _        => EmitNe;
        }
        EmitEq: {
            let _ = call emit_str(ctx, "eq ptr ", 7);
            _ => return 0;
        }
        EmitNe: {
            let _ = call emit_str(ctx, "ne ptr ", 7);
            _ => return 0;
        }
    }
}

machine emit_ext_to_type(ctx: *CodegenCtx, src_t: *u8, target_t: *u8, val: *u8) -> *u8 {
    flow {
        reg op_p: *u8 = "zext";
    }
    states {
        Entry: {
            src_t == null => ReturnSame;
            let sl = call strlen(src_t);
            let tl = call strlen(target_t);
            let sm_p = call map_type_ptr(ctx, src_t, sl);
            let sm_l = call map_type_len(ctx, src_t, sl);
            let tm_p = call map_type_ptr(ctx, target_t, tl);
            let tm_l = call map_type_len(ctx, target_t, tl);
            let is_same = call str_eq(sm_p, sm_l, tm_p, tm_l);
            is_same != 0 => ReturnSame;

            let is_i8 = call str_eq(src_t, sl, "i8", 2);
            is_i8 != 0 => SetSext;
            let is_i16 = call str_eq(src_t, sl, "i16", 3);
            is_i16 != 0 => SetSext;
            let is_i32 = call str_eq(src_t, sl, "i32", 3);
            is_i32 != 0 => SetSext;
            _ => DoEmit;
        }
        ReturnSame: {
            _ => return val;
        }
        SetSext: {
            _ => DoEmit [ op_p <= "sext" ];
        }
        DoEmit: {
            let sl = call strlen(src_t);
            let tl = call strlen(target_t);
            let sm_p = call map_type_ptr(ctx, src_t, sl);
            let sm_l = call map_type_len(ctx, src_t, sl);
            let tm_p = call map_type_ptr(ctx, target_t, tl);
            let tm_l = call map_type_len(ctx, target_t, tl);

            let res_var = call fresh_tmp_str(ctx, "ext", 3);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = ", 3);
            let _ = call emit_str(ctx, op_p, 4);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, sm_p, sm_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, val, call strlen(val));
            let _ = call emit_str(ctx, " to ", 4);
            let _ = call emit_str(ctx, tm_p, tm_l);
            let _ = call emit_nl(ctx);
            _ => return res_var;
        }
    }
}

machine emit_ptr_gep(ctx: *CodegenCtx, left_val: *u8, left_type_p: *u8, right_val: *u8) -> *u8 {
    flow {}
    states {
        Entry: {
            let res_var = call fresh_tmp_str(ctx, "gep", 3);
            let elem_p = left_type_p + 1;
            let elem_l = call strlen(elem_p);
            let mapped_p = call map_type_ptr(ctx, elem_p, elem_l);
            let mapped_l = call map_type_len(ctx, elem_p, elem_l);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = getelementptr inbounds ", 26);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            let _ = call emit_str(ctx, "* ", 2);
            let _ = call emit_str(ctx, left_val, call strlen(left_val));
            let _ = call emit_str(ctx, ", i32 ", 6);
            let _ = call emit_str(ctx, right_val, call strlen(right_val));
            let _ = call emit_nl(ctx);

            _ => return res_var;
        }
    }
}

machine emit_ptr_diff(ctx: *CodegenCtx, left_val: *u8, left_type_p: *u8, right_val: *u8, right_type_p: *u8) -> *u8 {
    flow {}
    states {
        Entry: {
            let t1 = call fresh_tmp_str(ctx, "p2i", 3);
            let t2 = call fresh_tmp_str(ctx, "p2i", 3);
            let res_var = call fresh_tmp_str(ctx, "diff", 4);

            let l_len = call strlen(left_type_p);
            let lm_p = call map_type_ptr(ctx, left_type_p, l_len);
            let lm_l = call map_type_len(ctx, left_type_p, l_len);

            let r_len = call strlen(right_type_p);
            let rm_p = call map_type_ptr(ctx, right_type_p, r_len);
            let rm_l = call map_type_len(ctx, right_type_p, r_len);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, t1, call strlen(t1));
            let _ = call emit_str(ctx, " = ptrtoint ", 12);
            let _ = call emit_str(ctx, lm_p, lm_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, left_val, call strlen(left_val));
            let _ = call emit_str(ctx, " to i32", 7);
            let _ = call emit_nl(ctx);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, t2, call strlen(t2));
            let _ = call emit_str(ctx, " = ptrtoint ", 12);
            let _ = call emit_str(ctx, rm_p, rm_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, right_val, call strlen(right_val));
            let _ = call emit_str(ctx, " to i32", 7);
            let _ = call emit_nl(ctx);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = sub i32 ", 11);
            let _ = call emit_str(ctx, t1, call strlen(t1));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, t2, call strlen(t2));
            let _ = call emit_nl(ctx);

            _ => return res_var;
        }
    }
}

machine emit_ptr_cmp(ctx: *CodegenCtx, left_val: *u8, right_val: *u8, op: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            let res_var = call fresh_tmp_str(ctx, "pcmp", 4);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = icmp ", 8);
            let _ = call emit_ptr_cmp_op(ctx, op);
            let _ = call emit_operands(ctx, left_val, right_val);
            let _ = call emit_nl(ctx);
            _ => return res_var;
        }
    }
}

machine promote_bin_operand(ctx: *CodegenCtx, expr: *ExprNode, type_p: *u8, val: *u8, op_mode: u32) -> *u8 {
    flow {
        wire is_i1 = op_mode == 1;
        wire is_lit = expr.kind == 1; // INT_LIT
        wire skip = is_i1 || is_lit;
        wire is_64 = (op_mode == 2) || (op_mode == 3);
    }
    states {
        Entry: {
            skip  => ReturnDirect;
            is_64 => Promote64;
            _     => Promote32;
        }
        ReturnDirect: {
            _ => return val;
        }
        Promote64: {
            let res = call emit_ext_to_type(ctx, type_p, "i64", val);
            _ => return res;
        }
        Promote32: {
            let res = call emit_ext_to_type(ctx, type_p, "i32", val);
            _ => return res;
        }
    }
}

machine emit_q64_mul(ctx: *CodegenCtx, left_val: *u8, right_val: *u8) -> *u8 {
    flow {}
    states {
        Entry: {
            let sext_l = call fresh_tmp_str(ctx, "qmul_l", 6);
            let sext_r = call fresh_tmp_str(ctx, "qmul_r", 6);
            let mul128 = call fresh_tmp_str(ctx, "qmul128", 7);
            let shr128 = call fresh_tmp_str(ctx, "qmul_shr", 8);
            let res    = call fresh_tmp_str(ctx, "qmul_res", 8);

            // %sext_l = sext i64 %left_val to i128
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, sext_l, call strlen(sext_l));
            let _ = call emit_str(ctx, " = sext i64 ", 12);
            let _ = call emit_str(ctx, left_val, call strlen(left_val));
            let _ = call emit_str(ctx, " to i128", 8);
            let _ = call emit_nl(ctx);

            // %sext_r = sext i64 %right_val to i128
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, sext_r, call strlen(sext_r));
            let _ = call emit_str(ctx, " = sext i64 ", 12);
            let _ = call emit_str(ctx, right_val, call strlen(right_val));
            let _ = call emit_str(ctx, " to i128", 8);
            let _ = call emit_nl(ctx);

            // %mul128 = mul i128 %sext_l, %sext_r
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, mul128, call strlen(mul128));
            let _ = call emit_str(ctx, " = mul i128 ", 11);
            let _ = call emit_str(ctx, sext_l, call strlen(sext_l));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, sext_r, call strlen(sext_r));
            let _ = call emit_nl(ctx);

            // %shr128 = ashr i128 %mul128, 32
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, shr128, call strlen(shr128));
            let _ = call emit_str(ctx, " = ashr i128 ", 12);
            let _ = call emit_str(ctx, mul128, call strlen(mul128));
            let _ = call emit_str(ctx, ", 32", 4);
            let _ = call emit_nl(ctx);

            // %res = trunc i128 %shr128 to i64
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res, call strlen(res));
            let _ = call emit_str(ctx, " = trunc i128 ", 13);
            let _ = call emit_str(ctx, shr128, call strlen(shr128));
            let _ = call emit_str(ctx, " to i64", 7);
            let _ = call emit_nl(ctx);

            _ => return res;
        }
    }
}

machine emit_q64_div(ctx: *CodegenCtx, left_val: *u8, right_val: *u8) -> *u8 {
    flow {}
    states {
        Entry: {
            let sext_l = call fresh_tmp_str(ctx, "qdiv_l", 6);
            let shl128 = call fresh_tmp_str(ctx, "qdiv_shl", 8);
            let sext_r = call fresh_tmp_str(ctx, "qdiv_r", 6);
            let div128 = call fresh_tmp_str(ctx, "qdiv128", 7);
            let res    = call fresh_tmp_str(ctx, "qdiv_res", 8);

            // %sext_l = sext i64 %left_val to i128
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, sext_l, call strlen(sext_l));
            let _ = call emit_str(ctx, " = sext i64 ", 12);
            let _ = call emit_str(ctx, left_val, call strlen(left_val));
            let _ = call emit_str(ctx, " to i128", 8);
            let _ = call emit_nl(ctx);

            // %shl128 = shl i128 %sext_l, 32
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, shl128, call strlen(shl128));
            let _ = call emit_str(ctx, " = shl i128 ", 11);
            let _ = call emit_str(ctx, sext_l, call strlen(sext_l));
            let _ = call emit_str(ctx, ", 32", 4);
            let _ = call emit_nl(ctx);

            // %sext_r = sext i64 %right_val to i128
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, sext_r, call strlen(sext_r));
            let _ = call emit_str(ctx, " = sext i64 ", 12);
            let _ = call emit_str(ctx, right_val, call strlen(right_val));
            let _ = call emit_str(ctx, " to i128", 8);
            let _ = call emit_nl(ctx);

            // %div128 = sdiv i128 %shl128, %sext_r
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, div128, call strlen(div128));
            let _ = call emit_str(ctx, " = sdiv i128 ", 12);
            let _ = call emit_str(ctx, shl128, call strlen(shl128));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, sext_r, call strlen(sext_r));
            let _ = call emit_nl(ctx);

            // %res = trunc i128 %div128 to i64
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res, call strlen(res));
            let _ = call emit_str(ctx, " = trunc i128 ", 13);
            let _ = call emit_str(ctx, div128, call strlen(div128));
            let _ = call emit_str(ctx, " to i64", 7);
            let _ = call emit_nl(ctx);

            _ => return res;
        }
    }
}

machine emit_bin_expr(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg left_val:     *u8 = null;
        reg right_val:    *u8 = null;
        reg left_type_p:  *u8 = null;
        reg right_type_p: *u8 = null;
        reg plv_r:        *u8 = null;
        reg prv_r:        *u8 = null;
        reg op_mode_reg:  u32 = 0; // 0: i32, 1: i1, 2: i64, 3: u64, 4: u32
        reg is_case:      u32 = 0; // 1: gep, 2: diff, 3: cmp, 4: normal

        wire left_e = expr.left;
        wire right_e = expr.right;
        wire op = expr.op;
    }
    states {
        Entry: {
            let lt = call get_expr_type(ctx, left_e);
            let is_ptr_add = call is_pointer_add(lt, op);
            is_ptr_add != 0 => EvalArgs [ is_case <= 1, left_type_p <= lt ];

            let rt = call get_expr_type(ctx, right_e);
            let is_ptr_diff = call is_pointer_diff(lt, rt, op);
            is_ptr_diff != 0 => EvalArgs [ is_case <= 2, left_type_p <= lt, right_type_p <= rt ];

            let is_ptr_cmp = call is_pointer_cmp(lt, rt, op);
            is_ptr_cmp != 0 => EvalArgs [ is_case <= 3 ];

            let is_i1_l = call is_i1_type(lt);
            let is_i1_r = call is_i1_type(rt);
            let is_i1_op = is_i1_l | is_i1_r;
            is_i1_op != 0 => EvalArgs [ is_case <= 4, op_mode_reg <= 1, left_type_p <= lt, right_type_p <= rt ];

            let is_i64_l = call is_type_64(lt);
            let is_i64_r = call is_type_64(rt);
            let is_i64_op = is_i64_l | is_i64_r;

            let is_u_l = call is_unsigned_type(lt);
            let is_u_r = call is_unsigned_type(rt);
            let is_u_op = is_u_l | is_u_r;

            let is_both = is_i64_op & is_u_op;
            is_both != 0   => EvalArgs [ is_case <= 4, op_mode_reg <= 3, left_type_p <= lt, right_type_p <= rt ];
            is_i64_op != 0 => EvalArgs [ is_case <= 4, op_mode_reg <= 2, left_type_p <= lt, right_type_p <= rt ];
            is_u_op != 0   => EvalArgs [ is_case <= 4, op_mode_reg <= 4, left_type_p <= lt, right_type_p <= rt ];
            _              => EvalArgs [ is_case <= 4, op_mode_reg <= 0, left_type_p <= lt, right_type_p <= rt ];
        }
        EvalArgs: {
            let lv = call emit_expr(ctx, left_e);
            let rv = call emit_expr(ctx, right_e);
            is_case == 1 => EmitGep     [ left_val <= lv, right_val <= rv ];
            is_case == 2 => EmitPtrDiff [ left_val <= lv, right_val <= rv ];
            is_case == 3 => EmitPtrCmp  [ left_val <= lv, right_val <= rv ];
            _            => EmitNormal  [ left_val <= lv, right_val <= rv ];
        }
        EmitGep: {
            let res = call emit_ptr_gep(ctx, left_val, left_type_p, right_val);
            _ => return res;
        }
        EmitPtrDiff: {
            let res = call emit_ptr_diff(ctx, left_val, left_type_p, right_val, right_type_p);
            _ => return res;
        }
        EmitPtrCmp: {
            let res = call emit_ptr_cmp(ctx, left_val, right_val, op);
            _ => return res;
        }
        EmitNormal: {
            let plv = call promote_bin_operand(ctx, left_e, left_type_p, left_val, op_mode_reg);
            let prv = call promote_bin_operand(ctx, right_e, right_type_p, right_val, op_mode_reg);

            let is_ql = call is_type_q64(left_type_p);
            let is_qr = call is_type_q64(right_type_p);
            let is_q = is_ql | is_qr;
            is_q != 0 => CheckQ64Op [ plv_r <= plv, prv_r <= prv ];
            _         => EmitStandard [ plv_r <= plv, prv_r <= prv ];
        }
        CheckQ64Op: {
            op == 70 => EmitQ64Mul; // *
            op == 73 => EmitQ64Div; // /
            _        => EmitStandard;
        }
        EmitQ64Mul: {
            let res = call emit_q64_mul(ctx, plv_r, prv_r);
            _ => return res;
        }
        EmitQ64Div: {
            let res = call emit_q64_div(ctx, plv_r, prv_r);
            _ => return res;
        }
        EmitStandard: {
            let res_var = call fresh_tmp_str(ctx, "t", 1);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = ", 3);

            let _ = call emit_bin_op_instruction(ctx, op, op_mode_reg, plv_r, prv_r);
            let _ = call emit_nl(ctx);

            _ => return res_var;
        }
    }
}

machine emit_bin_op_instruction(ctx: *CodegenCtx, op: u32, op_mode: u32, left_val: *u8, right_val: *u8) -> u32 {
    flow {
        reg op_p: *u8 = "add ";
        reg op_l: u32 = 4;

        wire is_u    = (op_mode == 3) || (op_mode == 4);
        wire is_udiv = is_u && (op == 73);
        wire is_ult  = is_u && (op == 60);
        wire is_ule  = is_u && (op == 44);
        wire is_ugt  = is_u && (op == 61);
        wire is_uge  = is_u && (op == 48);
    }
    states {
        Entry: {
            is_udiv  => Emit [ op_p <= "udiv ",     op_l <= 5 ];
            is_ult   => Emit [ op_p <= "icmp ult ", op_l <= 9 ];
            is_ule   => Emit [ op_p <= "icmp ule ", op_l <= 9 ];
            is_ugt   => Emit [ op_p <= "icmp ugt ", op_l <= 9 ];
            is_uge   => Emit [ op_p <= "icmp uge ", op_l <= 9 ];
            op == 73 => Emit [ op_p <= "sdiv ",     op_l <= 5 ];
            op == 60 => Emit [ op_p <= "icmp slt ", op_l <= 9 ];
            op == 44 => Emit [ op_p <= "icmp sle ", op_l <= 9 ];
            op == 61 => Emit [ op_p <= "icmp sgt ", op_l <= 9 ];
            op == 48 => Emit [ op_p <= "icmp sge ", op_l <= 9 ];
            op == 71 => Emit;
            op == 72 => Emit [ op_p <= "sub ",      op_l <= 4 ];
            op == 70 => Emit [ op_p <= "mul ",      op_l <= 4 ];
            op == 62 => Emit [ op_p <= "and ",      op_l <= 4 ];
            op == 63 => Emit [ op_p <= "or ",       op_l <= 3 ];
            op == 64 => Emit [ op_p <= "xor ",      op_l <= 4 ];
            op == 40 => Emit [ op_p <= "shl ",      op_l <= 4 ];
            op == 41 => Emit [ op_p <= "lshr ",     op_l <= 5 ];
            op == 50 => Emit [ op_p <= "and ",      op_l <= 4 ];
            op == 49 => Emit [ op_p <= "or ",       op_l <= 3 ];
            op == 46 => Emit [ op_p <= "icmp eq ",  op_l <= 8 ];
            op == 47 => Emit [ op_p <= "icmp ne ",  op_l <= 8 ];
            _        => Emit;
        }
        Emit: {
            let _ = call emit_str(ctx, op_p, op_l);
            let _ = call emit_bin_op_type(ctx, op, op_mode);
            let _ = call emit_operands(ctx, left_val, right_val);
            _ => return 0;
        }
    }
}

machine emit_bin_op_type(ctx: *CodegenCtx, op: u32, op_mode: u32) -> u32 {
    flow {
        reg type_p: *u8 = "i32 ";
        reg type_l: u32 = 4;

        wire is_64        = (op_mode == 2) || (op_mode == 3);
        wire is_i1        = op_mode == 1;
        wire is_log       = (op == 50) || (op == 49);
        wire not_64       = is_64 == 0;
        wire is_i1_target = is_i1 || (is_log && not_64);
    }
    states {
        Entry: {
            is_i1_target => Emit [ type_p <= "i1 ",  type_l <= 3 ];
            is_64        => Emit [ type_p <= "i64 ", type_l <= 4 ];
            _            => Emit;
        }
        Emit: {
            let _ = call emit_str(ctx, type_p, type_l);
            _ => return 0;
        }
    }
}

machine emit_operands(ctx: *CodegenCtx, left: *u8, right: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call emit_str(ctx, left, call strlen(left));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, right, call strlen(right));
            _ => return 0;
        }
    }
}

machine emit_deref_expr(ctx: *CodegenCtx, sub_e: *ExprNode) -> *u8 {
    flow {
        reg mapped_type_p: *u8 = "i32";
        reg mapped_type_l: u32 = 3;
        reg deref_val:     *u8 = null;
    }
    states {
        Entry: {
            let ptr_val = call emit_expr(ctx, sub_e);
            let ptr_t = call get_expr_type(ctx, sub_e);
            let c0_is_ptr = *ptr_t;
            let is_ptr = c0_is_ptr == 42;
            is_ptr != 0 => ResolveElemType [ deref_val <= ptr_val, mapped_type_p <= ptr_t + 1 ];
            _           => DoLoad          [ deref_val <= ptr_val ];
        }
        ResolveElemType: {
            let elem_l = call strlen(mapped_type_p);
            let mapped_p = call map_type_ptr(ctx, mapped_type_p, elem_l);
            let mapped_l = call map_type_len(ctx, mapped_type_p, elem_l);
            _ => DoLoad [ mapped_type_p <= mapped_p, mapped_type_l <= mapped_l ];
        }
        DoLoad: {
            let res_var = call fresh_tmp_str(ctx, "load", 4);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = load ", 8);
            let _ = call emit_str(ctx, mapped_type_p, mapped_type_l);
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, mapped_type_p, mapped_type_l);
            let _ = call emit_str(ctx, "* ", 2);
            let _ = call emit_str(ctx, deref_val, call strlen(deref_val));
            let _ = call emit_nl(ctx);
            _ => return res_var;
        }
    }
}

machine emit_addr_expr(ctx: *CodegenCtx, sub_e: *ExprNode) -> *u8 {
    flow {
        reg m_target: *MachineDef = null;
    }
    states {
        Entry: {
            let sk = sub_e.kind;
            sk == 7 => EmitFieldAddr; // sub_e is FieldExpr (&obj.field)

            // 関数ポインタ (&func) または 変数/構造体のアドレス (&env)
            let sub_name_p = sub_e.str_ptr;
            let sub_name_l = sub_e.str_len;

            // マシン関数ポインタか？
            let prog = ctx.prog;
            let target_m = call find_machine_in_prog(prog, sub_name_p, sub_name_l);
            target_m != null => EmitFuncPtr [ m_target <= target_m ];
            _                => EmitVarAddr;
        }
        EmitFieldAddr: {
            let fp = call emit_field_ptr(ctx, sub_e);
            _ => return fp;
        }
        EmitFuncPtr: {
            let res_var = call fresh_tmp_str(ctx, "fn_ptr", 6);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = bitcast i32 (", 16);
            let _ = call emit_machine_param_types(ctx, m_target);
            let _ = call emit_str(ctx, ")* @", 4);
            let _ = call emit_str(ctx, m_target.name_ptr, m_target.name_len);
            let _ = call emit_str(ctx, " to i8*", 7);
            let _ = call emit_nl(ctx);
            _ => return res_var;
        }
        EmitVarAddr: {
            // 変数/ワイヤーのアドレス: alloca + store + bitcast
            let val = call emit_expr(ctx, sub_e);
            let alloc_res = call fresh_tmp_str(ctx, "alloca", 6);
            let cast_res = call fresh_tmp_str(ctx, "cast", 4);

            let struct_type = call resolve_var_struct_type(ctx, sub_e);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, alloc_res, call strlen(alloc_res));
            let _ = call emit_str(ctx, " = alloca ", 10);
            let _ = call emit_str(ctx, struct_type, call strlen(struct_type));
            let _ = call emit_str(ctx, ", align 8", 9);
            let _ = call emit_nl(ctx);

            let _ = call emit_str(ctx, "  store ", 8);
            let _ = call emit_str(ctx, struct_type, call strlen(struct_type));
            let _ = call emit_char(ctx, 32); // ' '
            let _ = call emit_str(ctx, val, call strlen(val));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, struct_type, call strlen(struct_type));
            let _ = call emit_str(ctx, "* ", 2);
            let _ = call emit_str(ctx, alloc_res, call strlen(alloc_res));
            let _ = call emit_nl(ctx);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, cast_res, call strlen(cast_res));
            let _ = call emit_str(ctx, " = bitcast ", 11);
            let _ = call emit_str(ctx, struct_type, call strlen(struct_type));
            let _ = call emit_str(ctx, "* ", 2);
            let _ = call emit_str(ctx, alloc_res, call strlen(alloc_res));
            let _ = call emit_str(ctx, " to i8*", 7);
            let _ = call emit_nl(ctx);

            _ => return cast_res;
        }
    }
}

machine emit_un_expr(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        wire op = expr.op;
        wire sub_e = expr.left;
    }
    states {
        Entry: {
            op == 70 => EmitDeref; // '*' (token 70)
            op == 62 => EmitAddr;  // '&' (token 62)
            _        => ReturnSub;
        }
        EmitDeref: {
            let res = call emit_deref_expr(ctx, sub_e);
            _ => return res;
        }
        EmitAddr: {
            let res = call emit_addr_expr(ctx, sub_e);
            _ => return res;
        }
        ReturnSub: {
            let res = call emit_expr(ctx, sub_e);
            _ => return res;
        }
    }
}

machine emit_struct_lit(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        wire struct_name_p = expr.str_ptr;
        wire struct_name_l = expr.str_len;
    }
    states {
        Entry: {
            let res = call emit_struct_lit_inserts(ctx, expr, struct_name_p, struct_name_l);
            _ => return res;
        }
    }
}

machine emit_struct_lit_inserts(ctx: *CodegenCtx, expr: *ExprNode, struct_name_p: *u8, struct_name_l: u32) -> *u8 {
    flow {
        reg i: u32 = 0;
        reg curr_val: *u8 = "undef";
        reg cur_f: *ExprNode = null;
        wire has_more = cur_f != null;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0, curr_val <= "undef", cur_f <= expr.args ];
        }
        Loop: {
            has_more != 0 => EmitInsert;
            _             => Exit;
        }
        EmitInsert: {
            let fval = call emit_expr(ctx, cur_f.left);
            let next_val = call fresh_tmp_str(ctx, "ins", 3);

            let raw_ftype = call get_struct_field_type_by_idx(ctx.prog, ctx.alloc, struct_name_p, struct_name_l, i);
            let raw_flen = call strlen(raw_ftype);
            let mapped_p = call map_type_ptr(ctx, raw_ftype, raw_flen);
            let mapped_l = call map_type_len(ctx, raw_ftype, raw_flen);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, next_val, call strlen(next_val));
            let _ = call emit_str(ctx, " = insertvalue %struct.", 23);
            let _ = call emit_str(ctx, struct_name_p, struct_name_l);
            let _ = call emit_char(ctx, 32); // ' '
            let _ = call emit_str(ctx, curr_val, call strlen(curr_val));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            let _ = call emit_char(ctx, 32); // ' '
            let _ = call emit_str(ctx, fval, call strlen(fval));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_u32(ctx, i);
            let _ = call emit_nl(ctx);

            _ => Loop [ i <= i + 1, curr_val <= next_val, cur_f <= cur_f.next_arg ];
        }
        Exit: {
            _ => return curr_val;
        }
    }
}

machine emit_field_ptr(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg sname:    *u8 = null;
        reg sname_l:  u32 = 0;
        reg base_val: *u8 = null;
        wire base_e = expr.left;
        wire fld_p = expr.str_ptr;
        wire fld_l = expr.str_len;
    }
    states {
        Entry: {
            let bk = base_e.kind;
            bk == 7 => FromFieldExpr;
            _       => FromOtherExpr;
        }
        FromFieldExpr: {
            let bp = call emit_field_ptr(ctx, base_e);
            let bt = call get_expr_type(ctx, base_e);
            let c0 = *bt;
            c0 == 42 => FromPtr [ sname <= bt + 1, sname_l <= call strlen(bt + 1), base_val <= bp ];
            _        => FromPtr [ sname <= bt,     sname_l <= call strlen(bt),     base_val <= bp ];
        }
        FromOtherExpr: {
            let bv = call emit_expr(ctx, base_e);
            let bt = call get_expr_type(ctx, base_e);
            let c0 = *bt;
            c0 == 42 => FromPtr [ sname <= bt + 1, sname_l <= call strlen(bt + 1), base_val <= bv ];
            _        => FromPtr [ sname <= bt,     sname_l <= call strlen(bt),     base_val <= bv ];
        }
        FromPtr: {
            let fld_idx = call get_struct_field_idx(ctx.prog, sname, sname_l, fld_p, fld_l);
            let gep_val = call fresh_tmp_str(ctx, "fld_ptr", 7);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, gep_val, call strlen(gep_val));
            let _ = call emit_str(ctx, " = getelementptr inbounds %struct.", 34);
            let _ = call emit_str(ctx, sname, sname_l);
            let _ = call emit_str(ctx, ", %struct.", 10);
            let _ = call emit_str(ctx, sname, sname_l);
            let _ = call emit_str(ctx, "* ", 2);
            let _ = call emit_str(ctx, base_val, call strlen(base_val));
            let _ = call emit_str(ctx, ", i32 0, i32 ", 13);
            let _ = call emit_u32(ctx, fld_idx);
            let _ = call emit_nl(ctx);

            _ => return gep_val;
        }
    }
}

machine emit_field_expr(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg sname:       *u8 = null;
        reg sname_l:     u32 = 0;
        reg gep_val_reg: *u8 = null;
        wire base_e = expr.left;
        wire fld_p = expr.str_ptr;
        wire fld_l = expr.str_len;
    }
    states {
        Entry: {
            let gep_val = call emit_field_ptr(ctx, expr);
            let bt = call get_expr_type(ctx, base_e);
            let c0 = *bt;
            c0 == 42 => LoadFromPtr [ sname <= bt + 1, sname_l <= call strlen(bt + 1), gep_val_reg <= gep_val ];
            _        => LoadFromPtr [ sname <= bt,     sname_l <= call strlen(bt),     gep_val_reg <= gep_val ];
        }
        LoadFromPtr: {
            let raw_ftype = call find_struct_field_type(ctx.prog, ctx.alloc, sname, fld_p, fld_l);
            let raw_flen = call strlen(raw_ftype);
            let mapped_p = call map_type_ptr(ctx, raw_ftype, raw_flen);
            let mapped_l = call map_type_len(ctx, raw_ftype, raw_flen);

            let load_val = call fresh_tmp_str(ctx, "fld_val", 7);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, load_val, call strlen(load_val));
            let _ = call emit_str(ctx, " = load ", 8);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            let _ = call emit_str(ctx, "* ", 2);
            let _ = call emit_str(ctx, gep_val_reg, call strlen(gep_val_reg));
            let _ = call emit_nl(ctx);

            _ => return load_val;
        }
    }
}

machine emit_bridge_q64_to_f64(ctx: *CodegenCtx, q_val: *u8) -> *u8 {
    flow {}
    states {
        Entry: {
            let raw_fp = call fresh_tmp_str(ctx, "fp_raw", 6);
            let fdiv_res = call fresh_tmp_str(ctx, "fp_arg", 6);

            // %raw_fp = sitofp i64 %q_val to double
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, raw_fp, call strlen(raw_fp));
            let _ = call emit_str(ctx, " = sitofp i64 ", 14);
            let _ = call emit_str(ctx, q_val, call strlen(q_val));
            let _ = call emit_str(ctx, " to double", 10);
            let _ = call emit_nl(ctx);

            // %fdiv_res = fdiv double %raw_fp, 4294967296.0
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, fdiv_res, call strlen(fdiv_res));
            let _ = call emit_str(ctx, " = fdiv double ", 15);
            let _ = call emit_str(ctx, raw_fp, call strlen(raw_fp));
            let _ = call emit_str(ctx, ", 4294967296.0", 14);
            let _ = call emit_nl(ctx);

            _ => return fdiv_res;
        }
    }
}

machine emit_bridge_q64_to_f32(ctx: *CodegenCtx, q_val: *u8) -> *u8 {
    flow {}
    states {
        Entry: {
            let raw_fp = call fresh_tmp_str(ctx, "fp_raw32", 8);
            let fdiv_res = call fresh_tmp_str(ctx, "fp_arg32", 8);

            // %raw_fp = sitofp i64 %q_val to float
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, raw_fp, call strlen(raw_fp));
            let _ = call emit_str(ctx, " = sitofp i64 ", 14);
            let _ = call emit_str(ctx, q_val, call strlen(q_val));
            let _ = call emit_str(ctx, " to float", 9);
            let _ = call emit_nl(ctx);

            // %fdiv_res = fdiv float %raw_fp, 4294967296.0
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, fdiv_res, call strlen(fdiv_res));
            let _ = call emit_str(ctx, " = fdiv float ", 14);
            let _ = call emit_str(ctx, raw_fp, call strlen(raw_fp));
            let _ = call emit_str(ctx, ", 4294967296.0", 14);
            let _ = call emit_nl(ctx);

            _ => return fdiv_res;
        }
    }
}

machine emit_bridge_ret_to_q64(ctx: *CodegenCtx, ret_val: *u8, is_double: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            is_double != 0 => BridgeDouble;
            _              => BridgeFloat;
        }
        BridgeDouble: {
            let mul_res = call fresh_tmp_str(ctx, "fp_mul", 6);
            let q_res   = call fresh_tmp_str(ctx, "fp2q", 4);

            // %mul_res = fmul double %ret_val, 4294967296.0
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, mul_res, call strlen(mul_res));
            let _ = call emit_str(ctx, " = fmul double ", 15);
            let _ = call emit_str(ctx, ret_val, call strlen(ret_val));
            let _ = call emit_str(ctx, ", 4294967296.0", 14);
            let _ = call emit_nl(ctx);

            // %q_res = fptosi double %mul_res to i64
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, q_res, call strlen(q_res));
            let _ = call emit_str(ctx, " = fptosi double ", 17);
            let _ = call emit_str(ctx, mul_res, call strlen(mul_res));
            let _ = call emit_str(ctx, " to i64", 7);
            let _ = call emit_nl(ctx);

            _ => return q_res;
        }
        BridgeFloat: {
            let mul_res = call fresh_tmp_str(ctx, "fp_mul", 6);
            let q_res   = call fresh_tmp_str(ctx, "fp2q", 4);

            // %mul_res = fmul float %ret_val, 4294967296.0
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, mul_res, call strlen(mul_res));
            let _ = call emit_str(ctx, " = fmul float ", 14);
            let _ = call emit_str(ctx, ret_val, call strlen(ret_val));
            let _ = call emit_str(ctx, ", 4294967296.0", 14);
            let _ = call emit_nl(ctx);

            // %q_res = fptosi float %mul_res to i64
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, q_res, call strlen(q_res));
            let _ = call emit_str(ctx, " = fptosi float ", 16);
            let _ = call emit_str(ctx, mul_res, call strlen(mul_res));
            let _ = call emit_str(ctx, " to i64", 7);
            let _ = call emit_nl(ctx);

            _ => return q_res;
        }
    }
}

machine emit_call_expr(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg target_params:    *MachineParam = null;
        reg target_param_cnt: u32 = 0;
        reg target_ret_p:     *u8 = null;
        reg target_ret_l:     u32 = 0;
        reg slots:            *ArgValSlot = null;
        reg call_res:         *u8 = null;

        wire func_p = expr.str_ptr;
        wire func_l = expr.str_len;
        wire prog = ctx.prog;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            // 外部関数か？
            let ext = call find_extern_in_prog(prog, func_p, func_l);
            ext != null => EvalArgs [ target_params <= ext.params, target_param_cnt <= ext.param_count, target_ret_p <= ext.ret_type_ptr, target_ret_l <= ext.ret_type_len ];
            _           => SearchMachine;
        }
        SearchMachine: {
            // 内部マシンか？
            let mach = call find_machine_in_prog(prog, func_p, func_l);
            mach != null => EvalArgs [ target_params <= mach.params, target_param_cnt <= mach.param_count, target_ret_p <= mach.ret_type_ptr, target_ret_l <= mach.ret_type_len ];
            _            => UnresolvedSymbol;
        }
        UnresolvedSymbol: {
            // 未解決シンボルフォールバック
            _ => return "0";
        }
        EvalArgs: {
            // 引数式を先行評価し、SSA ID を一時スロットに保存 (引数数に基づき正確に事前計算)
            let cnt = expr.arg_count;
            let mul8 = cnt * 8;
            let slots_bytes = mul8 + 16;
            let slots_mem = call bump_alloc(alloc, slots_bytes, 8);
            let _ = call eval_call_args(ctx, func_p, func_l, expr.args, target_params, target_param_cnt, slots_mem);

            let ret_p = call map_type_ptr(ctx, target_ret_p, target_ret_l);
            let ret_l = call map_type_len(ctx, target_ret_p, target_ret_l);

            let is_void = call str_eq(ret_p, ret_l, "void", 4);
            is_void != 0 => EmitVoidCall  [ slots <= slots_mem ];
            _            => EmitValueCall [ slots <= slots_mem ];
        }
        EmitVoidCall: {
            let _ = call emit_str(ctx, "  call void @", 13);
            let _ = call emit_str(ctx, func_p, func_l);
            let _ = call emit_char(ctx, 40); // '('
            let _ = call emit_assembled_args(ctx, target_params, target_param_cnt, slots, expr.arg_count);
            let _ = call emit_char(ctx, 41); // ')'
            let _ = call emit_nl(ctx);
            _ => return "void";
        }
        EmitValueCall: {
            let res_var = call fresh_tmp_str(ctx, "t", 1);
            let ret_p = call map_type_ptr(ctx, target_ret_p, target_ret_l);
            let ret_l = call map_type_len(ctx, target_ret_p, target_ret_l);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = call ", 8);
            let _ = call emit_str(ctx, ret_p, ret_l);
            let _ = call emit_str(ctx, " @", 2);
            let _ = call emit_str(ctx, func_p, func_l);
            let _ = call emit_char(ctx, 40); // '('
            let _ = call emit_assembled_args(ctx, target_params, target_param_cnt, slots, expr.arg_count);
            let _ = call emit_char(ctx, 41); // ')'
            let _ = call emit_nl(ctx);

            let is_ret_f64 = call str_eq(target_ret_p, target_ret_l, "f64", 3);
            is_ret_f64 != 0 => BridgeRetDouble [ call_res <= res_var ];
            let is_ret_dbl = call str_eq(target_ret_p, target_ret_l, "double", 6);
            is_ret_dbl != 0 => BridgeRetDouble [ call_res <= res_var ];

            let is_ret_f32 = call str_eq(target_ret_p, target_ret_l, "f32", 3);
            is_ret_f32 != 0 => BridgeRetFloat [ call_res <= res_var ];
            let is_ret_flt = call str_eq(target_ret_p, target_ret_l, "float", 5);
            is_ret_flt != 0 => BridgeRetFloat [ call_res <= res_var ];

            _ => return res_var;
        }
        BridgeRetDouble: {
            let q_res = call emit_bridge_ret_to_q64(ctx, call_res, 1);
            _ => return q_res;
        }
        BridgeRetFloat: {
            let q_res = call emit_bridge_ret_to_q64(ctx, call_res, 0);
            _ => return q_res;
        }
    }
}

machine find_extern_in_prog(prog: *ProgramDef, name_p: *u8, name_l: u32) -> *ExternFn {
    flow {
        reg i: u32 = 0;
        wire cnt = prog.extern_count;
        wire has_more = i < cnt;
        wire fld_ext = prog.externs;
        wire ext = fld_ext + i;
        wire is_match = call str_eq(ext.name_ptr, ext.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return ext;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine eval_call_args(ctx: *CodegenCtx, fn_p: *u8, fn_l: u32, first_arg: *ExprNode, params: *MachineParam, param_cnt: u32, slots: *ArgValSlot) -> u32 {
    flow {
        reg i:       u32 = 0;
        reg cur:     *ExprNode = null;
        reg cur_val: *u8 = null;
        reg cur_t:   *u8 = null;
        wire has_more = cur != null;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0, cur <= first_arg ];
        }
        Loop: {
            has_more != 0 => Step;
            _             => Exit;
        }
        Step: {
            let val = call emit_expr(ctx, cur);
            let ct = call get_expr_type(ctx, cur);
            let ctl = call strlen(ct);
            let exp_p = call get_param_type_ptr(ctx, params, param_cnt, i);
            let exp_l = call get_param_type_len(ctx, params, param_cnt, i);

            let ok = call validate_type(ctx, 1, fn_p, fn_l, i + 1, exp_p, exp_l, ct, ctl, cur);

            let is_q = call is_type_q64(ct);
            is_q != 0 => CheckBridgeArg [ cur_val <= val, cur_t <= ct ];

            let is_exp_i32 = call str_eq(exp_p, exp_l, "i32", 3);
            is_exp_i32 != 0 => CheckExtI32 [ cur_val <= val, cur_t <= ct ];
            let is_exp_i64 = call str_eq(exp_p, exp_l, "i64", 3);
            is_exp_i64 != 0 => CheckExtI64 [ cur_val <= val, cur_t <= ct ];
            _ => SaveArg [ cur_val <= val ];
        }
        CheckBridgeArg: {
            let exp_p = call get_param_type_ptr(ctx, params, param_cnt, i);
            let exp_l = call get_param_type_len(ctx, params, param_cnt, i);

            let is_f64 = call str_eq(exp_p, exp_l, "f64", 3);
            is_f64 != 0 => BridgeF64;
            let is_dbl = call str_eq(exp_p, exp_l, "double", 6);
            is_dbl != 0 => BridgeF64;

            let is_f32 = call str_eq(exp_p, exp_l, "f32", 3);
            is_f32 != 0 => BridgeF32;
            let is_flt = call str_eq(exp_p, exp_l, "float", 5);
            is_flt != 0 => BridgeF32;

            _ => SaveArg;
        }
        BridgeF64: {
            let bv = call emit_bridge_q64_to_f64(ctx, cur_val);
            _ => SaveArg [ cur_val <= bv ];
        }
        BridgeF32: {
            let bv = call emit_bridge_q64_to_f32(ctx, cur_val);
            _ => SaveArg [ cur_val <= bv ];
        }
        CheckExtI32: {
            let is_sm = call is_type_small(cur_t);
            is_sm != 0 => ExtArgI32;
            _          => SaveArg;
        }
        ExtArgI32: {
            let ext_v = call emit_ext_to_type(ctx, cur_t, "i32", cur_val);
            _ => SaveArg [ cur_val <= ext_v ];
        }
        CheckExtI64: {
            cur_t == null => ExtArg64;
            let c0 = *cur_t;
            c0 == 42    => SaveArg;
            let is_i64 = call is_type_64(cur_t);
            is_i64 != 0 => SaveArg;
            _           => ExtArg64;
        }
        ExtArg64: {
            let ext_v = call emit_ext_to_type(ctx, cur_t, "i64", cur_val);
            _ => SaveArg [ cur_val <= ext_v ];
        }
        SaveArg: {
            let slot = slots + i;
            slot.val_ptr <- cur_val;
            _ => Loop [ i <= i + 1, cur <= cur.next_arg ];
        }
        Exit: {
            _ => return i;
        }
    }
}

machine emit_assembled_args(ctx: *CodegenCtx, params: *MachineParam, param_cnt: u32, slots: *ArgValSlot, count: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire has_more = i < count;
        wire is_first = i == 0;
        wire slot = slots + i;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitOne;
            _             => Exit;
        }
        EmitOne: {
            is_first == 0 => EmitComma;
            _             => EmitVal;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitVal;
        }
        EmitVal: {
            let param_type_p = call get_param_type_ptr(ctx, params, param_cnt, i);
            let param_type_l = call get_param_type_len(ctx, params, param_cnt, i);

            let _ = call emit_str(ctx, param_type_p, param_type_l);
            let _ = call emit_char(ctx, 32); // ' '
            let _ = call emit_str(ctx, slot.val_ptr, call strlen(slot.val_ptr));

            _ => Loop [ i <= i + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine get_param_type_ptr(ctx: *CodegenCtx, params: *MachineParam, param_cnt: u32, idx: u32) -> *u8 {
    flow {
        wire ok = idx < param_cnt;
        wire p = params + idx;
    }
    states {
        Entry: {
            ok == 0 => DefaultType;
            _       => MapParam;
        }
        MapParam: {
            let mapped_p = call map_type_ptr(ctx, p.type_ptr, p.type_len);
            _ => return mapped_p;
        }
        DefaultType: {
            _ => return "i32";
        }
    }
}

machine get_param_type_len(ctx: *CodegenCtx, params: *MachineParam, param_cnt: u32, idx: u32) -> u32 {
    flow {
        wire ok = idx < param_cnt;
        wire p = params + idx;
    }
    states {
        Entry: {
            ok == 0 => DefaultType;
            _       => MapParam;
        }
        MapParam: {
            let mapped_l = call map_type_len(ctx, p.type_ptr, p.type_len);
            _ => return mapped_l;
        }
        DefaultType: {
            _ => return 3;
        }
    }
}

machine coerce_store_val(ctx: *CodegenCtx, val_str: *u8, val_llvm_p: *u8, val_llvm_l: u32, dst_type_p: *u8, dst_type_l: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            let is_null = call str_eq(val_str, call strlen(val_str), "null", 4);
            is_null != 0 => ReturnDirect;
            let is_same = call str_eq(dst_type_p, dst_type_l, val_llvm_p, val_llvm_l);
            is_same != 0 => ReturnDirect;
            let is_i8 = call str_eq(dst_type_p, dst_type_l, "i8", 2);
            is_i8 != 0   => DoTrunc;
            let is_i16 = call str_eq(dst_type_p, dst_type_l, "i16", 3);
            is_i16 != 0  => DoTrunc;

            // ポインタ同士の型不一致か？
            let dst_last_ptr = dst_type_p + (dst_type_l - 1);
            let dst_last = *dst_last_ptr;
            let val_last_ptr = val_llvm_p + (val_llvm_l - 1);
            let val_last = *val_last_ptr;
            let both_ptr = (dst_last == 42) && (val_last == 42);
            both_ptr => DoBitcast;
            _        => ReturnDirect;
        }
        ReturnDirect: {
            _ => return val_str;
        }
        DoTrunc: {
            let tr_val = call fresh_tmp_str(ctx, "trunc", 5);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, tr_val, call strlen(tr_val));
            let _ = call emit_str(ctx, " = trunc ", 9);
            let _ = call emit_str(ctx, val_llvm_p, val_llvm_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, val_str, call strlen(val_str));
            let _ = call emit_str(ctx, " to ", 4);
            let _ = call emit_str(ctx, dst_type_p, dst_type_l);
            let _ = call emit_nl(ctx);
            _ => return tr_val;
        }
        DoBitcast: {
            let bc_val = call fresh_tmp_str(ctx, "bitcast", 7);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, bc_val, call strlen(bc_val));
            let _ = call emit_str(ctx, " = bitcast ", 11);
            let _ = call emit_str(ctx, val_llvm_p, val_llvm_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, val_str, call strlen(val_str));
            let _ = call emit_str(ctx, " to ", 4);
            let _ = call emit_str(ctx, dst_type_p, dst_type_l);
            let _ = call emit_nl(ctx);
            _ => return bc_val;
        }
    }
}

machine emit_store(ctx: *CodegenCtx, target: *ExprNode, expr: *ExprNode) -> u32 {
    flow {
        reg val_str:    *u8 = null;
        reg val_type:   *u8 = null;
        reg val_llvm_p: *u8 = null;
        reg val_llvm_l: u32 = 0;
        reg dst_ptr:    *u8 = null;
        reg dst_type_p: *u8 = null;
        reg dst_type_l: u32 = 0;

        reg sname:      *u8 = null;
    }
    states {
        Entry: {
            target == null => Exit;
            let v = call emit_expr(ctx, expr);
            let vt = call get_expr_type(ctx, expr);
            let vt_l = call strlen(vt);
            let v_lp = call map_type_ptr(ctx, vt, vt_l);
            let v_ll = call map_type_len(ctx, vt, vt_l);

            let tk = target.kind;
            tk == 7 => FieldStore [ val_str <= v, val_type <= vt, val_llvm_p <= v_lp, val_llvm_l <= v_ll ];
            tk == 6 => CheckUnary [ val_str <= v, val_type <= vt, val_llvm_p <= v_lp, val_llvm_l <= v_ll ];
            _       => Exit;
        }

        CheckUnary: {
            let op = target.op;
            op == 70 => UnaryStore; // '*' (TOK_STAR = 70)
            _        => Exit;
        }

        FieldStore: {
            let gep_val = call emit_field_ptr(ctx, target);
            let base_e = target.left;
            let bt = call get_expr_type(ctx, base_e);
            let c0 = *bt;
            c0 == 42 => ResolveFldType [ sname <= bt + 1, dst_ptr <= gep_val ];
            _        => ResolveFldType [ sname <= bt,     dst_ptr <= gep_val ];
        }

        ResolveFldType: {
            let raw_ftype = call find_struct_field_type(ctx.prog, ctx.alloc, sname, target.str_ptr, target.str_len);
            let raw_flen = call strlen(raw_ftype);
            let mapped_p = call map_type_ptr(ctx, raw_ftype, raw_flen);
            let mapped_l = call map_type_len(ctx, raw_ftype, raw_flen);
            _ => DoStoreCheck [ dst_type_p <= mapped_p, dst_type_l <= mapped_l ];
        }

        UnaryStore: {
            let ptr_e = target.left;
            let ptr_v = call emit_expr(ctx, ptr_e);
            let ptr_t = call get_expr_type(ctx, ptr_e);
            let elem_t = ptr_t + 1;
            let elem_l = call strlen(elem_t);
            let mapped_p = call map_type_ptr(ctx, elem_t, elem_l);
            let mapped_l = call map_type_len(ctx, elem_t, elem_l);

            _ => DoStoreCheck [ dst_ptr <= ptr_v, dst_type_p <= mapped_p, dst_type_l <= mapped_l ];
        }

        DoStoreCheck: {
            let vt_len = call strlen(val_type);
            let _ = call validate_type(ctx, 2, target.str_ptr, target.str_len, 0, dst_type_p, dst_type_l, val_type, vt_len, expr);
            let fv = call coerce_store_val(ctx, val_str, val_llvm_p, val_llvm_l, dst_type_p, dst_type_l);

            let _ = call emit_str(ctx, "  store ", 8);
            let _ = call emit_str(ctx, dst_type_p, dst_type_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, fv, call strlen(fv));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, dst_type_p, dst_type_l);
            let _ = call emit_str(ctx, "* ", 2);
            let _ = call emit_str(ctx, dst_ptr, call strlen(dst_ptr));
            let _ = call emit_nl(ctx);
            _ => Exit;
        }

        Exit: {
            _ => return 0;
        }
    }
}

// ============================================================================
// StateSSA Compiler: FSM Topology & Phi Junction Engine (emit_fsm.ssa)
// マシン・状態ノード・遷移エッジ・レジスタラッチ・Phi結合の調停
// ============================================================================




machine find_machine_in_prog(prog: *ProgramDef, name_p: *u8, name_l: u32) -> *MachineDef {
    flow {
        reg i: u32 = 0;
        wire cnt = prog.machine_count;
        wire has_more = i < cnt;
        wire fld_m = prog.machines;
        wire m = fld_m + i;
        wire is_match = call str_eq(m.name_ptr, m.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return m;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine emit_machine_param_types(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg i: u32 = 0;
        wire cnt = m.param_count;
        wire has_more = i < cnt;
        wire fld_p = m.params;
        wire p = fld_p + i;
        wire is_first = i == 0;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitOne;
            _             => Exit;
        }
        EmitOne: {
            is_first == 0 => EmitComma;
            _             => EmitType;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitType;
        }
        EmitType: {
            let mapped_p = call map_type_ptr(ctx, p.type_ptr, p.type_len);
            let mapped_l = call map_type_len(ctx, p.type_ptr, p.type_len);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            _ => Loop [ i <= i + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_machine(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        wire ret_p = call map_type_ptr(ctx, m.ret_type_ptr, m.ret_type_len);
        wire ret_l = call map_type_len(ctx, m.ret_type_ptr, m.ret_type_len);
    }
    states {
        Entry: {
            ctx.cur_machine <- m;
            ctx.cur_env_cnt <- 0;
            ctx.phi_cnt     <- 0;
            ctx.block_cnt   <- 0;

            // Pass 1: 各ブロックの命令蓄積 & Phi 収集
            let _ = call emit_entry_block(ctx, m);
            let _ = call emit_machine_states(ctx, m);

            // Pass 2: メイン出力バッファに並べ直して出力
            ctx.out_buf <- ctx.main_buf;
            ctx.out_pos <- ctx.main_pos;
            ctx.max_len <- ctx.main_cap;

            let _ = call emit_str(ctx, "define ", 7);
            let _ = call emit_str(ctx, ret_p, ret_l);
            let _ = call emit_str(ctx, " @", 2);
            let _ = call emit_str(ctx, m.name_ptr, m.name_len);
            let _ = call emit_char(ctx, 40); // '('
            let _ = call emit_machine_params(ctx, m);
            let _ = call emit_str(ctx, ") {", 3);
            let _ = call emit_nl(ctx);

            let _ = call assemble_machine_blocks(ctx, m);

            let _ = call emit_char(ctx, 125); // '}'
            let _ = call emit_nl(ctx);
            let _ = call emit_nl(ctx);
            ctx.main_pos <- ctx.out_pos;

            _ => return ctx.out_pos;
        }
    }
}

machine emit_machine_params(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg p_idx: u32 = 0;
        wire cnt = m.param_count;
        wire has_more = p_idx < cnt;
        wire fld_p = m.params;
        wire p = fld_p + p_idx;
        wire is_first = p_idx == 0;
    }
    states {
        Entry: {
            _ => Loop [ p_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitParam;
            _             => Exit;
        }
        EmitParam: {
            is_first == 0 => EmitComma;
            _             => EmitOne;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitOne;
        }
        EmitOne: {
            let mapped_p = call map_type_ptr(ctx, p.type_ptr, p.type_len);
            let mapped_l = call map_type_len(ctx, p.type_ptr, p.type_len);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            let _ = call emit_str(ctx, " %arg_", 6);
            let _ = call emit_str(ctx, p.name_ptr, p.name_len);
            _ => Loop [ p_idx <= p_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_entry_block(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg r_idx:   u32 = 0;
        reg raw_val: *u8 = null;
        reg raw_t:   *u8 = null;
        reg final_v: *u8 = null;
        wire cnt = m.reg_count;
        wire has_more = r_idx < cnt;
        wire fld_reg_def = m.regs;
        wire reg_def = fld_reg_def + r_idx;
        wire init_e = reg_def.init_expr;
    }
    states {
        Entry: {
            let entry_s = m.state_defs;
            let cap = call calc_bb_required_size(entry_s, m);
            let entry_bb = call add_basic_block(ctx, "entry", 5, 0, cap);
            let _ = call switch_to_bb(ctx, entry_bb);
            ctx.cur_env_cnt <- 0;
            _ => InitRegsLoop [ r_idx <= 0 ];
        }
        InitRegsLoop: {
            has_more != 0 => InitOneReg;
            _             => ProcessEntryActions;
        }
        InitOneReg: {
            init_e != null => HasInit;
            _              => NoInit;
        }
        HasInit: {
            let val = call emit_expr(ctx, init_e);
            let val_l = call strlen(val);
            let _ = call env_set(ctx, reg_def.name_ptr, reg_def.name_len, val, val_l);
            _ => NextReg;
        }
        NoInit: {
            let default_val = call get_default_reg_val(reg_def.type_ptr, reg_def.type_len);
            let val_l = call strlen(default_val);
            let _ = call env_set(ctx, reg_def.name_ptr, reg_def.name_len, default_val, val_l);
            _ => NextReg;
        }
        NextReg: {
            _ => InitRegsLoop [ r_idx <= r_idx + 1 ];
        }
        ProcessEntryActions: {
            let entry_s = m.state_defs;
            let _ = call emit_state_actions(ctx, entry_s);
            let entry_bb = ctx.blocks; // blocks[0]
            let _ = call emit_state_rules(ctx, m, entry_s, 0, entry_bb);
            _ => return 0;
        }
    }
}

machine get_default_reg_val(type_p: *u8, type_l: u32) -> *u8 {
    flow {
        wire c0 = *type_p;
    }
    states {
        Entry: {
            c0 == 42 => ReturnNull; // '*'
            _        => ReturnZero;
        }
        ReturnNull: {
            _ => return "null";
        }
        ReturnZero: {
            _ => return "0";
        }
    }
}

machine emit_state_actions(ctx: *CodegenCtx, s: *StateDef) -> u32 {
    flow {
        reg cur_act: *ActionStmt = null;
        wire has_more = cur_act != null;
    }
    states {
        Entry: {
            ctx.cur_state_p <- s.name_ptr;
            ctx.cur_state_l <- s.name_len;
            _ => Loop [ cur_act <= s.actions ];
        }
        Loop: {
            has_more != 0 => EmitAct;
            _             => Exit;
        }
        EmitAct: {
            let k = cur_act.kind;
            k == 1 => EmitLet;
            k == 2 => EmitCall;
            k == 3 => EmitStore;
            _      => NextAct;
        }
        EmitLet: {
            let res = call emit_expr(ctx, cur_act.expr);
            let res_l = call strlen(res);
            let _ = call env_set(ctx, cur_act.target_ptr, cur_act.target_len, res, res_l);
            _ => NextAct;
        }
        EmitCall: {
            let _ = call emit_expr(ctx, cur_act.expr);
            _ => NextAct;
        }
        EmitStore: {
            let _ = call emit_store(ctx, cur_act.target_expr, cur_act.expr);
            _ => NextAct;
        }
        NextAct: {
            _ => Loop [ cur_act <= cur_act.next ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine prepare_state_regs(ctx: *CodegenCtx, m: *MachineDef, s: *StateDef) -> u32 {
    flow {
        reg r_idx: u32 = 0;
        wire cnt = m.reg_count;
        wire has_more = r_idx < cnt;
        wire fld_reg_def = m.regs;
        wire reg_def = fld_reg_def + r_idx;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            _ => Loop [ r_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => Step;
            _             => Exit;
        }
        Step: {
            let b_reg_var = alloc.base_ptr;
            let off_reg_var = alloc.offset;
            let reg_var = b_reg_var + off_reg_var;
            let _ = call append_str_to_alloc(alloc, "%reg_", 5);
            let _ = call append_str_to_alloc(alloc, reg_def.name_ptr, reg_def.name_len);
            let _ = call append_char_to_alloc(alloc, 95); // '_'
            let _ = call append_str_to_alloc(alloc, s.name_ptr, s.name_len);
            let _ = call append_char_to_alloc(alloc, 0);

            let _ = call env_set(ctx, reg_def.name_ptr, reg_def.name_len, reg_var, call strlen(reg_var));
            _ => Loop [ r_idx <= r_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_machine_states(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg cur_s: *StateDef = null;
        reg s_idx: u32 = 1;
        wire has_more = cur_s != null;
    }
    states {
        Entry: {
            let s0 = m.state_defs;
            s0 == null => Exit;
            let s1 = s0.next;
            s1 == null => Exit;
            _ => Loop [ cur_s <= s1, s_idx <= 1 ];
        }
        Loop: {
            has_more != 0 => EmitOneState;
            _             => Exit;
        }
        EmitOneState: {
            // ステート先頭ブロックを作成
            let cap = call calc_bb_required_size(cur_s, m);
            let state_bb = call add_basic_block(ctx, cur_s.name_ptr, cur_s.name_len, s_idx, cap);
            let _ = call switch_to_bb(ctx, state_bb);

            // 環境をクリア
            ctx.cur_env_cnt <- 0;

            // このステートにおけるレジスタ名を環境に登録
            let _ = call prepare_state_regs(ctx, m, cur_s);

            // ステートのアクションを出力
            let _ = call emit_state_actions(ctx, cur_s);

            // ステートのルールを出力
            let _ = call emit_state_rules(ctx, m, cur_s, s_idx, state_bb);

            _ => NextState;
        }
        NextState: {
            _ => Loop [ cur_s <= cur_s.next, s_idx <= s_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine count_phi_entries(ctx: *CodegenCtx, s_idx: u32, r_idx: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        reg match_cnt: u32 = 0;
        wire cnt = ctx.phi_cnt;
        wire has_more = i < cnt;
        wire fld_entry = ctx.phi_entries;
        wire entry = fld_entry + i;
        wire val_is_match_s = entry.state_idx;
        wire is_match_s = val_is_match_s == s_idx;
        wire val_is_match_r = entry.reg_idx;
        wire is_match_r = val_is_match_r == r_idx;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0, match_cnt <= 0 ];
        }
        Loop: {
            has_more != 0 => CheckEntry;
            _             => Exit;
        }
        CheckEntry: {
            is_match_s == 0 => NextIter;
            is_match_r != 0 => IncCnt;
            _               => NextIter;
        }
        IncCnt: {
            _ => Loop [ i <= i + 1, match_cnt <= match_cnt + 1 ];
        }
        NextIter: {
            _ => Loop [ i <= i + 1, match_cnt <= match_cnt ];
        }
        Exit: {
            _ => return match_cnt;
        }
    }
}

machine emit_state_phi_nodes(ctx: *CodegenCtx, m: *MachineDef, s: *StateDef, s_idx: u32) -> u32 {
    flow {
        reg r_idx: u32 = 0;
        wire cnt = m.reg_count;
        wire has_more = r_idx < cnt;
        wire fld_reg_def = m.regs;
        wire reg_def = fld_reg_def + r_idx;
    }
    states {
        Entry: {
            _ => Loop [ r_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => CheckPhi;
            _             => Exit;
        }
        CheckPhi: {
            let in_cnt = call count_phi_entries(ctx, s_idx, r_idx);
            in_cnt != 0 => EmitOnePhi;
            _           => NextReg;
        }
        EmitOnePhi: {
            let rtype_p = call map_type_ptr(ctx, reg_def.type_ptr, reg_def.type_len);
            let rtype_l = call map_type_len(ctx, reg_def.type_ptr, reg_def.type_len);

            let _ = call emit_str(ctx, "  %reg_", 7);
            let _ = call emit_str(ctx, reg_def.name_ptr, reg_def.name_len);
            let _ = call emit_char(ctx, 95); // '_'
            let _ = call emit_str(ctx, s.name_ptr, s.name_len);
            let _ = call emit_str(ctx, " = phi ", 7);
            let _ = call emit_str(ctx, rtype_p, rtype_l);
            let _ = call emit_char(ctx, 32); // ' '

            // PhiTable からこの state_idx と reg_idx に対応する流入値を結合出力
            let _ = call emit_phi_entries(ctx, s_idx, r_idx);
            let _ = call emit_nl(ctx);

            _ => NextReg;
        }
        NextReg: {
            _ => Loop [ r_idx <= r_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_phi_entries(ctx: *CodegenCtx, s_idx: u32, r_idx: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        reg emitted_cnt: u32 = 0;
        wire cnt = ctx.phi_cnt;
        wire has_more = i < cnt;
        wire fld_entry = ctx.phi_entries;
        wire entry = fld_entry + i;
        wire val_is_match_s = entry.state_idx;
        wire is_match_s = val_is_match_s == s_idx;
        wire val_is_match_r = entry.reg_idx;
        wire is_match_r = val_is_match_r == r_idx;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0, emitted_cnt <= 0 ];
        }
        Loop: {
            has_more != 0 => CheckEntry;
            _             => Exit;
        }
        CheckEntry: {
            is_match_s == 0 => NextIter;
            is_match_r != 0 => EmitOneIn;
            _               => NextIter;
        }
        EmitOneIn: {
            emitted_cnt != 0 => EmitComma;
            _                => DoEmit;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => DoEmit;
        }
        DoEmit: {
            // [ val, %from_bb ]
            let _ = call emit_str(ctx, "[ ", 2);
            let _ = call emit_str(ctx, entry.val_p, entry.val_l);
            let _ = call emit_str(ctx, ", %", 3);
            let _ = call emit_str(ctx, entry.from_bb_p, entry.from_bb_l);
            let _ = call emit_str(ctx, " ]", 2);
            _ => Loop [ i <= i + 1, emitted_cnt <= emitted_cnt + 1 ];
        }
        NextIter: {
            _ => Loop [ i <= i + 1, emitted_cnt <= emitted_cnt ];
        }
        Exit: {
            _ => return emitted_cnt;
        }
    }
}

machine emit_ret_value(ctx: *CodegenCtx, m: *MachineDef, expr: *ExprNode) -> u32 {
    flow {}
    states {
        Entry: {
            let val = call emit_expr(ctx, expr);
            let vt = call get_expr_type(ctx, expr);
            let vtl = call strlen(vt);
            let ok = call validate_type(ctx, 4, m.name_ptr, m.name_len, 0, m.ret_type_ptr, m.ret_type_len, vt, vtl, expr);

            let ret_p = call map_type_ptr(ctx, m.ret_type_ptr, m.ret_type_len);
            let ret_l = call map_type_len(ctx, m.ret_type_ptr, m.ret_type_len);

            let _ = call emit_str(ctx, "  ret ", 6);
            let _ = call emit_str(ctx, ret_p, ret_l);
            let _ = call emit_char(ctx, 32); // ' '
            let _ = call emit_str(ctx, val, call strlen(val));
            let _ = call emit_nl(ctx);
            _ => Exit;
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine emit_state_rules(ctx: *CodegenCtx, m: *MachineDef, s: *StateDef, s_idx: u32, start_bb: *BasicBlock) -> u32 {
    flow {
        reg r_idx: u32 = 0;
        reg cur_bb: *BasicBlock = start_bb;
        reg cur_rule: *TransitionRule = null;
        wire has_more = cur_rule != null;
        wire rule = cur_rule;
        wire rule_ret = cur_rule.ret_expr;
        wire rule_guard = cur_rule.guard;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            ctx.cur_state_p <- s.name_ptr;
            ctx.cur_state_l <- s.name_len;
            _ => Loop [ r_idx <= 0, cur_bb <= start_bb, cur_rule <= s.rules ];
        }
        Loop: {
            has_more != 0 => ProcessRule;
            _             => FinishStateBlock;
        }
        ProcessRule: {
            rule.is_return != 0 => EmitReturn;
            rule.is_panic != 0  => EmitPanic;
            _                   => EmitTransition;
        }
        EmitReturn: {
            rule_ret != null => RetVal;
            _                => RetVoid;
        }
        RetVal: {
            let _ = call emit_ret_value(ctx, m, rule_ret);
            _ => FinishStateBlock;
        }
        RetVoid: {
            let _ = call emit_str(ctx, "  ret void", 10);
            let _ = call emit_nl(ctx);
            _ => FinishStateBlock;
        }
        EmitPanic: {
            let _ = call emit_str(ctx, "  call void @llvm.trap()", 24);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  unreachable", 13);
            let _ = call emit_nl(ctx);
            _ => FinishStateBlock;
        }
        EmitTransition: {
            rule_guard != null => GuardedBranch;
            _                  => UnconditionalBranch;
        }
        GuardedBranch: {
            let cond_val = call emit_expr(ctx, rule_guard);

            // then_bb: "{cur_bb}_then_{r_idx}"
            let b_then_bb_p = alloc.base_ptr;
            let off_then_bb_p = alloc.offset;
            let then_bb_p = b_then_bb_p + off_then_bb_p;
            let _ = call append_str_to_alloc(alloc, s.name_ptr, s.name_len);
            let _ = call append_str_to_alloc(alloc, "_then_", 6);
            let _ = call append_u32_to_alloc(alloc, r_idx);
            let _ = call append_char_to_alloc(alloc, 0);
            let then_bb_l = call strlen(then_bb_p);

            // else_bb: "{cur_bb}_else_{r_idx}"
            let b_else_bb_p = alloc.base_ptr;
            let off_else_bb_p = alloc.offset;
            let else_bb_p = b_else_bb_p + off_else_bb_p;
            let _ = call append_str_to_alloc(alloc, s.name_ptr, s.name_len);
            let _ = call append_str_to_alloc(alloc, "_else_", 6);
            let _ = call append_u32_to_alloc(alloc, r_idx);
            let _ = call append_char_to_alloc(alloc, 0);
            let else_bb_l = call strlen(else_bb_p);

            // 現在のブロックに分岐を出力
            let _ = call emit_str(ctx, "  br i1 ", 8);
            let _ = call emit_str(ctx, cond_val, call strlen(cond_val));
            let _ = call emit_str(ctx, ", label %", 9);
            let _ = call emit_str(ctx, then_bb_p, then_bb_l);
            let _ = call emit_str(ctx, ", label %", 9);
            let _ = call emit_str(ctx, else_bb_p, else_bb_l);
            let _ = call emit_nl(ctx);
            let _ = call finish_cur_bb(ctx, cur_bb);

            // then_bb を追加して出力
            let branch_cap = call calc_branch_bb_size(m);
            let then_bb = call add_basic_block(ctx, then_bb_p, then_bb_l, -1, branch_cap);
            let _ = call switch_to_bb(ctx, then_bb);
            let _ = call record_latches_for_rule(ctx, m, rule, then_bb_p, then_bb_l);
            let _ = call emit_str(ctx, "  br label %", 12);
            let _ = call emit_str(ctx, rule.target_ptr, rule.target_len);
            let _ = call emit_nl(ctx);
            let _ = call finish_cur_bb(ctx, then_bb);

            // else_bb を追加して次のルールの出力先にする
            let else_bb = call add_basic_block(ctx, else_bb_p, else_bb_l, -1, branch_cap);
            let _ = call switch_to_bb(ctx, else_bb);

            _ => Loop [ r_idx <= r_idx + 1, cur_bb <= else_bb, cur_rule <= cur_rule.next ];
        }
        UnconditionalBranch: {
            let _ = call record_latches_for_rule(ctx, m, rule, cur_bb.name_ptr, cur_bb.name_len);
            let _ = call emit_str(ctx, "  br label %", 12);
            let _ = call emit_str(ctx, rule.target_ptr, rule.target_len);
            let _ = call emit_nl(ctx);
            _ => FinishStateBlock;
        }
        FinishStateBlock: {
            let _ = call finish_cur_bb(ctx, cur_bb);
            _ => return 0;
        }
    }
}

machine find_state_by_idx(m: *MachineDef, target_idx: u32) -> *StateDef {
    flow {
        reg cur_s: *StateDef = null;
        reg idx:   u32 = 0;
        wire has_more = cur_s != null;
        wire is_match = idx == target_idx;
    }
    states {
        Entry: {
            _ => Loop [ cur_s <= m.state_defs, idx <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Next;
        }
        Found: {
            _ => return cur_s;
        }
        Next: {
            _ => Loop [ cur_s <= cur_s.next, idx <= idx + 1 ];
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine assemble_machine_blocks(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg b_idx: u32 = 0;
        wire cnt = ctx.block_cnt;
        wire has_more = b_idx < cnt;
        wire fld_bb = ctx.blocks;
        wire bb = fld_bb + b_idx;
    }
    states {
        Entry: {
            _ => Loop [ b_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitBlock;
            _             => Exit;
        }
        EmitBlock: {
            // ラベル
            let _ = call emit_str(ctx, bb.name_ptr, bb.name_len);
            let _ = call emit_char(ctx, 58); // ':'
            let _ = call emit_nl(ctx);

            let s_idx = bb.state_idx;
            s_idx >= 1 => EmitPhis;
            _          => EmitInsts;
        }
        EmitPhis: {
            let s = call find_state_by_idx(m, bb.state_idx);
            s != null => DoEmitPhis;
            _         => EmitInsts;
        }
        DoEmitPhis: {
            let s = call find_state_by_idx(m, bb.state_idx);
            let _ = call emit_state_phi_nodes(ctx, m, s, bb.state_idx);
            _ => EmitInsts;
        }
        EmitInsts: {
            let _ = call emit_str(ctx, bb.buf_ptr, bb.buf_pos);
            _ => Loop [ b_idx <= b_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine record_latches_for_rule(ctx: *CodegenCtx, m: *MachineDef, rule: *TransitionRule, from_bb_p: *u8, from_bb_l: u32) -> u32 {
    flow {
        reg r_idx: u32 = 0;
        wire cnt = m.reg_count;
        wire has_more = r_idx < cnt;
        wire fld_reg_def = m.regs;
        wire reg_def = fld_reg_def + r_idx;
        wire target_s_idx = call find_state_idx(m, rule.target_ptr, rule.target_len);
        wire latch_e = call find_latch_expr(rule, reg_def.name_ptr, reg_def.name_len);
        wire ssa_p = call env_get_ptr(ctx, reg_def.name_ptr, reg_def.name_len);
    }
    states {
        Entry: {
            target_s_idx < 0 => Exit;
            _                => Loop [ r_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => ProcessOneReg;
            _             => Exit;
        }
        ProcessOneReg: {
            latch_e != null => HasLatch;
            _               => DefaultLatch;
        }
        HasLatch: {
            let val = call emit_expr(ctx, latch_e);
            let val_l = call strlen(val);
            let lt = call get_expr_type(ctx, latch_e);
            let ltl = call strlen(lt);
            let ok = call validate_type(ctx, 3, reg_def.name_ptr, reg_def.name_len, 0, reg_def.type_ptr, reg_def.type_len, lt, ltl, latch_e);
            let _ = call record_phi_incoming(ctx, target_s_idx, r_idx, from_bb_p, from_bb_l, val, val_l);
            _ => NextReg;
        }
        DefaultLatch: {
            ssa_p != null => EmitEnvVal;
            _             => EmitDefVal;
        }
        EmitEnvVal: {
            let val_l = call strlen(ssa_p);
            let _ = call record_phi_incoming(ctx, target_s_idx, r_idx, from_bb_p, from_bb_l, ssa_p, val_l);
            _ => NextReg;
        }
        EmitDefVal: {
            let def_val = call get_default_reg_val(reg_def.type_ptr, reg_def.type_len);
            let val_l = call strlen(def_val);
            let _ = call record_phi_incoming(ctx, target_s_idx, r_idx, from_bb_p, from_bb_l, def_val, val_l);
            _ => NextReg;
        }
        NextReg: {
            _ => Loop [ r_idx <= r_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine find_state_idx(m: *MachineDef, name_p: *u8, name_l: u32) -> i32 {
    flow {
        reg cur_s: *StateDef = null;
        reg idx:   u32 = 0;
        wire has_more = cur_s != null;
        wire is_match = call str_eq(cur_s.name_ptr, cur_s.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ cur_s <= m.state_defs, idx <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Next;
        }
        Found: {
            _ => return idx;
        }
        Next: {
            _ => Loop [ cur_s <= cur_s.next, idx <= idx + 1 ];
        }
        NotFound: {
            _ => return -1;
        }
    }
}

machine find_latch_expr(rule: *TransitionRule, name_p: *u8, name_l: u32) -> *ExprNode {
    flow {
        reg cur_l: *LatchAssign = null;
        wire has_more = cur_l != null;
        wire is_match = call str_eq(cur_l.reg_ptr, cur_l.reg_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ cur_l <= rule.latches ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Next;
        }
        Found: {
            _ => return cur_l.expr;
        }
        Next: {
            _ => Loop [ cur_l <= cur_l.next ];
        }
        NotFound: {
            _ => return null;
        }
    }
}

