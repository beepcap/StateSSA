machine get_type_bit_width(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetDefault;
            let l = call strlen(t);

            // i64, u64, q64
            let is_i64 = call str_eq(t, l, "i64", 3);
            is_i64 != 0 => Ret64;
            let is_u64 = call str_eq(t, l, "u64", 3);
            is_u64 != 0 => Ret64;
            let is_q64 = call str_eq(t, l, "q64", 3);
            is_q64 != 0 => Ret64;

            // i16, u16
            let is_i16 = call str_eq(t, l, "i16", 3);
            is_i16 != 0 => Ret16;
            let is_u16 = call str_eq(t, l, "u16", 3);
            is_u16 != 0 => Ret16;

            // i8, u8
            let is_i8 = call str_eq(t, l, "i8", 2);
            is_i8 != 0 => Ret8;
            let is_u8 = call str_eq(t, l, "u8", 2);
            is_u8 != 0 => Ret8;

            // i1
            let is_i1 = call str_eq(t, l, "i1", 2);
            is_i1 != 0 => Ret1;

            // ポインタ (*...) は 64bit
            let c0 = *t;
            c0 == 42 => Ret64;

            _ => Ret32;
        }
        Ret64:   { _ => return 64; }
        Ret32:   { _ => return 32; }
        Ret16:   { _ => return 16; }
        Ret8:    { _ => return 8;  }
        Ret1:    { _ => return 1;  }
        RetDefault: { _ => return 32; }
    }
}

machine parse_u32_digits(s: *u8, len: u32) -> u32 {
    flow {
        reg res: u32 = 0;
        reg i: u32 = 0;
        wire has_more = i < len;
        wire ptr_c = s + i;
        wire ch = *ptr_c;
        wire is_digit = (ch >= 48) & (ch <= 57);
    }
    states {
        Entry: {
            len == 0 => Exit;
            _        => Loop [ res <= 0, i <= 0 ];
        }
        Loop: {
            has_more == 0 => Exit;
            is_digit != 0 => Step;
            _             => Exit;
        }
        Step: {
            let digit = ch - 48;
            let next_val = (res * 10) + digit;
            _ => Loop [ res <= next_val, i <= i + 1 ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine get_vector_byte_size(t: *u8, len: u32) -> u32 {
    flow {
        reg off: u32 = 0;
        reg esz: u32 = 0;
    }
    states {
        Entry: {
            t == null => RetZero;
            len < 4   => CheckU8;

            let is_f32 = call str_starts_with(t, len, "f32x", 4);
            is_f32 != 0 => Calc4 [ off <= 4, esz <= 4 ];
            let is_f64 = call str_starts_with(t, len, "f64x", 4);
            is_f64 != 0 => Calc4 [ off <= 4, esz <= 8 ];
            let is_i32 = call str_starts_with(t, len, "i32x", 4);
            is_i32 != 0 => Calc4 [ off <= 4, esz <= 4 ];
            let is_i64 = call str_starts_with(t, len, "i64x", 4);
            is_i64 != 0 => Calc4 [ off <= 4, esz <= 8 ];
            let is_u32 = call str_starts_with(t, len, "u32x", 4);
            is_u32 != 0 => Calc4 [ off <= 4, esz <= 4 ];
            let is_u64 = call str_starts_with(t, len, "u64x", 4);
            is_u64 != 0 => Calc4 [ off <= 4, esz <= 8 ];
            let is_i16 = call str_starts_with(t, len, "i16x", 4);
            is_i16 != 0 => Calc4 [ off <= 4, esz <= 2 ];
            let is_u16 = call str_starts_with(t, len, "u16x", 4);
            is_u16 != 0 => Calc4 [ off <= 4, esz <= 2 ];

            _ => CheckU8;
        }
        CheckU8: {
            len < 3 => RetZero;
            let is_u8 = call str_starts_with(t, len, "u8x", 3);
            is_u8 != 0 => Calc4 [ off <= 3, esz <= 1 ];
            let is_i8 = call str_starts_with(t, len, "i8x", 3);
            is_i8 != 0 => Calc4 [ off <= 3, esz <= 1 ];
            _ => RetZero;
        }
        Calc4: {
            let digits_p = t + off;
            let digits_l = len - off;
            let lanes = call parse_u32_digits(digits_p, digits_l);
            lanes == 0 => RetZero;
            let total = esz * lanes;
            _ => return total;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine get_vector_elem_size(t: *u8, len: u32) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetZero;
            len < 4   => CheckU8;

            let is_f32 = call str_starts_with(t, len, "f32x", 4);
            is_f32 != 0 => Ret4;
            let is_f64 = call str_starts_with(t, len, "f64x", 4);
            is_f64 != 0 => Ret8;
            let is_i32 = call str_starts_with(t, len, "i32x", 4);
            is_i32 != 0 => Ret4;
            let is_i64 = call str_starts_with(t, len, "i64x", 4);
            is_i64 != 0 => Ret8;
            let is_u32 = call str_starts_with(t, len, "u32x", 4);
            is_u32 != 0 => Ret4;
            let is_u64 = call str_starts_with(t, len, "u64x", 4);
            is_u64 != 0 => Ret8;
            let is_i16 = call str_starts_with(t, len, "i16x", 4);
            is_i16 != 0 => Ret2;
            let is_u16 = call str_starts_with(t, len, "u16x", 4);
            is_u16 != 0 => Ret2;

            _ => CheckU8;
        }
        CheckU8: {
            len < 3 => RetZero;
            let is_u8 = call str_starts_with(t, len, "u8x", 3);
            is_u8 != 0 => Ret1;
            let is_i8 = call str_starts_with(t, len, "i8x", 3);
            is_i8 != 0 => Ret1;
            _ => RetZero;
        }
        Ret8: { _ => return 8; }
        Ret4: { _ => return 4; }
        Ret2: { _ => return 2; }
        Ret1: { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine align_to(offset: u32, align: u32) -> u32 {
    flow {
        reg pad: u32 = 0;
    }
    states {
        Entry: {
            align <= 1 => NoPad;
            let mask = align - 1;
            let rem = offset & mask;
            rem != 0 => DoPad [ pad <= align - rem ];
            _        => NoPad;
        }
        DoPad: {
            _ => return offset + pad;
        }
        NoPad: {
            _ => return offset;
        }
    }
}

machine calc_struct_align(prog: *ProgramDef, t: *TypeDef) -> u32 {
    flow {
        reg max_align: u32 = 1;
        reg i:         u32 = 0;
        wire cnt = t.field_count;
        wire has_more = i < cnt;
        wire fld_ptr = t.fields;
        wire cur_fld = fld_ptr + i;
    }
    states {
        Entry: {
            cnt == 0 => Ret4;
            _ => Loop [ max_align <= 1, i <= 0 ];
        }
        Loop: {
            has_more == 0 => Exit;
            _             => Step;
        }
        Step: {
            let f_t = cur_fld.type_ptr;
            let f_l = cur_fld.type_len;
            let f_al = call get_type_align(prog, f_t, f_l);
            f_al > max_align => Loop [ max_align <= f_al, i <= i + 1 ];
            _                => Loop [ max_align <= max_align, i <= i + 1 ];
        }
        Exit: {
            _ => return max_align;
        }
        Ret4: {
            _ => return 4;
        }
    }
}

machine calc_struct_byte_size(prog: *ProgramDef, t: *TypeDef) -> u32 {
    flow {
        reg cur_off:   u32 = 0;
        reg max_align: u32 = 1;
        reg i:         u32 = 0;
        reg sz:        u32 = 0;
        reg al:        u32 = 1;
        reg next_al:   u32 = 1;
        wire cnt = t.field_count;
        wire has_more = i < cnt;
        wire fld_ptr = t.fields;
        wire cur_fld = fld_ptr + i;
    }
    states {
        Entry: {
            cnt == 0 => Ret4;
            _ => Loop [ cur_off <= 0, max_align <= 1, i <= 0 ];
        }
        Loop: {
            has_more == 0 => FinishStruct;
            _             => StepField;
        }
        StepField: {
            let f_t = cur_fld.type_ptr;
            let f_l = cur_fld.type_len;
            let f_sz = call get_type_byte_size(prog, f_t, f_l);
            let f_al = call get_type_align(prog, f_t, f_l);

            f_al > max_align => NextField [ next_al <= f_al, sz <= f_sz, al <= f_al ];
            _                => NextField [ next_al <= max_align, sz <= f_sz, al <= f_al ];
        }
        NextField: {
            let aligned_off = call align_to(cur_off, al);
            let next_off = aligned_off + sz;
            _ => Loop [ cur_off <= next_off, max_align <= next_al, i <= i + 1 ];
        }
        FinishStruct: {
            let final_off = call align_to(cur_off, max_align);
            _ => return final_off;
        }
        Ret4: {
            _ => return 4;
        }
    }
}

machine get_struct_align(prog: *ProgramDef, sname_p: *u8, sname_l: u32) -> u32 {
    flow {
        reg s_r:    *TypeDef = null;
        reg base_p: *u8 = null;
        reg base_l: u32 = 0;
    }
    states {
        Entry: {
            prog == null => Ret4;
            sname_p == null => Ret4;
            let s = call find_struct_def(prog, sname_p, sname_l);
            s == null => Ret4;
            s.kind != 0 => RetBase [ base_p <= s.base_ptr, base_l <= s.base_len ];
            _ => CalcAlign [ s_r <= s ];
        }
        CalcAlign: {
            let al = call calc_struct_align(prog, s_r);
            _ => return al;
        }
        RetBase: {
            let b_al = call get_type_align(prog, base_p, base_l);
            _ => return b_al;
        }
        Ret4: {
            _ => return 4;
        }
    }
}

machine get_struct_byte_size(prog: *ProgramDef, sname_p: *u8, sname_l: u32) -> u32 {
    flow {
        reg s_r:    *TypeDef = null;
        reg base_p: *u8 = null;
        reg base_l: u32 = 0;
    }
    states {
        Entry: {
            prog == null => Ret4;
            sname_p == null => Ret4;
            let s = call find_struct_def(prog, sname_p, sname_l);
            s == null => Ret4;
            s.kind != 0 => RetBase [ base_p <= s.base_ptr, base_l <= s.base_len ];
            _ => CalcSize [ s_r <= s ];
        }
        CalcSize: {
            let sz = call calc_struct_byte_size(prog, s_r);
            _ => return sz;
        }
        RetBase: {
            let b_sz = call get_type_byte_size(prog, base_p, base_l);
            _ => return b_sz;
        }
        Ret4: {
            _ => return 4;
        }
    }
}

machine get_type_align(prog: *ProgramDef, t: *u8, len: u32) -> u32 {
    flow {
        reg e_sz: u32 = 0;
    }
    states {
        Entry: {
            t == null => Ret4;
            len == 0  => Ret4;
            let c0 = *t;
            c0 == 42 => Ret8; // '*' pointer alignment is 8

            // Vector check
            let elem_sz = call get_vector_elem_size(t, len);
            elem_sz > 0 => RetElem [ e_sz <= elem_sz ];

            // Primitives
            let is_i64 = call str_eq(t, len, "i64", 3);
            is_i64 != 0 => Ret8;
            let is_u64 = call str_eq(t, len, "u64", 3);
            is_u64 != 0 => Ret8;
            let is_f64 = call str_eq(t, len, "f64", 3);
            is_f64 != 0 => Ret8;
            let is_q64 = call str_eq(t, len, "q64", 3);
            is_q64 != 0 => Ret8;

            let is_i32 = call str_eq(t, len, "i32", 3);
            is_i32 != 0 => Ret4;
            let is_u32 = call str_eq(t, len, "u32", 3);
            is_u32 != 0 => Ret4;
            let is_f32 = call str_eq(t, len, "f32", 3);
            is_f32 != 0 => Ret4;

            let is_i16 = call str_eq(t, len, "i16", 3);
            is_i16 != 0 => Ret2;
            let is_u16 = call str_eq(t, len, "u16", 3);
            is_u16 != 0 => Ret2;

            let is_i8 = call str_eq(t, len, "i8", 2);
            is_i8 != 0 => Ret1;
            let is_u8 = call str_eq(t, len, "u8", 2);
            is_u8 != 0 => Ret1;
            let is_i1 = call str_eq(t, len, "i1", 2);
            is_i1 != 0 => Ret1;

            // Struct check
            prog != null => CheckStruct;
            _            => Ret4;
        }
        RetElem: {
            _ => return e_sz;
        }
        CheckStruct: {
            let s_al = call get_struct_align(prog, t, len);
            _ => return s_al;
        }
        Ret8:  { _ => return 8; }
        Ret4:  { _ => return 4; }
        Ret2:  { _ => return 2; }
        Ret1:  { _ => return 1; }
    }
}

machine get_type_byte_size(prog: *ProgramDef, t: *u8, len: u32) -> u32 {
    flow {
        reg sz: u32 = 0;
    }
    states {
        Entry: {
            t == null => Ret4;
            len == 0  => Ret4;
            let c0 = *t;
            c0 == 42 => Ret8; // '*' pointer is 8 bytes

            // Vector check
            let v_sz = call get_vector_byte_size(t, len);
            v_sz > 0 => RetCustom [ sz <= v_sz ];

            // Primitives
            let is_i64 = call str_eq(t, len, "i64", 3);
            is_i64 != 0 => Ret8;
            let is_u64 = call str_eq(t, len, "u64", 3);
            is_u64 != 0 => Ret8;
            let is_f64 = call str_eq(t, len, "f64", 3);
            is_f64 != 0 => Ret8;
            let is_q64 = call str_eq(t, len, "q64", 3);
            is_q64 != 0 => Ret8;

            let is_i32 = call str_eq(t, len, "i32", 3);
            is_i32 != 0 => Ret4;
            let is_u32 = call str_eq(t, len, "u32", 3);
            is_u32 != 0 => Ret4;
            let is_f32 = call str_eq(t, len, "f32", 3);
            is_f32 != 0 => Ret4;

            let is_i16 = call str_eq(t, len, "i16", 3);
            is_i16 != 0 => Ret2;
            let is_u16 = call str_eq(t, len, "u16", 3);
            is_u16 != 0 => Ret2;

            let is_i8 = call str_eq(t, len, "i8", 2);
            is_i8 != 0 => Ret1;
            let is_u8 = call str_eq(t, len, "u8", 2);
            is_u8 != 0 => Ret1;
            let is_i1 = call str_eq(t, len, "i1", 2);
            is_i1 != 0 => Ret1;

            // Struct check
            prog != null => CheckStruct;
            _            => Ret4;
        }
        CheckStruct: {
            let s_sz = call get_struct_byte_size(prog, t, len);
            _ => return s_sz;
        }
        RetCustom: {
            _ => return sz;
        }
        Ret8: { _ => return 8; }
        Ret4: { _ => return 4; }
        Ret2: { _ => return 2; }
        Ret1: { _ => return 1; }
    }
}

machine diag_nl() -> u32 {
    flow {}
    states {
        Entry: {
            let m = call malloc(2);
            *m <- 10;
            let _ = call write(2, m, 1);
            let _ = call free(m);
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine diag_write(buf: *u8, len: u32) -> u32 {
    flow {}
    states {
        Entry: {
            buf == null => Exit;
            len == 0    => Exit;
            let _ = call write(2, buf, len);
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine diag_str(s: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            s == null => Exit;
            let len = call strlen(s);
            let _ = call diag_write(s, len);
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine diag_u32(val: u32) -> u32 {
    flow {
        reg buf: *u8 = null;
        reg v:   u32 = 0;
        reg idx: u32 = 15;
    }
    states {
        Entry: {
            let m = call malloc(16);
            *(m + 15) <- 0;
            val == 0 => Zero [ buf <= m ];
            _        => Loop [ buf <= m, v <= val, idx <= 15 ];
        }
        Zero: {
            *(buf + 14) <- 48;
            let _ = call write(2, buf + 14, 1);
            let _ = call free(buf);
            _ => Exit;
        }
        Loop: {
            v == 0 => Flush;
            _      => Step;
        }
        Step: {
            let next_v = v / 10;
            let mul10 = next_v * 10;
            let digit = v - mul10;
            let ch_int = digit + 48;
            let ch = cast(u8) ch_int;
            let cur_idx = idx - 1;
            *(buf + cur_idx) <- ch;
            _ => Loop [ v <= next_v, idx <= cur_idx ];
        }
        Flush: {
            let start = buf + idx;
            let len = 15 - idx;
            let _ = call write(2, start, len);
            let _ = call free(buf);
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine diag_i32(val: i32) -> u32 {
    flow {}
    states {
        Entry: {
            val < 0 => Negative;
            _       => Positive;
        }
        Negative: {
            let _ = call diag_str("-");
            let pos_val = 0 - val;
            let _ = call diag_u32(cast(u32) pos_val);
            _ => Exit;
        }
        Positive: {
            let _ = call diag_u32(cast(u32) val);
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine diag_expr_name(expr: *ExprNode) -> u32 {
    flow {}
    states {
        Entry: {
            expr == null => PrintNullExpr;
            let k = expr.kind;
            k == 4  => PrintVar;
            k == 1  => PrintInt;
            k == 2  => PrintStr;
            k == 3  => PrintNullLit;
            k == 7  => PrintField;
            k == 8  => PrintCall;
            k == 10 => PrintCast;
            _       => PrintGeneric;
        }
        PrintNullExpr: {
            let _ = call diag_str("<null>");
            _ => Exit;
        }
        PrintVar: {
            let _ = call diag_write(expr.str_ptr, expr.str_len);
            _ => Exit;
        }
        PrintInt: {
            let iv = expr.int_val;
            let v32 = cast(u32) iv;
            let _ = call diag_u32(v32);
            _ => Exit;
        }
        PrintStr: {
            let _ = call diag_str("'");
            let _ = call diag_write(expr.str_ptr, expr.str_len);
            let _ = call diag_str("'");
            _ => Exit;
        }
        PrintNullLit: {
            let _ = call diag_str("null");
            _ => Exit;
        }
        PrintField: {
            let _ = call diag_expr_name(expr.left);
            let _ = call diag_str(".");
            let _ = call diag_write(expr.str_ptr, expr.str_len);
            _ => Exit;
        }
        PrintCall: {
            let _ = call diag_str("call ");
            let _ = call diag_write(expr.str_ptr, expr.str_len);
            let _ = call diag_str("(...)");
            _ => Exit;
        }
        PrintCast: {
            let _ = call diag_str("cast(");
            let _ = call diag_write(expr.str_ptr, expr.str_len);
            let _ = call diag_str(") ");
            let _ = call diag_expr_name(expr.left);
            _ => Exit;
        }
        PrintGeneric: {
            let _ = call diag_str("<expr>");
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine is_ptr_type_str(p: *u8, len: u32) -> u32 {
    flow {}
    states {
        Entry: {
            p == null => RetZero;
            len == 0  => RetZero;

            let c0 = *p;
            c0 == 42 => RetOne;

            let last_idx = len - 1;
            let c_last = *(p + last_idx);
            c_last == 42 => RetOne;

            let is_ptr = call str_eq(p, len, "ptr", 3);
            is_ptr != 0 => RetOne;

            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine is_ptr_type(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetZero;
            let l = call strlen(t);
            let r = call is_ptr_type_str(t, l);
            _     => return r;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine is_abi_bridge_arg(exp_p: *u8, exp_l: u32, act_p: *u8, act_l: u32) -> u32 {
    flow {}
    states {
        Entry: {
            exp_p == null => RetZero;
            act_p == null => RetZero;
            let is_act_q64 = call str_eq(act_p, act_l, "q64", 3);
            is_act_q64 == 0 => RetZero;

            let is_f64 = call str_eq(exp_p, exp_l, "f64", 3);
            is_f64 != 0 => RetOne;
            let is_f32 = call str_eq(exp_p, exp_l, "f32", 3);
            is_f32 != 0 => RetOne;
            let is_dbl = call str_eq(exp_p, exp_l, "double", 6);
            is_dbl != 0 => RetOne;
            let is_flt = call str_eq(exp_p, exp_l, "float", 5);
            is_flt != 0 => RetOne;

            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine is_integral_type(p: *u8, len: u32) -> u32 {
    flow {}
    states {
        Entry: {
            p == null => RetZero;
            len == 0  => RetZero;

            let is_i32 = call str_eq(p, len, "i32", 3);
            is_i32 != 0 => RetOne;
            let is_u32 = call str_eq(p, len, "u32", 3);
            is_u32 != 0 => RetOne;
            let is_i64 = call str_eq(p, len, "i64", 3);
            is_i64 != 0 => RetOne;
            let is_u64 = call str_eq(p, len, "u64", 3);
            is_u64 != 0 => RetOne;
            let is_i16 = call str_eq(p, len, "i16", 3);
            is_i16 != 0 => RetOne;
            let is_u16 = call str_eq(p, len, "u16", 3);
            is_u16 != 0 => RetOne;
            let is_i8 = call str_eq(p, len, "i8", 2);
            is_i8 != 0 => RetOne;
            let is_u8 = call str_eq(p, len, "u8", 2);
            is_u8 != 0 => RetOne;
            let is_i1 = call str_eq(p, len, "i1", 2);
            is_i1 != 0 => RetOne;

            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine is_type_compatible(kind: u32, exp_p: *u8, exp_l: u32, act_p: *u8, act_l: u32, expr: *ExprNode) -> u32 {
    flow {
        reg eb_p: *u8 = null;
        reg eb_l: u32 = 0;
        reg ab_p: *u8 = null;
        reg ab_l: u32 = 0;
    }
    states {
        Entry: {
            exp_p == null => RetPass;
            act_p == null => RetPass;
            exp_l == 0    => RetPass;
            act_l == 0    => RetPass;

            let is_bridge = call is_abi_bridge_arg(exp_p, exp_l, act_p, act_l);
            is_bridge != 0 => RetPass;

            let is_eq = call str_eq(exp_p, exp_l, act_p, act_l);
            is_eq != 0 => RetPass;

            let is_exp_ptr = call is_ptr_type_str(exp_p, exp_l);
            let is_act_ptr = call is_ptr_type_str(act_p, act_l);

            is_exp_ptr != 0 => CheckExpPtr;
            is_act_ptr != 0 => RetFail;
            _               => CheckNumeric;
        }
        CheckExpPtr: {
            let is_null = call str_eq(act_p, act_l, "null", 4);
            is_null != 0 => RetPass;

            let is_vptr_act = call str_eq(act_p, act_l, "*void", 5);
            is_vptr_act != 0 => RetPass;

            let is_u8ptr_act = call str_eq(act_p, act_l, "*u8", 3);
            is_u8ptr_act != 0 => RetPass;

            let is_vptr_exp = call str_eq(exp_p, exp_l, "*void", 5);
            is_vptr_exp != 0 => RetPass;

            let is_u8ptr_exp = call str_eq(exp_p, exp_l, "*u8", 3);
            is_u8ptr_exp != 0 => RetPass;

            let is_act_ptr = call is_ptr_type_str(act_p, act_l);
            is_act_ptr == 0 => RetFail;

            let c0_exp = *exp_p;
            c0_exp == 42 => CheckPrefixPtr;
            _            => CheckSuffixPtr;
        }
        CheckPrefixPtr: {
            let exp_base_p = exp_p + 1;
            let exp_base_l = exp_l - 1;
            let act_base_p = act_p + 1;
            let act_base_l = act_l - 1;

            let is_base_eq = call str_eq(exp_base_p, exp_base_l, act_base_p, act_base_l);
            is_base_eq != 0 => RetPass;

            let is_exp_int = call is_integral_type(exp_base_p, exp_base_l);
            let is_act_int = call is_integral_type(act_base_p, act_base_l);
            let both_int = is_exp_int & is_act_int;
            both_int != 0 => CheckIntBaseWidth [ eb_p <= exp_base_p, ab_p <= act_base_p ];

            _ => RetFail;
        }
        CheckSuffixPtr: {
            let exp_base_p = exp_p;
            let exp_base_l = exp_l - 1;
            let act_base_p = act_p + 1;
            let act_base_l = act_l - 1;

            let is_base_eq = call str_eq(exp_base_p, exp_base_l, act_base_p, act_base_l);
            is_base_eq != 0 => RetPass;

            exp_base_l > 8 => CheckStructPrefix;
            _              => CheckSuffixInt;
        }
        CheckStructPrefix: {
            let is_struct_pfx = call str_eq(exp_p, 8, "%struct.", 8);
            is_struct_pfx != 0 => CheckStructSuffix;
            _                  => CheckSuffixInt;
        }
        CheckStructSuffix: {
            let is_sbase_eq = call str_eq(exp_p + 8, exp_l - 9, act_p + 1, act_l - 1);
            is_sbase_eq != 0 => RetPass;
            _                => RetFail;
        }
        CheckSuffixInt: {
            let exp_base_p = exp_p;
            let exp_base_l = exp_l - 1;
            let act_base_p = act_p + 1;
            let act_base_l = act_l - 1;

            let is_exp_int = call is_integral_type(exp_base_p, exp_base_l);
            let is_act_int = call is_integral_type(act_base_p, act_base_l);
            let both_int = is_exp_int & is_act_int;
            both_int != 0 => CheckIntBaseWidth [ eb_p <= exp_base_p, ab_p <= act_base_p ];

            _ => RetFail;
        }
        CheckIntBaseWidth: {
            let exp_w = call get_type_bit_width(eb_p);
            let act_w = call get_type_bit_width(ab_p);
            exp_w == act_w => RetPass;
            _              => RetFail;
        }
        CheckNumeric: {
            expr == null => CheckWidth;
            let ek = expr.kind;
            ek == 1 => RetPass;
            _       => CheckWidth;
        }
        CheckWidth: {
            let exp_w = call get_type_bit_width(exp_p);
            let act_w = call get_type_bit_width(act_p);

            exp_w == act_w => RetPass;
            act_w < exp_w  => RetPass;

            kind == 2 => CheckByteStore;
            _         => RetFail;
        }
        CheckByteStore: {
            let exp_w = call get_type_bit_width(exp_p);
            exp_w <= 16 => RetPass;
            _           => RetFail;
        }
        RetPass: {
            _ => return 1;
        }
        RetFail: {
            _ => return 0;
        }
    }
}

machine get_diag_kind_str(kind: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            kind == 1 => RetCallArg;
            kind == 2 => RetStore;
            kind == 3 => RetLatch;
            kind == 4 => RetReturn;
            _         => RetUnknown;
        }
        RetCallArg: { _ => return "Function Call Argument"; }
        RetStore:   { _ => return "Memory / Field Store"; }
        RetLatch:   { _ => return "Register Latch Assignment"; }
        RetReturn:  { _ => return "Machine Return Value"; }
        RetUnknown: { _ => return "Unknown Expression"; }
    }
}

machine emit_diag_context(ctx: *CodegenCtx, target_p: *u8, target_l: u32, kind: u32, arg_idx: u32) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call diag_str("  Machine:   ");
            let cur_m = ctx.cur_machine;
            cur_m != null => MachName;
            _             => MachUnknown;
        }
        MachName: {
            let m = ctx.cur_machine;
            let _ = call diag_write(m.name_ptr, m.name_len);
            let _ = call diag_nl();
            _ => StateEntry;
        }
        MachUnknown: {
            let _ = call diag_str("<unknown>");
            let _ = call diag_nl();
            _ => StateEntry;
        }
        StateEntry: {
            let _ = call diag_str("  State:     ");
            let sp = ctx.cur_state_p;
            sp != null => StateName;
            _          => StateUnknown;
        }
        StateName: {
            let _ = call diag_write(ctx.cur_state_p, ctx.cur_state_l);
            let _ = call diag_nl();
            _ => TargetEntry;
        }
        StateUnknown: {
            let _ = call diag_str("<unknown>");
            let _ = call diag_nl();
            _ => TargetEntry;
        }
        TargetEntry: {
            let _ = call diag_str("  Target:    ");
            target_p != null => TargetStr;
            _                => TargetNone;
        }
        TargetStr: {
            let _ = call diag_write(target_p, target_l);
            kind == 1 => ArgIdx;
            _         => TargetNl;
        }
        ArgIdx: {
            let _ = call diag_str(" (Argument #");
            let _ = call diag_u32(arg_idx);
            let _ = call diag_str(")");
            let _ = call diag_nl();
            _ => return 0;
        }
        TargetNone: {
            let _ = call diag_str("<anonymous>");
            let _ = call diag_nl();
            _ => return 0;
        }
        TargetNl: {
            let _ = call diag_nl();
            _ => return 0;
        }
    }
}

machine emit_type_diagnostic(
    ctx: *CodegenCtx,
    kind: u32,
    target_p: *u8,
    target_l: u32,
    arg_idx: u32,
    exp_p: *u8,
    exp_l: u32,
    act_p: *u8,
    act_l: u32,
    expr: *ExprNode
) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            let _ = call diag_str("[StateSSA Type Error]: Incompatible type detected!");
            let _ = call diag_nl();

            let _ = call diag_str("  Kind:      ");
            let k_str = call get_diag_kind_str(kind);
            let _ = call diag_str(k_str);
            let _ = call diag_nl();

            let _ = call emit_diag_context(ctx, target_p, target_l, kind, arg_idx);

            let _ = call diag_str("  Expected:  ");
            let _ = call diag_write(exp_p, exp_l);
            let _ = call diag_nl();

            let _ = call diag_str("  Actual:    ");
            let _ = call diag_write(act_p, act_l);
            let _ = call diag_str(" (expression: '");
            let _ = call diag_expr_name(expr);
            let _ = call diag_str("')");
            let _ = call diag_nl();

            let _ = call diag_str("  Fix Hint:  Explicit conversion required. Use 'cast(");
            let _ = call diag_write(exp_p, exp_l);
            let _ = call diag_str(") ");
            let _ = call diag_expr_name(expr);
            let _ = call diag_str("'");
            let _ = call diag_nl();

            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            let _ = call diag_nl();

            ctx.error_code <- -50;
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine validate_type(
    ctx: *CodegenCtx,
    kind: u32,
    target_p: *u8,
    target_l: u32,
    arg_idx: u32,
    exp_p: *u8,
    exp_l: u32,
    act_p: *u8,
    act_l: u32,
    expr: *ExprNode
) -> u32 {
    flow {}
    states {
        Entry: {
            let is_comp = call is_type_compatible(kind, exp_p, exp_l, act_p, act_l, expr);
            is_comp != 0 => RetPass;
            _            => DoDiag;
        }
        DoDiag: {
            let _ = call emit_type_diagnostic(ctx, kind, target_p, target_l, arg_idx, exp_p, exp_l, act_p, act_l, expr);
            _ => RetFail;
        }
        RetPass: {
            _ => return 1;
        }
        RetFail: {
            _ => return 0;
        }
    }
}

machine get_expr_type(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg m: *MachineDef = null;
    }
    states {
        Entry: {
            expr == null => ReturnVoid;
            let m_cur = ctx.cur_machine;
            let k = expr.kind;
            k == 1 => ReturnI32;       // INT
            k == 2 => ReturnU8Ptr;     // STR
            k == 3 => ReturnVoidPtr;   // NULL
            k == 4 => ResolveVar      [ m <= m_cur ]; // VAR
            k == 5 => ResolveBinOp    [ m <= m_cur ]; // BINOP
            k == 6 => ResolveUnOp     [ m <= m_cur ]; // UNOP
            k == 7 => ResolveField    [ m <= m_cur ]; // FIELD
            k == 8 => ResolveCall     [ m <= m_cur ]; // CALL
            k == 9  => ResolveStruct   [ m <= m_cur ]; // STRUCT
            k == 10 => ReturnCastType;                 // CAST
            k == 11 => ReturnQ64;                      // Q64
            _       => ReturnI32;
        }
        ReturnVoid: {
            _ => return "void";
        }
        ReturnI32: {
            _ => return "i32";
        }
        ReturnQ64: {
            _ => return "q64";
        }
        ReturnU8Ptr: {
            _ => return "*u8";
        }
        ReturnVoidPtr: {
            _ => return "*void";
        }
        ResolveVar: {
            let res = call get_var_type(ctx, m, expr.str_ptr, expr.str_len);
            _ => return res;
        }
        ResolveBinOp: {
            let res = call get_binop_type(ctx, expr);
            _ => return res;
        }
        ResolveUnOp: {
            let res = call get_unop_type(ctx, expr);
            _ => return res;
        }
        ResolveField: {
            let res = call get_field_type(ctx, expr);
            _ => return res;
        }
        ResolveCall: {
            let res = call find_func_ret_type(ctx.prog, ctx.alloc, expr.str_ptr, expr.str_len);
            let rl = call strlen(res);
            let is_f64 = call str_eq(res, rl, "f64", 3);
            is_f64 != 0 => ReturnQ64;
            let is_f32 = call str_eq(res, rl, "f32", 3);
            is_f32 != 0 => ReturnQ64;
            _ => return res;
        }
        ResolveStruct: {
            let res = call make_cstr(ctx.alloc, expr.str_ptr, expr.str_len);
            _ => return res;
        }
        ReturnCastType: {
            let res = call make_cstr(ctx.alloc, expr.str_ptr, expr.str_len);
            _ => return res;
        }
    }
}

machine find_state_def(m: *MachineDef, name_p: *u8, name_l: u32) -> *StateDef {
    flow {
        reg cur_s: *StateDef = null;
        wire has_more = cur_s != null;
        wire is_match = call str_eq(cur_s.name_ptr, cur_s.name_len, name_p, name_l);
    }
    states {
        Entry: {
            m == null => NotFound;
            _ => Loop [ cur_s <= m.state_defs ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Next;
        }
        Found: {
            _ => return cur_s;
        }
        Next: {
            _ => Loop [ cur_s <= cur_s.next ];
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine find_let_var_type(ctx: *CodegenCtx, m: *MachineDef, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        reg cur_act: *ActionStmt = null;
    }
    states {
        Entry: {
            m == null => NotFound;
            ctx == null => NotFound;
            ctx.cur_state_p == null => NotFound;

            let s = call find_state_def(m, ctx.cur_state_p, ctx.cur_state_l);
            s == null => NotFound;
            _ => ActionLoop [ cur_act <= s.actions ];
        }
        ActionLoop: {
            cur_act == null => NotFound;
            _               => CheckAction;
        }
        CheckAction: {
            let k = cur_act.kind;
            k != 1 => NextAction; // 1: LET
            let tp = cur_act.target_ptr;
            tp == null => NextAction;
            let tl = cur_act.target_len;
            let is_match = call str_eq(tp, tl, name_p, name_l);
            is_match != 0 => FoundTarget;
            _             => NextAction;
        }
        FoundTarget: {
            let t = call get_expr_type(ctx, cur_act.expr);
            _ => return t;
        }
        NextAction: {
            _ => ActionLoop [ cur_act <= cur_act.next ];
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine get_var_type(ctx: *CodegenCtx, m: *MachineDef, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        reg res_type: *u8 = null;
    }
    states {
        Entry: {
            m == null => CheckGlobalEntity;
            let pt = call find_param_type(ctx, m, name_p, name_l);
            pt != null => Exit [ res_type <= pt ];
            let rt = call find_reg_type(ctx, m, name_p, name_l);
            rt != null => Exit [ res_type <= rt ];
            let wt = call find_wire_type(ctx, m, name_p, name_l);
            wt != null => Exit [ res_type <= wt ];
            let lt = call find_let_var_type(ctx, m, name_p, name_l);
            lt != null => Exit [ res_type <= lt ];
            _          => CheckGlobalEntity;
        }
        CheckGlobalEntity: {
            ctx == null => FailUndefined;
            let prog = ctx.prog;
            prog == null => FailUndefined;
            let mach = call find_machine_in_prog(prog, name_p, name_l);
            mach != null => Exit [ res_type <= "*void" ];
            let ext = call find_extern_in_prog(prog, name_p, name_l);
            ext != null => Exit [ res_type <= "*void" ];
            _ => FailUndefined;
        }
        FailUndefined: {
            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            let _ = call diag_str("COMPILATION ERROR: Undefined variable '");
            let _ = call diag_write(name_p, name_l);
            let _ = call diag_str("'");
            m != null => PrintMachine;
            _ => PrintState;
        }
        PrintMachine: {
            let _ = call diag_str(" in machine '");
            let _ = call diag_write(m.name_ptr, m.name_len);
            let _ = call diag_str("'");
            _ => PrintState;
        }
        PrintState: {
            let sp = ctx.cur_state_p;
            sp != null => PrintStateName;
            _ => EndError;
        }
        PrintStateName: {
            let _ = call diag_str(" state '");
            let _ = call diag_write(ctx.cur_state_p, ctx.cur_state_l);
            let _ = call diag_str("'");
            _ => EndError;
        }
        EndError: {
            let _ = call diag_nl();
            let _ = call diag_str("Deterministic Definition Violation: Every variable must be strictly defined in scope.");
            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            ctx.error_code <- -51;
            _ => Exit [ res_type <= "i32" ];
        }
        Exit: {
            _ => return res_type;
        }
    }
}

machine find_param_idx(m: *MachineDef, name_p: *u8, name_l: u32) -> i32 {
    flow {
        reg i: u32 = 0;
        wire cnt = m.param_count;
        wire has_more = i < cnt;
        wire fld_p = m.params;
        wire p = fld_p + i;
        wire is_match = call str_eq(p.name_ptr, p.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return i;
        }
        NotFound: {
            _ => return -1;
        }
    }
}

machine find_param_type(ctx: *CodegenCtx, m: *MachineDef, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        reg p_idx: i32 = -1;
    }
    states {
        Entry: {
            let idx = call find_param_idx(m, name_p, name_l);
            idx < 0 => ReturnNull;
            _       => ReturnFound [ p_idx <= idx ];
        }
        ReturnFound: {
            let u_idx = cast(u32) p_idx;
            let fld_p = m.params;
            let p = fld_p + u_idx;
            let res = call make_cstr(ctx.alloc, p.type_ptr, p.type_len);
            _ => return res;
        }
        ReturnNull: {
            _ => return null;
        }
    }
}

machine find_reg_type(ctx: *CodegenCtx, m: *MachineDef, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        reg i: u32 = 0;
        wire cnt = m.reg_count;
        wire has_more = i < cnt;
        wire fld_r = m.regs;
        wire r = fld_r + i;
        wire is_match = call str_eq(r.name_ptr, r.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            let res = call make_cstr(ctx.alloc, r.type_ptr, r.type_len);
            _ => return res;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine find_wire(m: *MachineDef, name_p: *u8, name_l: u32) -> *WireDef {
    flow {
        reg i: u32 = 0;
        wire cnt = m.wire_count;
        wire has_more = i < cnt;
        wire fld_w = m.wires;
        wire w = fld_w + i;
        wire is_match = call str_eq(w.name_ptr, w.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return w;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine find_wire_idx(m: *MachineDef, name_p: *u8, name_l: u32) -> i32 {
    flow {
        reg i: u32 = 0;
        wire cnt = m.wire_count;
        wire has_more = i < cnt;
        wire fld_w = m.wires;
        wire w = fld_w + i;
        wire is_match = call str_eq(w.name_ptr, w.name_len, name_p, name_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            let res = cast(i32) i;
            _ => return res;
        }
        NotFound: {
            _ => return -1;
        }
    }
}

machine find_wire_type(ctx: *CodegenCtx, m: *MachineDef, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        reg w_matched: *WireDef = null;
        reg wire_mask: u64 = 0;
    }
    states {
        Entry: {
            let widx = call find_wire_idx(m, name_p, name_l);
            widx < 0 => ReturnNull;
            let u_widx = cast(u64) widx;
            let one64 = cast(u64) 1;
            let mask = one64 << u_widx;
            let in_prog = ctx.wire_in_progress;
            let in_prog_masked = in_prog & mask;
            let is_cyclic = in_prog_masked != 0;
            is_cyclic != 0 => ReturnCycleFallback;

            let next_prog = in_prog | mask;
            ctx.wire_in_progress <- next_prog;
            let w = m.wires + widx;
            _ => ReturnFound [ w_matched <= w, wire_mask <= cast(u64) mask ];
        }
        ReturnCycleFallback: {
            _ => return "i32";
        }
        ReturnFound: {
            let res = call get_expr_type(ctx, w_matched.expr);
            let cur_prog = ctx.wire_in_progress;
            let unmark_prog = cur_prog ^ wire_mask;
            ctx.wire_in_progress <- unmark_prog;
            _ => return res;
        }
        ReturnNull: {
            _ => return null;
        }
    }
}

machine get_binop_type(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg left_t: *u8 = "i32";
        wire op = expr.op;
    }
    states {
        Entry: {
            op == 46 => ReturnI1; // ==
            op == 47 => ReturnI1; // !=
            op == 60 => ReturnI1; // <
            op == 44 => ReturnI1; // <=
            op == 61 => ReturnI1; // >
            op == 48 => ReturnI1; // >=
            op == 50 => ReturnI1; // &&
            op == 49 => ReturnI1; // ||
            op == 62 => CheckBitwiseI1; // &
            op == 63 => CheckBitwiseI1; // |
            op == 64 => CheckBitwiseI1; // ^
            op == 71 => CheckAdd; // +
            op == 72 => CheckSub; // -
            _        => CheckArith;
        }
        CheckSub: {
            let lt = call get_expr_type(ctx, expr.left);
            let c0_l = *lt;
            c0_l != 42 => CheckArith;

            let rt = call get_expr_type(ctx, expr.right);
            let c0_r = *rt;
            c0_r == 42 => ReturnI64; // ptr - ptr => i64
            _          => ReturnLeft [ left_t <= lt ]; // ptr - offset => ptr
        }
        CheckBitwiseI1: {
            let lt = call get_expr_type(ctx, expr.left);
            let is_i1_l = call is_i1_type(lt);
            let rt = call get_expr_type(ctx, expr.right);
            let is_i1_r = call is_i1_type(rt);
            let both_i1 = is_i1_l & is_i1_r;
            both_i1 != 0 => ReturnI1;
            _ => CheckArith;
        }
        ReturnI1: {
            _ => return "i1";
        }
        CheckAdd: {
            let lt = call get_expr_type(ctx, expr.left);
            let c0_is_ptr = *lt;
            let is_ptr = c0_is_ptr == 42;
            is_ptr != 0 => ReturnLeft [ left_t <= lt ];
            _           => CheckArith;
        }
        CheckArith: {
            let lt = call get_expr_type(ctx, expr.left);
            let bdef_l = call find_bounded_type(ctx.prog, lt, call strlen(lt));
            bdef_l != null => ReturnLeft [ left_t <= lt ];

            let rt = call get_expr_type(ctx, expr.right);
            let bdef_r = call find_bounded_type(ctx.prog, rt, call strlen(rt));
            bdef_r != null => ReturnLeft [ left_t <= rt ];

            let is_lfv = call is_type_float_or_vec(lt, call strlen(lt));
            is_lfv != 0 => ReturnLeft [ left_t <= lt ];

            let is_rfv = call is_type_float_or_vec(rt, call strlen(rt));
            is_rfv != 0 => ReturnLeft [ left_t <= rt ];

            let is_lq64 = call is_type_q64(lt);
            is_lq64 != 0 => ReturnQ64;
            let is_rq64 = call is_type_q64(rt);
            is_rq64 != 0 => ReturnQ64;

            let is_l64 = call is_type_64(lt);
            is_l64 != 0 => ReturnI64;
            let is_r64 = call is_type_64(rt);
            is_r64 != 0 => ReturnI64;
            _           => ReturnI32;
        }
        ReturnQ64: {
            _ => return "q64";
        }
        ReturnLeft: {
            _ => return left_t;
        }
        ReturnI64: {
            _ => return "i64";
        }
        ReturnI32: {
            _ => return "i32";
        }
    }
}

machine get_unop_type(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg sub_type: *u8 = "i32";
        wire op = expr.op;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            op == 62 => HandleAddr;  // '&' (token 62)
            op == 70 => HandleDeref; // '*' (token 70)
            _        => HandleOther;
        }
        HandleAddr: {
            let sub_t = call get_expr_type(ctx, expr.left);
            let b_ptr_start = alloc.base_ptr;
            let off_ptr_start = alloc.offset;
            let ptr_start = b_ptr_start + off_ptr_start;
            let _ = call append_char_to_alloc(alloc, 42); // '*'
            let _ = call append_str_to_alloc(alloc, sub_t, call strlen(sub_t));
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return ptr_start;
        }
        HandleDeref: {
            let sub_t = call get_expr_type(ctx, expr.left);
            let c0_is_ptr = *sub_t;
            let is_ptr = c0_is_ptr == 42;
            is_ptr != 0 => StripStar [ sub_type <= sub_t ];
            _           => ReturnI32;
        }
        StripStar: {
            _ => return sub_type + 1;
        }
        ReturnI32: {
            _ => return "i32";
        }
        HandleOther: {
            let sub_t = call get_expr_type(ctx, expr.left);
            _ => return sub_t;
        }
    }
}

machine get_field_type(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg base_type: *u8 = null;
    }
    states {
        Entry: {
            let bt = call get_expr_type(ctx, expr.left);
            let c0_is_ptr = *bt;
            let is_ptr = c0_is_ptr == 42;
            is_ptr != 0 => FromPtrType [ base_type <= bt ];
            _           => FromValType [ base_type <= bt ];
        }
        FromPtrType: {
            let sname = base_type + 1;
            let res = call find_struct_field_type(ctx.prog, ctx.alloc, sname, expr.str_ptr, expr.str_len);
            _ => return res;
        }
        FromValType: {
            let res = call find_struct_field_type(ctx.prog, ctx.alloc, base_type, expr.str_ptr, expr.str_len);
            _ => return res;
        }
    }
}

machine find_struct_def(prog: *ProgramDef, sname_p: *u8, sname_l: u32) -> *TypeDef {
    flow {
        reg i: u32 = 0;
        wire cnt = prog.type_count;
        wire has_more = i < cnt;
        wire fld_t = prog.types;
        wire cur_t = fld_t + i;
        wire is_match = call str_eq(cur_t.name_ptr, cur_t.name_len, sname_p, sname_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return cur_t;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine find_field_idx_in_type(t: *TypeDef, fname_p: *u8, fname_l: u32) -> i32 {
    flow {
        reg i: u32 = 0;
        wire cnt = t.field_count;
        wire has_more = i < cnt;
        wire fld_f = t.fields;
        wire cur_f = fld_f + i;
        wire is_match = call str_eq(cur_f.name_ptr, cur_f.name_len, fname_p, fname_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return cast(i32) i;
        }
        NotFound: {
            _ => return -1;
        }
    }
}

machine find_field_in_type(alloc: *BumpAlloc, t: *TypeDef, fname_p: *u8, fname_l: u32) -> *u8 {
    flow {
        reg res: *u8 = "i32";
    }
    states {
        Entry: {
            let idx = call find_field_idx_in_type(t, fname_p, fname_l);
            idx < 0 => Exit;
            let u_idx = cast(u32) idx;
            let fld_f = t.fields;
            let f = fld_f + u_idx;
            let s = call make_cstr(alloc, f.type_ptr, f.type_len);
            _       => Exit [ res <= s ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine find_struct_field_type(prog: *ProgramDef, alloc: *BumpAlloc, sname_p: *u8, fname_p: *u8, fname_l: u32) -> *u8 {
    flow {
        reg res: *u8 = "i32";
    }
    states {
        Entry: {
            let sl = call strlen(sname_p);
            let t = call find_struct_def(prog, sname_p, sl);
            t == null => Exit;
            let r = call find_field_in_type(alloc, t, fname_p, fname_l);
            _         => Exit [ res <= r ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine find_func_ret_type(prog: *ProgramDef, alloc: *BumpAlloc, name_p: *u8, name_l: u32) -> *u8 {
    flow {
        wire ext = call find_extern_in_prog(prog, name_p, name_l);
        wire mach = call find_machine_in_prog(prog, name_p, name_l);
    }
    states {
        Entry: {
            ext != null  => FromExt;
            mach != null => FromMach;
            _            => DefaultVoid;
        }
        FromExt: {
            let res = call make_cstr(alloc, ext.ret_type_ptr, ext.ret_type_len);
            _ => return res;
        }
        FromMach: {
            let res = call make_cstr(alloc, mach.ret_type_ptr, mach.ret_type_len);
            _ => return res;
        }
        DefaultVoid: {
            _ => return "void";
        }
    }
}

machine is_pointer_add(left_type: *u8, op: u32) -> u32 {
    flow {}
    states {
        Entry: {
            left_type == null => RetZero;
            op != 71          => RetZero; // 71 is '+'
            let c0 = *left_type;
            c0 == 42          => RetOne;  // 42 is '*'
            _                 => RetZero;
        }
        RetOne: {
            _ => return 1;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine is_pointer_diff(left_type: *u8, right_type: *u8, op: u32) -> u32 {
    flow {}
    states {
        Entry: {
            left_type == null  => RetZero;
            right_type == null => RetZero;
            op != 72           => RetZero; // 72 is '-'
            let cl = *left_type;
            cl != 42           => RetZero; // '*'
            let cr = *right_type;
            cr == 42           => RetOne;  // '*'
            _                  => RetZero;
        }
        RetOne: {
            _ => return 1;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine is_pointer_sub_offset(left_type: *u8, right_type: *u8, op: u32) -> u32 {
    flow {}
    states {
        Entry: {
            left_type == null  => RetZero;
            right_type == null => RetZero;
            op != 72           => RetZero; // 72 is '-'
            let cl = *left_type;
            cl != 42           => RetZero; // left must be '*'
            let cr = *right_type;
            cr == 42           => RetZero; // right must NOT be '*'
            _                  => RetOne;
        }
        RetOne: {
            _ => return 1;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine is_pointer_cmp(left_type: *u8, right_type: *u8, op: u32) -> u32 {
    flow {
        wire is_eq = op == 46;
        wire is_ne = op == 47;
        wire is_cmp = is_eq || is_ne;
    }
    states {
        Entry: {
            is_cmp == 0 => RetZero;
            left_type != null => CheckLeft;
            _                 => CheckRight;
        }
        CheckLeft: {
            let cl = *left_type;
            cl == 42 => RetOne;
            _        => CheckRight;
        }
        CheckRight: {
            right_type == null => RetZero;
            let cr = *right_type;
            cr == 42 => RetOne;
            _        => RetZero;
        }
        RetOne: {
            _ => return 1;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine is_i1_type(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => NoMatch;
            let c0 = *t;
            c0 != 105 => NoMatch; // 'i'
            let p1 = t + 1;
            let c1 = *p1;
            c1 != 49  => NoMatch; // '1'
            let p2 = t + 2;
            let c2 = *p2;
            c2 == 0   => Match;
            _         => NoMatch;
        }
        Match:   { _ => return 1; }
        NoMatch: { _ => return 0; }
    }
}

machine is_type_small(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetZero;
            let l = call strlen(t);
            let is_i8 = call str_eq(t, l, "i8", 2);
            is_i8 != 0 => RetOne;
            let is_u8 = call str_eq(t, l, "u8", 2);
            is_u8 != 0 => RetOne;
            let is_i16 = call str_eq(t, l, "i16", 3);
            is_i16 != 0 => RetOne;
            let is_u16 = call str_eq(t, l, "u16", 3);
            is_u16 != 0 => RetOne;
            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine is_unsigned_type(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetZero;
            let l = call strlen(t);
            let is_u8 = call str_eq(t, l, "u8", 2);
            is_u8 != 0 => RetOne;
            let is_u16 = call str_eq(t, l, "u16", 3);
            is_u16 != 0 => RetOne;
            let is_u32 = call str_eq(t, l, "u32", 3);
            is_u32 != 0 => RetOne;
            let is_u64 = call str_eq(t, l, "u64", 3);
            is_u64 != 0 => RetOne;
            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

machine get_struct_field_idx(prog: *ProgramDef, sname_p: *u8, sname_l: u32, fname_p: *u8, fname_l: u32) -> i32 {
    flow {
        reg res: i32 = -1;
    }
    states {
        Entry: {
            let t = call find_struct_def(prog, sname_p, sname_l);
            t == null => Exit;
            let idx = call find_field_idx_in_type(t, fname_p, fname_l);
            _       => Exit [ res <= idx ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine get_struct_field_type_by_idx(prog: *ProgramDef, alloc: *BumpAlloc, sname_p: *u8, sname_l: u32, idx: u32) -> *u8 {
    flow {
        reg res: *u8 = "i32";
    }
    states {
        Entry: {
            let t = call find_struct_def(prog, sname_p, sname_l);
            t == null => Exit;
            let fc = t.field_count;
            let has_fld = idx < fc;
            has_fld == 0 => Exit;
            let fld_f = t.fields;
            let f = fld_f + idx;
            let s = call make_cstr(alloc, f.type_ptr, f.type_len);
            _            => Exit [ res <= s ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine resolve_var_struct_type(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg sname: *u8 = null;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            let stype = call get_expr_type(ctx, expr);
            let c0_is_ptr = *stype;
            let is_ptr = c0_is_ptr == 42;
            is_ptr != 0 => BuildStructType [ sname <= stype + 1 ];
            _           => BuildStructType [ sname <= stype ];
        }
        BuildStructType: {
            let b_s_start = alloc.base_ptr;
            let off_s_start = alloc.offset;
            let s_start = b_s_start + off_s_start;
            let _ = call append_str_to_alloc(alloc, "%struct.", 8);
            let _ = call append_str_to_alloc(alloc, sname, call strlen(sname));
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return s_start;
        }
    }
}

