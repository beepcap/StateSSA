    blocks:      *BasicBlock,
    block_cnt:   u32,

    cur_machine: *MachineDef,
    error_code:  i32,
    cur_state_p: *u8,
    cur_state_l: u32,

    pad_ctx:         u32,
    node_prefix_p:   *u8,
    node_prefix_l:   u32,
    fused_next_bb_p: *u8,
    fused_next_bb_l: u32,
    fused_is_last:   u32,
    fused_ret_cnt:   u32,
    fused_ret_vals:  *RetValEntry,
    fused_prev_type_p: *u8,
    fused_prev_type_l: u32,
    wire_in_progress:  u64
};

machine calc_bb_required_size(s: *StateDef, m: *MachineDef) -> u32 {
    flow {
        reg act_cnt:  u32 = 0;
        reg wire_cnt: u32 = 0;
        reg reg_cnt:  u32 = 0;
        wire base_bytes = 4096;
    }
    states {
        Entry: {
            m == null => Exit;
            s != null => LoadState;
            _         => LoadMachineOnly;
        }
        LoadState: {
            let ac = s.action_count;
            let wc = m.wire_count;
            let rc = m.reg_count;
            _ => Calc [ act_cnt <= ac, wire_cnt <= wc, reg_cnt <= rc ];
        }
        LoadMachineOnly: {
            let wc = m.wire_count;
            let rc = m.reg_count;
            _ => Calc [ act_cnt <= 0, wire_cnt <= wc, reg_cnt <= rc ];
        }
        Calc: {
            let act_bytes = act_cnt * 512;
            let wire_bytes = wire_cnt * 256;
            let reg_bytes = reg_cnt * 128;
            let total = act_bytes + wire_bytes;
            let total2 = total + reg_bytes;
            let total3 = total2 + base_bytes;
            let is_small = total3 < 8192;
            is_small != 0 => MinCap;
            _             => Done [ act_cnt <= total3 ];
        }
        MinCap: {
            _ => return 8192;
        }
        Done: {
            _ => return act_cnt;
        }
        Exit: {
            _ => return 8192;
        }
    }
}

machine calc_branch_bb_size(m: *MachineDef) -> u32 {
    flow {
        wire rc = m.reg_count;
        wire reg_bytes = rc * 128;
        wire total = reg_bytes + 2048;
    }
    states {
        Entry: {
            _ => return total;
        }
    }
}

machine make_prefixed_name(alloc: *BumpAlloc, pfx_p: *u8, pfx_l: u32, name_p: *u8, name_l: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            let b_p = alloc.base_ptr;
            let off = alloc.offset;
            let res_p = b_p + off;
            let _ = call append_str_to_alloc(alloc, pfx_p, pfx_l);
            let _ = call append_char_to_alloc(alloc, 95); // '_'
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return res_p;
        }
    }
}

machine make_fused_reg_name(alloc: *BumpAlloc, nid_p: *u8, nid_l: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            let b_p = alloc.base_ptr;
            let off = alloc.offset;
            let res_p = b_p + off;
            let _ = call append_char_to_alloc(alloc, 37); // '%'
            let _ = call append_str_to_alloc(alloc, nid_p, nid_l);
            let _ = call append_str_to_alloc(alloc, "_res", 4);
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return res_p;
        }
    }
}

machine add_basic_block(ctx: *CodegenCtx, name_p: *u8, name_l: u32, s_idx: i32, cap: u32) -> *BasicBlock {
    flow {
        wire alloc = ctx.alloc;
        wire idx = ctx.block_cnt;
        wire blks = ctx.blocks;
        wire bb = blks + idx;
        wire next_cnt = idx + 1;
        wire pfx_p = ctx.node_prefix_p;
        wire pfx_l = ctx.node_prefix_l;
    }
    states {
        Entry: {
            pfx_p != null => WithPrefix;
            _             => NoPrefix;
        }
        WithPrefix: {
            let full_p = call make_prefixed_name(alloc, pfx_p, pfx_l, name_p, name_l);
            let full_l = call strlen(full_p);
            let buf = call bump_alloc(alloc, cap, 8);
            let ret_bb = bb;
            ret_bb.name_ptr   <- full_p;
            ret_bb.name_len   <- full_l;
            ret_bb.state_idx  <- s_idx;
            ret_bb.buf_ptr    <- buf;
            ret_bb.buf_pos    <- 0;
            ret_bb.buf_cap    <- cap;
            ctx.block_cnt     <- next_cnt;
            _ => return ret_bb;
        }
        NoPrefix: {
            let buf = call bump_alloc(alloc, cap, 8);
            let ret_bb = bb;
            ret_bb.name_ptr   <- name_p;
            ret_bb.name_len   <- name_l;
            ret_bb.state_idx  <- s_idx;
            ret_bb.buf_ptr    <- buf;
            ret_bb.buf_pos    <- 0;
            ret_bb.buf_cap    <- cap;
            ctx.block_cnt     <- next_cnt;
            _ => return ret_bb;
        }
    }
}

machine switch_to_bb(ctx: *CodegenCtx, bb: *BasicBlock) -> u32 {
    flow {}
    states {
        Entry: {
            ctx.out_buf <- bb.buf_ptr;
            ctx.out_pos <- bb.buf_pos;
            ctx.max_len <- bb.buf_cap;
            _ => return 0;
        }
    }
}

machine finish_cur_bb(ctx: *CodegenCtx, bb: *BasicBlock) -> u32 {
    flow {}
    states {
        Entry: {
            bb.buf_pos <- ctx.out_pos;
            _ => return bb.buf_pos;
        }
    }
}

machine emit_char(ctx: *CodegenCtx, c: u32) -> u32 {
    flow {
        wire pos = ctx.out_pos;
        wire max = ctx.max_len;
        wire ok = pos < max;
        wire buf = ctx.out_buf;
        wire c_byte = c & 255;
    }
    states {
        Entry: {
            ok != 0 => StoreChar;
            _       => Done;
        }
        StoreChar: {
            *(buf + pos) <- c_byte;
            ctx.out_pos <- pos + 1;
            _ => Done;
        }
        Done: {
            _ => return ctx.out_pos;
        }
    }
}

machine emit_str(ctx: *CodegenCtx, s: *u8, len: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire has_more = i < len;
        wire next_i = i + 1;
        wire cur_s = s + i;
        wire ch = *cur_s;
    }
    states {
        Entry: {
            len == 0 => Exit;
            _        => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitOne;
            _             => Exit;
        }
        EmitOne: {
            let _ = call emit_char(ctx, ch);
            _ => Loop [ i <= next_i ];
        }
        Exit: {
            let out_p = ctx.out_pos;
            _ => return out_p;
        }
    }
}

machine emit_nl(ctx: *CodegenCtx) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call emit_char(ctx, 10); // '\n'
            let out_p = ctx.out_pos;
            _ => return out_p;
        }
    }
}

machine emit_u64(ctx: *CodegenCtx, val: i64) -> u32 {
    flow {
        reg v: i64 = 0;
        reg count: u32 = 0;
        wire is_zero = v == 0;
        wire next_v = v / 10;
        wire mul10 = next_v * 10;
        wire digit = v - mul10;
        wire dig_u8 = cast(u8) (digit + 48);
    }
    states {
        Entry: {
            val == 0 => Zero;
            _        => PushDigits [ v <= val, count <= 0 ];
        }
        Zero: {
            let _ = call emit_char(ctx, 48); // '0'
            _ => Exit;
        }
        PushDigits: {
            is_zero != 0 => PopDigits;
            _            => StepPush;
        }
        StepPush: {
            let alloc = ctx.alloc;
            let b = alloc.base_ptr;
            let off = alloc.offset;
            let p = b + off;
            let next_off = off + 1;
            alloc.offset <- next_off;
            *p <- dig_u8;
            let next_cnt = count + 1;
            _ => PushDigits [ v <= next_v, count <= next_cnt ];
        }
        PopDigits: {
            count == 0 => Exit;
            _          => StepPop;
        }
        StepPop: {
            let alloc = ctx.alloc;
            let off = alloc.offset;
            let prev_off = off - 1;
            alloc.offset <- prev_off;
            let b = alloc.base_ptr;
            let p = b + prev_off;
            let ch = *p;
            let _ = call emit_char(ctx, ch);
            let prev_cnt = count - 1;
            _ => PopDigits [ count <= prev_cnt ];
        }
        Exit: {
            let out_p = ctx.out_pos;
            _ => return out_p;
        }
    }
}

machine emit_u32(ctx: *CodegenCtx, val: u32) -> u32 {
    flow {}
    states {
        Entry: {
            let v64 = cast(i64) val;
            let res = call emit_u64(ctx, v64);
            _       => return res;
        }
    }
}

machine emit_i64(ctx: *CodegenCtx, val: i64) -> u32 {
    flow {
        wire is_min = val == -9223372036854775808;
        wire is_neg = val < 0;
    }
    states {
        Entry: {
            is_min != 0 => EmitMin;
            is_neg != 0 => EmitMinus;
            _           => EmitPositive;
        }
        EmitMin: {
            let _ = call emit_str(ctx, "-9223372036854775808", 20);
            _ => Exit;
        }
        EmitMinus: {
            let _ = call emit_char(ctx, 45); // '-'
            let pos_val = 0 - val;
            let _ = call emit_u64(ctx, pos_val);
            _ => Exit;
        }
        EmitPositive: {
            let _ = call emit_u64(ctx, val);
            _ => Exit;
        }
        Exit: {
            let out_p = ctx.out_pos;
            _ => return out_p;
        }
    }
}

machine fresh_tmp_str(ctx: *CodegenCtx, prefix_ptr: *u8, prefix_len: u32) -> *u8 {
    flow {
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            ctx.tmp_id <- ctx.tmp_id + 1;
            let cur_id = ctx.tmp_id;

            // バンプアロケータ上に "%prefix_id\0" 文字列を作成
            let b_start_p = alloc.base_ptr;
            let off_start_p = alloc.offset;
            let start_p = b_start_p + off_start_p;
            let _ = call append_char_to_alloc(alloc, 37); // '%'
            let _ = call append_str_to_alloc(alloc, prefix_ptr, prefix_len);
            let _ = call append_char_to_alloc(alloc, 95); // '_'
            let _ = call append_u32_to_alloc(alloc, cur_id);
            let _ = call append_char_to_alloc(alloc, 0);  // '\0'

            _ => return start_p;
        }
    }
}

machine append_char_to_alloc(alloc: *BumpAlloc, c: u32) -> u32 {
    flow {
        wire b_p = alloc.base_ptr;
        wire off_p = alloc.offset;
        wire cap = alloc.capacity;
        wire next_off = off_p + 1;
        wire is_overflow = next_off > cap;
        wire p = b_p + off_p;
    }
    states {
        Entry: {
            is_overflow != 0 => OverflowTrap;
            _                => AppendChar;
        }
        AppendChar: {
            *p <- c & 255;
            alloc.offset <- next_off;
            _ => return next_off;
        }
        OverflowTrap: {
            let _ = call write(2, "fatal error: BumpAlloc arena capacity overflow in append_char_to_alloc\n", 71);
            _ => panic(1);
        }
    }
}

machine append_str_to_alloc(alloc: *BumpAlloc, s: *u8, len: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire has_more = i < len;
        wire b_p = alloc.base_ptr;
        wire off_p = alloc.offset;
        wire cap = alloc.capacity;
        wire next_off = off_p + len;
        wire is_overflow = next_off > cap;
        wire p = b_p + off_p;
        wire ptr_ch = s + i;
        wire ch = *ptr_ch;
    }
    states {
        Entry: {
            is_overflow != 0 => OverflowTrap;
            _                => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => Step;
            _             => Exit;
        }
        Step: {
            *(p + i) <- ch;
            _ => Loop [ i <= i + 1 ];
        }
        Exit: {
            alloc.offset <- next_off;
            _ => return next_off;
        }
        OverflowTrap: {
            let _ = call write(2, "fatal error: BumpAlloc arena capacity overflow in append_str_to_alloc\n", 70);
            _ => panic(1);
        }
    }
}

machine append_u64_to_alloc(alloc: *BumpAlloc, val: i64) -> u32 {
    flow {
        reg v: i64 = 0;
        reg cnt: u32 = 0;
        wire is_zero = v == 0;
        wire next_v = v / 10;
        wire mul10 = next_v * 10;
        wire digit = v - mul10;
        wire dig_u8 = cast(u8) (digit + 48);
    }
    states {
        Entry: {
            val == 0 => EmitZero;
            _        => Push [ v <= val, cnt <= 0 ];
        }
        EmitZero: {
            let _ = call append_char_to_alloc(alloc, 48);
            _ => Exit;
        }
        Push: {
            is_zero != 0 => Pop;
            _            => DoPush;
        }
        DoPush: {
            let b_p = alloc.base_ptr;
            let off_p = alloc.offset;
            let p = b_p + off_p;
            *p <- dig_u8;
            let next_off = off_p + 1;
            alloc.offset <- next_off;
            let next_cnt = cnt + 1;
            _ => Push [ v <= next_v, cnt <= next_cnt ];
        }
        Pop: {
            let _ = call reverse_alloc_bytes(alloc, cnt);
            _ => Exit;
        }
        Exit: {
            let off_ret = alloc.offset;
            _ => return off_ret;
        }
    }
}

machine append_u32_to_alloc(alloc: *BumpAlloc, val: u32) -> u32 {
    flow {}
    states {
        Entry: {
            let v64 = cast(i64) val;
            let res = call append_u64_to_alloc(alloc, v64);
            _       => return res;
        }
    }
}

machine append_i64_to_alloc(alloc: *BumpAlloc, val: i64) -> u32 {
    flow {
        wire is_min = val == -9223372036854775808;
        wire is_neg = val < 0;
    }
    states {
        Entry: {
            is_min != 0 => Min;
            is_neg != 0 => Neg;
            _           => Pos;
        }
        Min: {
            let _ = call append_str_to_alloc(alloc, "-9223372036854775808", 20);
            _ => Exit;
        }
        Neg: {
            let _ = call append_char_to_alloc(alloc, 45); // '-'
            let pos_val = 0 - val;
            let _ = call append_u64_to_alloc(alloc, pos_val);
            _ => Exit;
        }
        Pos: {
            let _ = call append_u64_to_alloc(alloc, val);
            _ => Exit;
        }
        Exit: {
            let off_ret = alloc.offset;
            _ => return off_ret;
        }
    }
}

machine reverse_alloc_bytes(alloc: *BumpAlloc, cnt: u32) -> u32 {
    flow {
        reg l: u32 = 0;
        reg r: u32 = 0;
        wire has_swap = l < r;
        wire b = alloc.base_ptr;
        wire off = alloc.offset;
        wire off_sub = off - cnt;
        wire start_p = b + off_sub;
    }
    states {
        Entry: {
            cnt <= 1 => Exit;
            _        => Loop [ l <= 0, r <= cnt - 1 ];
        }
        Loop: {
            has_swap != 0 => Swap;
            _             => Exit;
        }
        Swap: {
            let ptr_c_l = start_p + l;
            let c_l = *ptr_c_l;
            let ptr_c_r = start_p + r;
            let c_r = *ptr_c_r;
            *(start_p + l) <- c_r;
            *(start_p + r) <- c_l;
            _ => Loop [ l <= l + 1, r <= r - 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine str_eq(s1: *u8, len1: u32, s2: *u8, len2: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire len_match = len1 == len2;
        wire has_more = i < len1;
        wire ptr_c1 = s1 + i;
        wire c1 = *ptr_c1;
        wire ptr_c2 = s2 + i;
        wire c2 = *ptr_c2;
        wire char_match = c1 == c2;
    }
    states {
        Entry: {
            len_match == 0 => NoMatch;
            len1 == 0      => Match;
            _              => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0   => Match;
            char_match == 0 => NoMatch;
            _               => Loop [ i <= i + 1 ];
        }
        Match: { _ => return 1; }
        NoMatch: { _ => return 0; }
    }
}

machine strlen(s: *u8) -> u32 {
    flow {
        reg i: u32 = 0;
        wire ptr_c = s + i;
        wire c = *ptr_c;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            c == 0 => Exit;
            _      => Loop [ i <= i + 1 ];
        }
        Exit: {
            _ => return i;
        }
    }
}

machine str_starts_with(s: *u8, s_len: u32, prefix: *u8, p_len: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire has_space = s_len >= p_len;
        wire has_more = i < p_len;
        wire c1 = *(s + i);
        wire c2 = *(prefix + i);
        wire match_char = c1 == c2;
    }
    states {
        Entry: {
            has_space == 0 => NoMatch;
            p_len == 0     => Match;
            _              => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0    => Match;
            match_char == 0  => NoMatch;
            _                => Loop [ i <= i + 1 ];
        }
        Match:   { _ => return 1; }
        NoMatch: { _ => return 0; }
    }
}

machine str_contains(s: *u8, s_len: u32, sub: *u8, sub_len: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire can_fit = (i + sub_len) <= s_len;
    }
    states {
        Entry: {
            sub_len == 0    => Match;
            s_len < sub_len => NoMatch;
            _ => CheckLoop [ i <= 0 ];
        }
        CheckLoop: {
            can_fit == 0 => NoMatch;
            let cur_p = s + i;
            let m = call str_starts_with(cur_p, s_len - i, sub, sub_len);
            m != 0 => Match;
            _ => CheckLoop [ i <= i + 1 ];
        }
        Match:   { _ => return 1; }
        NoMatch: { _ => return 0; }
    }
}

machine get_type_align_str(type_p: *u8, type_l: u32) -> *u8 {
    flow {
        wire has_double = call str_contains(type_p, type_l, "double", 6);
        wire has_i64    = call str_contains(type_p, type_l, "i64", 3);
        wire is_8       = has_double | has_i64;

        wire has_float  = call str_contains(type_p, type_l, "float", 5);
        wire has_i32    = call str_contains(type_p, type_l, "i32", 3);
        wire is_4       = has_float | has_i32;

        wire has_i16    = call str_contains(type_p, type_l, "i16", 3);
    }
    states {
        Entry: {
            is_8 != 0 => Ret8;
            is_4 != 0 => Ret4;
            has_i16 != 0 => Ret2;
            _ => Ret1;
        }
        Ret8: { _ => return "8"; }
        Ret4: { _ => return "4"; }
        Ret2: { _ => return "2"; }
        Ret1: { _ => return "1"; }
    }
}

machine is_type_float_or_vec(type_p: *u8, type_l: u32) -> u32 {
    flow {
        wire has_float = call str_contains(type_p, type_l, "float", 5);
        wire has_double = call str_contains(type_p, type_l, "double", 6);
        wire is_f32 = call str_eq(type_p, type_l, "f32", 3);
        wire is_f64 = call str_eq(type_p, type_l, "f64", 3);
        wire has_vec = call str_starts_with(type_p, type_l, "<", 1);
        wire has_vec_f32 = call str_starts_with(type_p, type_l, "f32x", 4);
        wire has_vec_f64 = call str_starts_with(type_p, type_l, "f64x", 4);
        wire has_vec_i32 = call str_starts_with(type_p, type_l, "i32x", 4);
        wire has_vec_u8  = call str_starts_with(type_p, type_l, "u8x", 3);
        wire fp_1 = has_float | has_double;
        wire fp_2 = is_f32 | is_f64;
        wire is_fp = fp_1 | fp_2;

        wire v_1 = has_vec | has_vec_f32;
        wire v_2 = has_vec_f64 | has_vec_i32;
        wire v_12 = v_1 | v_2;
        wire is_vec = v_12 | has_vec_u8;
        wire res = is_fp | is_vec;
    }
    states {
        Entry: {
            _ => return res;
        }
    }
}

machine is_type_vector_mask(type_p: *u8, type_l: u32) -> u32 {
    flow {
        wire starts_angle = call str_starts_with(type_p, type_l, "<", 1);
        wire has_i1 = call str_contains(type_p, type_l, "x i1>", 5);
        wire res = starts_angle & has_i1;
    }
    states {
        Entry: {
            _ => return res;
        }
    }
}

machine make_cstr(alloc: *BumpAlloc, ptr: *u8, len: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            let b_start = alloc.base_ptr;
            let off_start = alloc.offset;
            let start = b_start + off_start;
            let _ = call append_str_to_alloc(alloc, ptr, len);
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return start;
        }
    }
}

machine env_set(ctx: *CodegenCtx, var_p: *u8, var_l: u32, ssa_p: *u8, ssa_l: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire cnt = ctx.cur_env_cnt;
        wire has_more = i < cnt;
        wire fld_entry = ctx.cur_env;
        wire entry = fld_entry + i;
        wire is_match = call str_eq(entry.var_ptr, entry.var_len, var_p, var_l);
    }
    states {
        Entry: {
            _ => SearchLoop [ i <= 0 ];
        }
        SearchLoop: {
            has_more == 0 => AddNew;
            is_match != 0 => Update;
            _             => SearchLoop [ i <= i + 1 ];
        }
        Update: {
            entry.ssa_ptr <- ssa_p;
            entry.ssa_len <- ssa_l;
            _ => return cnt;
        }
        AddNew: {
            let fld_new_entry = ctx.cur_env;
            let new_entry = fld_new_entry + cnt;
            new_entry.var_ptr <- var_p;
            new_entry.var_len <- var_l;
            new_entry.ssa_ptr <- ssa_p;
            new_entry.ssa_len <- ssa_l;
            ctx.cur_env_cnt <- cnt + 1;
            _ => return ctx.cur_env_cnt;
        }
    }
}

machine find_env_entry(ctx: *CodegenCtx, var_p: *u8, var_l: u32) -> *EnvEntry {
    flow {
        reg i: u32 = 0;
        wire cnt = ctx.cur_env_cnt;
        wire has_more = i < cnt;
        wire fld_entry = ctx.cur_env;
        wire cur_entry = fld_entry + i;
        wire is_match = call str_eq(cur_entry.var_ptr, cur_entry.var_len, var_p, var_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return cur_entry;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine env_get_ptr(ctx: *CodegenCtx, var_p: *u8, var_l: u32) -> *u8 {
    flow {
        reg e_matched: *EnvEntry = null;
    }
    states {
        Entry: {
            let e = call find_env_entry(ctx, var_p, var_l);
            e == null => ReturnNull;
            _         => ReturnFound [ e_matched <= e ];
        }
        ReturnFound: {
            let p = e_matched.ssa_ptr;
            _ => return p;
        }
        ReturnNull: {
            _ => return null;
        }
    }
}

machine env_get_len(ctx: *CodegenCtx, var_p: *u8, var_l: u32) -> u32 {
    flow {
        reg e_matched: *EnvEntry = null;
    }
    states {
        Entry: {
            let e = call find_env_entry(ctx, var_p, var_l);
            e == null => ReturnZero;
            _         => ReturnFound [ e_matched <= e ];
        }
        ReturnFound: {
            let l = e_matched.ssa_len;
            _ => return l;
        }
        ReturnZero: {
            _ => return 0;
        }
    }
}

machine record_phi_incoming(ctx: *CodegenCtx, s_idx: u32, r_idx: u32, from_bb_p: *u8, from_bb_l: u32, val_p: *u8, val_l: u32) -> u32 {
    flow {
        wire cnt = ctx.phi_cnt;
        wire fld_entry = ctx.phi_entries;
        wire entry = fld_entry + cnt;
    }
    states {
        Entry: {
            entry.state_idx <- s_idx;
            entry.reg_idx   <- r_idx;
            entry.from_bb_p <- from_bb_p;
            entry.from_bb_l <- from_bb_l;
            entry.val_p     <- val_p;
            entry.val_l     <- val_l;
            ctx.phi_cnt <- cnt + 1;
            _ => return ctx.phi_cnt;
        }
    }
}

