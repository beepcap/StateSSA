machine emit_header(ctx: *CodegenCtx) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call emit_str(ctx, "; Generated by StateSSA Compiler (ssac)", 39);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "target datalayout = ", 20);
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_str(ctx, "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128", 79);
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "target triple = ", 16);
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_str(ctx, "x86_64-pc-linux-gnu", 19);
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_nl(ctx);
            let _ = call emit_nl(ctx);
            _ => return ctx.out_pos;
        }
    }
}

machine emit_all_types(ctx: *CodegenCtx) -> u32 {
    flow {
        reg t_idx: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.type_count;
        wire has_more = t_idx < cnt;
        wire fld_t_ptr = prog.types;
        wire t_ptr = fld_t_ptr + t_idx;
    }
    states {
        Entry: {
            _ => Loop [ t_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => ProcessOne;
            _             => Done;
        }
        ProcessOne: {
            // エイリアス型なら構造体定義はスキップ (codegen.py L29-36)
            let f_cnt = t_ptr.field_count;
            f_cnt == 1 => CheckAlias;
            _          => EmitStruct;
        }
        CheckAlias: {
            let f0 = t_ptr.fields;
            let f0_nl = f0.name_len;
            f0_nl == 0 => SkipAlias;
            _          => EmitStruct;
        }
        SkipAlias: {
            _ => NextIter;
        }
        EmitStruct: {
            let _ = call emit_str(ctx, "%struct.", 8);
            let _ = call emit_str(ctx, t_ptr.name_ptr, t_ptr.name_len);
            let _ = call emit_str(ctx, " = type { ", 10);

            let _ = call emit_struct_fields(ctx, t_ptr);
            let _ = call emit_str(ctx, " }", 2);
            let _ = call emit_nl(ctx);
            _ => NextIter;
        }
        NextIter: {
            _ => Loop [ t_idx <= t_idx + 1 ];
        }
        Done: {
            cnt != 0 => EmitTrailNl;
            _        => Exit;
        }
        EmitTrailNl: {
            let _ = call emit_nl(ctx);
            _ => Exit;
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine emit_struct_fields(ctx: *CodegenCtx, t: *TypeDef) -> u32 {
    flow {
        reg f_idx: u32 = 0;
        wire cnt = t.field_count;
        wire has_more = f_idx < cnt;
        wire fld_f_ptr = t.fields;
        wire f_ptr = fld_f_ptr + f_idx;
        wire is_first = f_idx == 0;
    }
    states {
        Entry: {
            _ => Loop [ f_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitField;
            _             => Exit;
        }
        EmitField: {
            is_first == 0 => EmitComma;
            _             => EmitType;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitType;
        }
        EmitType: {
            let mapped_p = call map_type_ptr(ctx, f_ptr.type_ptr, f_ptr.type_len);
            let mapped_l = call map_type_len(ctx, f_ptr.type_ptr, f_ptr.type_len);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            _ => Loop [ f_idx <= f_idx + 1 ];
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine emit_all_externs(ctx: *CodegenCtx) -> u32 {
    flow {
        reg e_idx: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.extern_count;
        wire has_more = e_idx < cnt;
        wire fld_ext = prog.externs;
        wire ext = fld_ext + e_idx;
    }
    states {
        Entry: {
            _ => Loop [ e_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitOne;
            _             => Done;
        }
        EmitOne: {
            let _ = call emit_str(ctx, "declare ", 8);
            let ret_p = call map_type_ptr(ctx, ext.ret_type_ptr, ext.ret_type_len);
            let ret_l = call map_type_len(ctx, ext.ret_type_ptr, ext.ret_type_len);
            let _ = call emit_str(ctx, ret_p, ret_l);
            let _ = call emit_str(ctx, " @", 2);
            let _ = call emit_str(ctx, ext.name_ptr, ext.name_len);
            let _ = call emit_char(ctx, 40); // '('

            let _ = call emit_extern_params(ctx, ext);

            let _ = call emit_char(ctx, 41); // ')'
            let _ = call emit_nl(ctx);
            _ => Loop [ e_idx <= e_idx + 1 ];
        }
        Done: {
            cnt != 0 => EmitTrap;
            _        => Exit;
        }
        EmitTrap: {
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "declare void @llvm.trap() cold noreturn nounwind", 48);
            let _ = call emit_nl(ctx);
            let _ = call emit_nl(ctx);
            _ => Exit;
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine emit_extern_params(ctx: *CodegenCtx, ext: *ExternFn) -> u32 {
    flow {
        reg p_idx: u32 = 0;
        wire cnt = ext.param_count;
        wire has_more = p_idx < cnt;
        wire fld_p = ext.params;
        wire p = fld_p + p_idx;
        wire is_first = p_idx == 0;
    }
    states {
        Entry: {
            _ => Loop [ p_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitParam;
            _             => Exit;
        }
        EmitParam: {
            is_first == 0 => EmitComma;
            _             => EmitType;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitType;
        }
        EmitType: {
            let mapped_p = call map_type_ptr(ctx, p.type_ptr, p.type_len);
            let mapped_l = call map_type_len(ctx, p.type_ptr, p.type_len);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            _ => Loop [ p_idx <= p_idx + 1 ];
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine collect_string_const(ctx: *CodegenCtx, val_ptr: *u8, val_len: u32) -> u32 {
    flow {
        wire cnt = ctx.string_cnt;
        wire fld_entry = ctx.strings;
        wire entry = fld_entry + cnt;
    }
    states {
        Entry: {
            let res_id = ctx.str_id + 1;
            ctx.str_id <- res_id;
            entry.sym_id   <- res_id;
            entry.val_ptr  <- val_ptr;
            entry.val_len  <- val_len;
            entry.byte_len <- val_len + 1; // null終端含む
            ctx.string_cnt <- cnt + 1;
            _ => return res_id;
        }
    }
}

machine emit_all_strings(ctx: *CodegenCtx) -> u32 {
    flow {
        reg i: u32 = 0;
        wire cnt = ctx.string_cnt;
        wire has_more = i < cnt;
        wire fld_entry = ctx.strings;
        wire entry = fld_entry + i;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitOne;
            _             => Done;
        }
        EmitOne: {
            // @.str_X = private unnamed_addr constant [L x i8] c"STR\00", align 1
            let _ = call emit_str(ctx, "@.str_", 6);
            let _ = call emit_u32(ctx, entry.sym_id);
            let _ = call emit_str(ctx, " = private unnamed_addr constant [", 34);
            let _ = call emit_u32(ctx, entry.byte_len);
            let _ = call emit_str(ctx, " x i8] c", 8);
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_str(ctx, entry.val_ptr, entry.val_len);
            let _ = call emit_char(ctx, 92); // '\\'
            let _ = call emit_char(ctx, 48); // '0'
            let _ = call emit_char(ctx, 48); // '0'
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_str(ctx, ", align 1", 9);
            let _ = call emit_nl(ctx);
            _ => Loop [ i <= i + 1 ];
        }
        Done: {
            cnt != 0 => EmitTrailNl;
            _        => Exit;
        }
        EmitTrailNl: {
            let _ = call emit_nl(ctx);
            _ => Exit;
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine emit_all_machines(ctx: *CodegenCtx) -> u32 {
    flow {
        reg m_idx: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.machine_count;
        wire has_more = m_idx < cnt;
        wire fld_m = prog.machines;
        wire m = fld_m + m_idx;
    }
    states {
        Entry: {
            _ => Loop [ m_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => ProcessOne;
            _             => Exit;
        }
        ProcessOne: {
            let _ = call emit_machine(ctx, m);
            _ => Loop [ m_idx <= m_idx + 1 ];
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine ssac_codegen(prog: *ProgramDef, alloc_obj: *BumpAlloc, out_buf: *u8, max_len: u32) -> i32 {
    flow {
        reg res: i32 = 0;
    }
    states {
        Entry: {
            let ctx = call alloc_codegen_context();
            ctx.prog         <- prog;
            ctx.alloc        <- alloc_obj;
            ctx.out_buf      <- out_buf;
            ctx.out_pos      <- 0;
            ctx.max_len      <- max_len;
            ctx.main_buf     <- out_buf;
            ctx.main_pos     <- 0;
            ctx.main_cap     <- max_len;
            ctx.tmp_id       <- 0;
            ctx.str_id       <- 0;
            ctx.type_map_cnt <- 0;
            ctx.string_cnt   <- 0;
            ctx.cur_env_cnt  <- 0;
            ctx.phi_cnt      <- 0;
            ctx.block_cnt    <- 0;
            ctx.error_code   <- 0;
            ctx.cur_state_p  <- null;
            ctx.cur_state_l  <- 0;

            // バッファ確保 (大容量アリーナから安全に切り出し)
            let type_map_mem = call bump_alloc(alloc_obj, 65536, 8);
            let string_mem   = call bump_alloc(alloc_obj, 65536, 8);
            let env_mem      = call bump_alloc(alloc_obj, 65536, 8);
            let phi_mem      = call bump_alloc(alloc_obj, 262144, 8);
            let blocks_mem   = call bump_alloc(alloc_obj, 262144, 8);

            ctx.type_map    <- type_map_mem;
            ctx.strings     <- string_mem;
            ctx.cur_env     <- env_mem;
            ctx.phi_entries <- phi_mem;
            ctx.blocks      <- blocks_mem;

            // 1. 型レジストリ初期化 (エイリアス展開含む)
            let _ = call init_type_registry(ctx);

            // 2. LLVM IR ヘッダ
            let _ = call emit_header(ctx);

            // 3. 型定義出力 (エイリアスは除外)
            let _ = call emit_all_types(ctx);

            // 4. 外部関数宣言出力
            let _ = call emit_all_externs(ctx);

            ctx.main_pos <- ctx.out_pos;

            // 5. 各マシン出力
            let _ = call emit_all_machines(ctx);

            // 6. 文字列定数出力
            ctx.out_buf <- ctx.main_buf;
            ctx.out_pos <- ctx.main_pos;
            ctx.max_len <- ctx.main_cap;
            let _ = call emit_all_strings(ctx);

            let err = ctx.error_code;
            let pos = ctx.out_pos;
            err != 0 => Exit [ res <= err ];
            _        => Exit [ res <= pos ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine alloc_codegen_context() -> *CodegenCtx {
    flow {}
    states {
        Entry: {
            let mem = call malloc(256);
            _ => return mem;
        }
    }
}

machine calc_compiler_required_memory(src_len: u32) -> u32 {
    flow {
        wire scaled    = src_len * 500;
        wire estimated = scaled + 1048576;
        wire is_small  = estimated < 2097152;
    }
    states {
        Entry: {
            is_small != 0 => MinCap;
            _             => CalcCap;
        }
        MinCap: {
            _ => return 2097152; // 2MB
        }
        CalcCap: {
            _ => return estimated;
        }
    }
}

machine ssac_compile_source(src_ptr: *u8, src_len: u32, out_buf: *u8, max_len: u32) -> i32 {
    flow {
        reg root_ptr:  *u8 = null;
        reg ret_code:  i32 = 0;
        reg tok_mem:   *u8 = null;
        reg tok_cnt:   u32 = 0;
        reg prog_ptr:  *ProgramDef = null;
        reg alloc_obj: *BumpAlloc = null;

        wire total_mem = call calc_compiler_required_memory(src_len);
        wire alloc_mem = call malloc(16);
    }
    states {
        Entry: {
            // 【一括確保】静的算定した総メモリ量を一発 malloc
            let mem = call malloc(total_mem);
            let alloc = call bump_init(alloc_mem, mem, total_mem);

            // トークン配列をアリーナから切り出し (最大 src_len + 1024 トークン, 1トークン 32B)
            let max_toks = src_len + 1024;
            let tok_bytes = max_toks * 32;
            let t_mem = call bump_alloc(alloc, tok_bytes, 8);

            // ProgramDef をアリーナから切り出し (64B)
            let p_mem = call bump_alloc(alloc, 64, 8);

            // 1. Lexer
            let num_toks = call ssac_tokenize(src_ptr, src_len, t_mem, max_toks);
            num_toks < 0 => LexError [ root_ptr <= mem, ret_code <= -10 ];
            _            => DoParse  [ root_ptr <= mem, tok_mem <= t_mem, tok_cnt <= num_toks, prog_ptr <= p_mem, alloc_obj <= alloc ];
        }

        DoParse: {
            // 2. Parser
            let ret_p = call ssac_parse(tok_mem, tok_cnt, alloc_obj, prog_ptr);
            ret_p != 0 => ParseError [ ret_code <= ret_p ];
            _          => DoCodegen;
        }

        DoCodegen: {
            // 3. Codegen (ゼロコピーで大容量アリーナを渡す)
            let ret_cg = call ssac_codegen(prog_ptr, alloc_obj, out_buf, max_len);
            _ => CleanUp [ ret_code <= ret_cg ];
        }

        LexError: {
            _ => CleanUp;
        }

        ParseError: {
            _ => CleanUp;
        }

        CleanUp: {
            // 【一括解放】コンパイル終了時に唯一の free
            let _ = call free(root_ptr);
            let _ = call free(alloc_mem);
            _ => return ret_code;
        }
    }
}

