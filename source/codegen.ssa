};

type PhiIncomingEntry = {
    state_idx:  u32,
    reg_idx:    u32,
    from_bb_p:  *u8,
    from_bb_l:  u32,
    val_p:      *u8,
    val_l:      u32
};

type ArgValSlot = {
    val_ptr: *u8
};

type StringConstEntry = {
    sym_id:   u32,
