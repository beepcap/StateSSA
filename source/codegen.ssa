machine emit_header(ctx: *CodegenCtx) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call emit_str(ctx, "; Generated by StateSSA Compiler (ssac)", 39);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "target datalayout = ", 20);
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_str(ctx, "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128", 79);
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "target triple = ", 16);
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_str(ctx, "x86_64-pc-linux-gnu", 19);
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_nl(ctx);
            let _ = call emit_nl(ctx);
            _ => return ctx.out_pos;
        }
    }
}

machine emit_one_type_def(ctx: *CodegenCtx, t_ptr: *TypeDef) -> u32 {
    flow {}
    states {
        Entry: {
            t_ptr.kind != 0 => Skip;
            let f_cnt = t_ptr.field_count;
            f_cnt == 1 => CheckAlias;
            _          => EmitStruct;
        }
        CheckAlias: {
            let f0 = t_ptr.fields;
            let f0_nl = f0.name_len;
            f0_nl == 0 => Skip;
            _          => EmitStruct;
        }
        EmitStruct: {
            let _ = call emit_str(ctx, "%struct.", 8);
            let _ = call emit_str(ctx, t_ptr.name_ptr, t_ptr.name_len);
            let _ = call emit_str(ctx, " = type { ", 10);
            let _ = call emit_struct_fields(ctx, t_ptr);
            let _ = call emit_str(ctx, " }", 2);
            let _ = call emit_nl(ctx);
            _ => return 0;
        }
        Skip: {
            _ => return 0;
        }
    }
}

machine emit_all_types(ctx: *CodegenCtx) -> u32 {
    flow {
        reg t_idx: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.type_count;
        wire has_more = t_idx < cnt;
        wire fld_t_ptr = prog.types;
        wire t_ptr = fld_t_ptr + t_idx;
    }
    states {
        Entry: {
            _ => Loop [ t_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => ProcessOne;
            _             => Done;
        }
        ProcessOne: {
            let _ = call emit_one_type_def(ctx, t_ptr);
            _ => Loop [ t_idx <= t_idx + 1 ];
        }
        Done: {
            cnt != 0 => EmitTrailNl;
            _        => Exit;
        }
        EmitTrailNl: {
            let _ = call emit_nl(ctx);
            _ => Exit;
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine emit_struct_fields(ctx: *CodegenCtx, t: *TypeDef) -> u32 {
    flow {
        reg f_idx: u32 = 0;
        wire cnt = t.field_count;
        wire has_more = f_idx < cnt;
        wire fld_f_ptr = t.fields;
        wire f_ptr = fld_f_ptr + f_idx;
        wire is_first = f_idx == 0;
    }
    states {
        Entry: {
            _ => Loop [ f_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitField;
            _             => Exit;
        }
        EmitField: {
            is_first == 0 => EmitComma;
            _             => EmitType;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitType;
        }
        EmitType: {
            let mapped_p = call map_type_ptr(ctx, f_ptr.type_ptr, f_ptr.type_len);
            let mapped_l = call map_type_len(ctx, f_ptr.type_ptr, f_ptr.type_len);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            _ => Loop [ f_idx <= f_idx + 1 ];
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine emit_all_externs(ctx: *CodegenCtx) -> u32 {
    flow {
        reg e_idx: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.extern_count;
        wire has_more = e_idx < cnt;
        wire fld_ext = prog.externs;
        wire ext = fld_ext + e_idx;
    }
    states {
        Entry: {
            _ => Loop [ e_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitOne;
            _             => Done;
        }
        EmitOne: {
            let _ = call emit_str(ctx, "declare ", 8);
            let ret_p = call map_type_ptr(ctx, ext.ret_type_ptr, ext.ret_type_len);
            let ret_l = call map_type_len(ctx, ext.ret_type_ptr, ext.ret_type_len);
            let _ = call emit_str(ctx, ret_p, ret_l);
            let _ = call emit_str(ctx, " @", 2);
            let _ = call emit_str(ctx, ext.name_ptr, ext.name_len);
            let _ = call emit_char(ctx, 40); // '('

            let _ = call emit_extern_params(ctx, ext);

            let _ = call emit_char(ctx, 41); // ')'
            let _ = call emit_nl(ctx);
            _ => Loop [ e_idx <= e_idx + 1 ];
        }
        Done: {
            _ => EmitDeclares;
        }
        EmitDeclares: {
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "declare void @exit(i32) cold noreturn nounwind", 46);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "declare void @llvm.trap() cold noreturn nounwind", 48);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "declare void @llvm.x86.sse.stmxcsr(i8*)", 40);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "declare void @llvm.x86.sse.ldmxcsr(i8*)", 40);
            let _ = call emit_nl(ctx);
            let _ = call emit_nl(ctx);
            _ => Exit;
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine emit_extern_params(ctx: *CodegenCtx, ext: *ExternFn) -> u32 {
    flow {
        reg p_idx: u32 = 0;
        wire cnt = ext.param_count;
        wire has_more = p_idx < cnt;
        wire fld_p = ext.params;
        wire p = fld_p + p_idx;
        wire is_first = p_idx == 0;
    }
    states {
        Entry: {
            _ => Loop [ p_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitParam;
            _             => Exit;
        }
        EmitParam: {
            is_first == 0 => EmitComma;
            _             => EmitType;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitType;
        }
        EmitType: {
            let mapped_p = call map_type_ptr(ctx, p.type_ptr, p.type_len);
            let mapped_l = call map_type_len(ctx, p.type_ptr, p.type_len);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            p.is_distinct != 0 => EmitDistinct;
            _                  => NextParam;
        }
        EmitDistinct: {
            let _ = call emit_str(ctx, " noalias", 8);
            _ => NextParam;
        }
        NextParam: {
            _ => Loop [ p_idx <= p_idx + 1 ];
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine calc_unescaped_str_len(val_ptr: *u8, val_len: u32) -> u32 {
    flow {
        reg pos: u32 = 0;
        reg len: u32 = 0;
        wire has_more = pos < val_len;
        wire p = val_ptr + pos;
        wire c = *p;
    }
    states {
        Entry: {
            val_ptr == null => RetZero;
            val_len == 0    => RetZero;
            _ => Loop [ pos <= 0, len <= 0 ];
        }
        Loop: {
            has_more == 0 => Finish;
            c == 92       => CheckEscape; // '\'
            _             => StepNormal;
        }
        CheckEscape: {
            let next_pos = pos + 1;
            next_pos >= val_len => StepNormal;
            _ => Loop [ pos <= pos + 2, len <= len + 1 ];
        }
        StepNormal: {
            _ => Loop [ pos <= pos + 1, len <= len + 1 ];
        }
        Finish: {
            _ => return len;
        }
        RetZero: {
            _ => return 0;
        }
    }
}

machine emit_llvm_escaped_string(ctx: *CodegenCtx, val_ptr: *u8, val_len: u32) -> u32 {
    flow {
        reg pos: u32 = 0;
        wire has_more = pos < val_len;
        wire p = val_ptr + pos;
        wire c = *p;
    }
    states {
        Entry: {
            val_ptr == null => Exit;
            val_len == 0    => Exit;
            _ => Loop [ pos <= 0 ];
        }
        Loop: {
            has_more == 0 => Exit;
            c == 92       => CheckEsc;
            c == 34       => EmitHex22;
            _             => EmitNormal;
        }
        CheckEsc: {
            let next_pos = pos + 1;
            next_pos >= val_len => EmitNormal;
            let np = val_ptr + next_pos;
            let nc = *np;

            nc == 34  => EmitEscQuote;     // \"
            nc == 92  => EmitEscBackslash; // \\
            nc == 110 => EmitEscNl;        // \n
            nc == 114 => EmitEscCr;        // \r
            nc == 116 => EmitEscTab;       // \t
            nc == 48  => EmitEscZero;      // \0
            _         => EmitEscOther;
        }
        EmitEscQuote: {
            let _ = call emit_str(ctx, "\\22", 3);
            _ => Loop [ pos <= pos + 2 ];
        }
        EmitEscBackslash: {
            let _ = call emit_str(ctx, "\\5C", 3);
            _ => Loop [ pos <= pos + 2 ];
        }
        EmitEscNl: {
            let _ = call emit_str(ctx, "\\0A", 3);
            _ => Loop [ pos <= pos + 2 ];
        }
        EmitEscCr: {
            let _ = call emit_str(ctx, "\\0D", 3);
            _ => Loop [ pos <= pos + 2 ];
        }
        EmitEscTab: {
            let _ = call emit_str(ctx, "\\09", 3);
            _ => Loop [ pos <= pos + 2 ];
        }
        EmitEscZero: {
            let _ = call emit_str(ctx, "\\00", 3);
            _ => Loop [ pos <= pos + 2 ];
        }
        EmitEscOther: {
            let _ = call emit_char(ctx, 92);
            let next_p = pos + 1;
            let np = val_ptr + next_p;
            let nc = *np;
            let _ = call emit_char(ctx, cast(u32) nc);
            _ => Loop [ pos <= pos + 2 ];
        }
        EmitHex22: {
            let _ = call emit_str(ctx, "\\22", 3);
            _ => Loop [ pos <= pos + 1 ];
        }
        EmitNormal: {
            let _ = call emit_char(ctx, cast(u32) c);
            _ => Loop [ pos <= pos + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine collect_string_const(ctx: *CodegenCtx, val_ptr: *u8, val_len: u32) -> u32 {
    flow {
        wire cnt = ctx.string_cnt;
        wire fld_entry = ctx.strings;
        wire entry = fld_entry + cnt;
    }
    states {
        Entry: {
            let res_id = ctx.str_id + 1;
            ctx.str_id <- res_id;
            entry.sym_id   <- res_id;
            entry.val_ptr  <- val_ptr;
            entry.val_len  <- val_len;
            let real_len   = call calc_unescaped_str_len(val_ptr, val_len);
            entry.byte_len <- real_len + 1; // null終端含む
            ctx.string_cnt <- cnt + 1;
            _ => return res_id;
        }
    }
}

machine emit_all_strings(ctx: *CodegenCtx) -> u32 {
    flow {
        reg i: u32 = 0;
        wire cnt = ctx.string_cnt;
        wire has_more = i < cnt;
        wire fld_entry = ctx.strings;
        wire entry = fld_entry + i;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitOne;
            _             => Done;
        }
        EmitOne: {
            // @.str_X = private unnamed_addr constant [L x i8] c"STR\00", align 1
            let _ = call emit_str(ctx, "@.str_", 6);
            let _ = call emit_u32(ctx, entry.sym_id);
            let _ = call emit_str(ctx, " = private unnamed_addr constant [", 34);
            let _ = call emit_u32(ctx, entry.byte_len);
            let _ = call emit_str(ctx, " x i8] c", 8);
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_llvm_escaped_string(ctx, entry.val_ptr, entry.val_len);
            let _ = call emit_char(ctx, 92); // '\\'
            let _ = call emit_char(ctx, 48); // '0'
            let _ = call emit_char(ctx, 48); // '0'
            let _ = call emit_char(ctx, 34); // '"'
            let _ = call emit_str(ctx, ", align 1", 9);
            let _ = call emit_nl(ctx);
            _ => Loop [ i <= i + 1 ];
        }
        Done: {
            cnt != 0 => EmitTrailNl;
            _        => Exit;
        }
        EmitTrailNl: {
            let _ = call emit_nl(ctx);
            _ => Exit;
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine emit_all_machines(ctx: *CodegenCtx) -> u32 {
    flow {
        reg m_idx: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.machine_count;
        wire has_more = m_idx < cnt;
        wire fld_m = prog.machines;
        wire m = fld_m + m_idx;
    }
    states {
        Entry: {
            _ => Loop [ m_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => ProcessOne;
            _             => Exit;
        }
        ProcessOne: {
            let _ = call emit_machine(ctx, m);
            _ => Loop [ m_idx <= m_idx + 1 ];
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine mark_net_nodes(prog: *ProgramDef, net: *NetworkDef) -> u32 {
    flow {
        reg i: u32 = 0;
        wire cnt = net.node_count;
        wire has_more = i < cnt;
        wire fld_node = net.nodes;
        wire cur_node = fld_node + i;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => SealOne;
            _             => Exit;
        }
        SealOne: {
            let m = call find_machine_in_prog(prog, cur_node.mach_name_p, cur_node.mach_name_l);
            m != null => DoSeal;
            _         => Next;
        }
        DoSeal: {
            let m = call find_machine_in_prog(prog, cur_node.mach_name_p, cur_node.mach_name_l);
            m.is_sealed <- 1;
            _ => Next;
        }
        Next: {
            _ => Loop [ i <= i + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine mark_sealed_machines(prog: *ProgramDef) -> u32 {
    flow {
        reg n_idx: u32 = 0;
        wire cnt = prog.network_count;
        wire has_more = n_idx < cnt;
        wire fld_net = prog.networks;
        wire net = fld_net + n_idx;
    }
    states {
        Entry: {
            _ => LoopNet [ n_idx <= 0 ];
        }
        LoopNet: {
            has_more != 0 => MarkNet;
            _             => Exit;
        }
        MarkNet: {
            let _ = call mark_net_nodes(prog, net);
            _ => LoopNet [ n_idx <= n_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine find_network_in_prog(prog: *ProgramDef, name_p: *u8, name_l: u32) -> *NetworkDef {
    flow {
        reg i: u32 = 0;
        wire cnt = prog.network_count;
        wire has_more = i < cnt;
        wire fld_net = prog.networks;
        wire net = fld_net + i;
        wire is_match = call str_eq(net.name_ptr, net.name_len, name_p, name_l);
    }
    states {
        Entry: {
            name_p == null => NotFound;
            _              => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Next;
        }
        Next: {
            _ => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return net;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine find_network_node_machine(prog: *ProgramDef, net: *NetworkDef, nid_p: *u8, nid_l: u32) -> *MachineDef {
    flow {
        reg i: u32 = 0;
        wire cnt = net.node_count;
        wire has_more = i < cnt;
        wire fld_node = net.nodes;
        wire cur_node = fld_node + i;
        wire is_match = call str_eq(cur_node.node_id_p, cur_node.node_id_l, nid_p, nid_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => FoundNode;
            _             => Next;
        }
        FoundNode: {
            let m = call find_machine_in_prog(prog, cur_node.mach_name_p, cur_node.mach_name_l);
            _ => return m;
        }
        Next: {
            _ => Loop [ i <= i + 1 ];
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine emit_net_params(ctx: *CodegenCtx, net: *NetworkDef) -> u32 {
    flow {
        reg p_idx: u32 = 0;
        wire cnt = net.param_count;
        wire has_more = p_idx < cnt;
        wire fld_p = net.params;
        wire p = fld_p + p_idx;
        wire is_first = p_idx == 0;
    }
    states {
        Entry: {
            _ => Loop [ p_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitParam;
            _             => Exit;
        }
        EmitParam: {
            is_first == 0 => EmitComma;
            _             => EmitOne;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitOne;
        }
        EmitOne: {
            let mapped_p = call map_type_ptr(ctx, p.type_ptr, p.type_len);
            let mapped_l = call map_type_len(ctx, p.type_ptr, p.type_len);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            let _ = call emit_str(ctx, " %arg_", 6);
            let _ = call emit_str(ctx, p.name_ptr, p.name_len);
            _ => Loop [ p_idx <= p_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_net_header(ctx: *CodegenCtx, net: *NetworkDef, first_nid_p: *u8, first_nid_l: u32) -> u32 {
    flow {
        wire ret_p = call map_type_ptr(ctx, net.ret_type_ptr, net.ret_type_len);
        wire ret_l = call map_type_len(ctx, net.ret_type_ptr, net.ret_type_len);
    }
    states {
        Entry: {
            let _ = call emit_str(ctx, "define ", 7);
            let _ = call emit_str(ctx, ret_p, ret_l);
            let _ = call emit_str(ctx, " @", 2);
            let _ = call emit_str(ctx, net.name_ptr, net.name_len);
            let _ = call emit_char(ctx, 40); // '('
            let _ = call emit_net_params(ctx, net);
            let _ = call emit_str(ctx, ") {", 3);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "net_entry:", 10);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "  br label %", 12);
            let _ = call emit_str(ctx, first_nid_p, first_nid_l);
            let _ = call emit_str(ctx, "_entry", 6);
            let _ = call emit_nl(ctx);
            let _ = call emit_nl(ctx);
            _ => return 0;
        }
    }
}

machine emit_net_close(ctx: *CodegenCtx) -> u32 {
    flow {}
    states {
        Entry: {
            ctx.out_buf <- ctx.main_buf;
            ctx.out_pos <- ctx.main_pos;
            ctx.max_len <- ctx.main_cap;

            let _ = call emit_char(ctx, 125); // '}'
            let _ = call emit_nl(ctx);
            let _ = call emit_nl(ctx);
            ctx.main_pos <- ctx.out_pos;

            // [Shield 3]: Prefix Sanitization
            ctx.node_prefix_p     <- null;
            ctx.node_prefix_l     <- 0;
            ctx.fused_is_last     <- 0;
            ctx.fused_ret_cnt     <- 0;
            ctx.fused_prev_type_p <- null;
            ctx.fused_prev_type_l <- 0;
            _ => return ctx.out_pos;
        }
    }
}

machine emit_phi_bridge(ctx: *CodegenCtx, out_type_p: *u8, out_type_l: u32, res_p: *u8, res_l: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire cnt = ctx.fused_ret_cnt;
        wire has_more = i < cnt;
        wire fld_ret = ctx.fused_ret_vals;
        wire slot = fld_ret + i;
        wire is_first = i == 0;
    }
    states {
        Entry: {
            cnt == 0 => Exit;
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_p, res_l);
            let _ = call emit_str(ctx, " = phi ", 7);
            let _ = call emit_str(ctx, out_type_p, out_type_l);
            let _ = call emit_char(ctx, 32); // ' '
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitOne;
            _             => FinishPhi;
        }
        EmitOne: {
            is_first == 0 => EmitComma;
            _             => EmitEntry;
        }
        EmitComma: {
            let _ = call emit_str(ctx, ", ", 2);
            _ => EmitEntry;
        }
        EmitEntry: {
            let _ = call emit_str(ctx, "[ ", 2);
            let _ = call emit_str(ctx, slot.val_p, slot.val_l);
            let _ = call emit_str(ctx, ", %", 3);
            let _ = call emit_str(ctx, slot.bb_p, slot.bb_l);
            let _ = call emit_str(ctx, " ]", 2);
            _ => Loop [ i <= i + 1 ];
        }
        FinishPhi: {
            let _ = call emit_nl(ctx);
            _ => Exit;
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine assemble_fused_blocks(ctx: *CodegenCtx, m: *MachineDef) -> u32 {
    flow {
        reg b_idx: u32 = 0;
        wire cnt = ctx.block_cnt;
        wire has_more = b_idx < cnt;
        wire fld_bb = ctx.blocks;
        wire bb = fld_bb + b_idx;
    }
    states {
        Entry: {
            _ => Loop [ b_idx <= 0 ];
        }
        Loop: {
            has_more != 0 => EmitBlock;
            _             => Exit;
        }
        EmitBlock: {
            let _ = call emit_str(ctx, bb.name_ptr, bb.name_len);
            let _ = call emit_char(ctx, 58); // ':'
            let _ = call emit_nl(ctx);

            let s_idx = bb.state_idx;
            s_idx >= 1 => DoEmitStatePhi;
            _          => EmitInsts;
        }
        DoEmitStatePhi: {
            let s = call find_state_by_idx(m, bb.state_idx);
            s != null => EmitStatePhiNodes;
            _         => EmitInsts;
        }
        EmitStatePhiNodes: {
            let s = call find_state_by_idx(m, bb.state_idx);
            let _ = call emit_state_phi_nodes(ctx, m, s, bb.state_idx);
            _ => EmitInsts;
        }
        EmitInsts: {
            let _ = call emit_str(ctx, bb.buf_ptr, bb.buf_pos);
            _ => Loop [ b_idx <= b_idx + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine emit_node_fused(
    ctx: *CodegenCtx,
    m: *MachineDef,
    nid_p: *u8,
    nid_l: u32,
    in_val_p: *u8,
    in_val_l: u32,
    is_last: u32,
    next_bb_p: *u8,
    next_bb_l: u32,
    prev_out_type_p: *u8,
    prev_out_type_l: u32
) -> u32 {
    flow {}
    states {
        Entry: {
            ctx.cur_machine       <- m;
            ctx.node_prefix_p     <- nid_p;
            ctx.node_prefix_l     <- nid_l;
            ctx.fused_is_last     <- is_last;
            ctx.fused_next_bb_p   <- next_bb_p;
            ctx.fused_next_bb_l   <- next_bb_l;
            ctx.fused_prev_type_p <- prev_out_type_p;
            ctx.fused_prev_type_l <- prev_out_type_l;
            ctx.cur_env_cnt       <- 0;
            ctx.phi_cnt           <- 0;
            ctx.block_cnt         <- 0;

            let p0 = m.params;
            p0 != null => BindInVal;
            _          => DoEntry;
        }
        BindInVal: {
            let p0 = m.params;
            let _ = call env_set(ctx, p0.name_ptr, p0.name_len, in_val_p, in_val_l);
            _ => DoEntry;
        }
        DoEntry: {
            // Pass 1: 各ブロック作成 & 命令蓄積 (entry_bb の先頭で必要なら phi 生成)
            let _ = call emit_entry_block(ctx, m);
            let _ = call emit_machine_states(ctx, m);

            // Pass 2: メイン出力バッファへブロック出力
            ctx.out_buf <- ctx.main_buf;
            ctx.out_pos <- ctx.main_pos;
            ctx.max_len <- ctx.main_cap;

            let _ = call assemble_fused_blocks(ctx, m);

            ctx.main_pos <- ctx.out_pos;
            _ => return ctx.out_pos;
        }
    }
}

machine emit_network_node_intermediate(
    ctx: *CodegenCtx,
    prog: *ProgramDef,
    net: *NetworkDef,
    node_idx: u32,
    curr_in_p: *u8,
    curr_in_l: u32,
    prev_out_p: *u8,
    prev_out_l: u32
) -> u32 {
    flow {
        wire el_list = net.pipeline_elems;
        wire el_cur = el_list + (node_idx + 1);
        wire el_nxt = el_list + (node_idx + 2);
        wire m = call find_network_node_machine(prog, net, el_cur.ptr, el_cur.len);
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            let next_bb_p = call make_prefixed_name(alloc, el_nxt.ptr, el_nxt.len, "entry", 5);
            let next_bb_l = call strlen(next_bb_p);

            let _ = call emit_node_fused(ctx, m, el_cur.ptr, el_cur.len, curr_in_p, curr_in_l, 0, next_bb_p, next_bb_l, prev_out_p, prev_out_l);
            _ => return 0;
        }
    }
}

machine emit_network_node_last(
    ctx: *CodegenCtx,
    prog: *ProgramDef,
    net: *NetworkDef,
    node_idx: u32,
    curr_in_p: *u8,
    curr_in_l: u32,
    prev_out_p: *u8,
    prev_out_l: u32
) -> u32 {
    flow {
        wire el_list = net.pipeline_elems;
        wire el_cur = el_list + (node_idx + 1);
        wire m = call find_network_node_machine(prog, net, el_cur.ptr, el_cur.len);
    }
    states {
        Entry: {
            let _ = call emit_node_fused(ctx, m, el_cur.ptr, el_cur.len, curr_in_p, curr_in_l, 1, null, 0, prev_out_p, prev_out_l);
            _ => return 0;
        }
    }
}

machine emit_net_start(ctx: *CodegenCtx, net: *NetworkDef) -> *u8 {
    flow {
        wire el_list = net.pipeline_elems;
        wire el_in = el_list + 0;
        wire el_first = el_list + 1;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            ctx.out_buf <- ctx.main_buf;
            ctx.out_pos <- ctx.main_pos;
            ctx.max_len <- ctx.main_cap;

            let _ = call emit_net_header(ctx, net, el_first.ptr, el_first.len);
            ctx.main_pos <- ctx.out_pos;

            let in_p = call make_prefixed_name(alloc, "%arg", 4, el_in.ptr, el_in.len);
            ctx.fused_ret_cnt <- 0;
            _ => return in_p;
        }
    }
}

machine emit_network_node_step(
    ctx: *CodegenCtx,
    prog: *ProgramDef,
    net: *NetworkDef,
    node_idx: u32,
    curr_in_p: *u8,
    curr_in_l: u32,
    prev_out_p: *u8,
    prev_out_l: u32
) -> *u8 {
    flow {
        wire alloc = ctx.alloc;
        wire el_list = net.pipeline_elems;
        wire el_nxt = el_list + (node_idx + 2);
        wire nxt_in_p = call make_fused_reg_name(alloc, el_nxt.ptr, el_nxt.len);
    }
    states {
        Entry: {
            let _ = call emit_network_node_intermediate(ctx, prog, net, node_idx, curr_in_p, curr_in_l, prev_out_p, prev_out_l);
            _ => return nxt_in_p;
        }
    }
}

machine emit_network(ctx: *CodegenCtx, net: *NetworkDef) -> u32 {
    flow {
        reg node_idx:   u32 = 0;
        reg curr_in_p:  *u8 = null;
        reg curr_in_l:  u32 = 0;
        reg prev_out_p: *u8 = null;
        reg prev_out_l: u32 = 0;

        wire prog = ctx.prog;
        wire pipe_cnt = net.pipeline_count;
        wire num_nodes = pipe_cnt - 1;
        wire has_more = node_idx < num_nodes;
    }
    states {
        Entry: {
            pipe_cnt < 2 => Close;
            let in_p = call emit_net_start(ctx, net);
            let in_l = call strlen(in_p);
            _ => Loop [ node_idx <= 0, curr_in_p <= in_p, curr_in_l <= in_l, prev_out_p <= null, prev_out_l <= 0 ];
        }
        Loop: {
            has_more != 0 => ProcessNode;
            _             => Close;
        }
        ProcessNode: {
            let is_last = node_idx == (num_nodes - 1);
            is_last != 0 => NodeLast;
            _            => NodeNext;
        }
        NodeLast: {
            let _ = call emit_network_node_last(ctx, prog, net, node_idx, curr_in_p, curr_in_l, prev_out_p, prev_out_l);
            _ => Loop [ node_idx <= node_idx + 1, curr_in_p <= null, curr_in_l <= 0, prev_out_p <= null, prev_out_l <= 0 ];
        }
        NodeNext: {
            let el_list = net.pipeline_elems;
            let el_cur = el_list + (node_idx + 1);
            let m = call find_network_node_machine(prog, net, el_cur.ptr, el_cur.len);
            let out_t_p = call map_type_ptr(ctx, m.ret_type_ptr, m.ret_type_len);
            let out_t_l = call map_type_len(ctx, m.ret_type_ptr, m.ret_type_len);
            let res_var_p = call emit_network_node_step(ctx, prog, net, node_idx, curr_in_p, curr_in_l, prev_out_p, prev_out_l);
            let res_var_l = call strlen(res_var_p);
            _ => Loop [ node_idx <= node_idx + 1, curr_in_p <= res_var_p, curr_in_l <= res_var_l, prev_out_p <= out_t_p, prev_out_l <= out_t_l ];
        }
        Close: {
            let _ = call emit_net_close(ctx);
            _ => return 0;
        }
    }
}

machine emit_all_networks(ctx: *CodegenCtx) -> u32 {
    flow {
        reg i: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.network_count;
        wire has_more = i < cnt;
        wire fld_net = prog.networks;
        wire net = fld_net + i;
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more != 0 => ProcessOne;
            _             => Done;
        }
        ProcessOne: {
            let _ = call emit_network(ctx, net);
            _ => Loop [ i <= i + 1 ];
        }
        Done: {
            // [Shield 3]: Prefix Sanitization
            ctx.node_prefix_p <- null;
            ctx.node_prefix_l <- 0;
            _ => return ctx.out_pos;
        }
    }
}

machine scan_bounded_types_mask(prog: *ProgramDef) -> u32 {
    flow {
        reg i: u32 = 0;
        reg mask: u32 = 0;
        wire cnt = prog.type_count;
        wire has_more = i < cnt;
        wire fld_t = prog.types;
        wire t = fld_t + i;
    }
    states {
        Entry: {
            _ => ScanLoop [ i <= 0, mask <= 0 ];
        }
        ScanLoop: {
            has_more != 0 => CheckType;
            _             => Exit;
        }
        CheckType: {
            t.kind == 2 => CheckBase;
            _           => NextType;
        }
        CheckBase: {
            let is_f32 = call str_eq(t.base_ptr, t.base_len, "f32", 3);
            is_f32 != 0 => MarkF32;
            let is_f64 = call str_eq(t.base_ptr, t.base_len, "f64", 3);
            is_f64 != 0 => MarkF64;
            _           => NextType;
        }
        MarkF32: {
            let m1 = mask | 1;
            _ => ScanLoop [ i <= i + 1, mask <= m1 ];
        }
        MarkF64: {
            let m2 = mask | 2;
            _ => ScanLoop [ i <= i + 1, mask <= m2 ];
        }
        NextType: {
            _ => ScanLoop [ i <= i + 1, mask <= mask ];
        }
        Exit: {
            _ => return mask;
        }
    }
}

machine emit_bounded_intrinsics(ctx: *CodegenCtx) -> u32 {
    flow {
        wire mask = call scan_bounded_types_mask(ctx.prog);
        wire has_f32 = mask & 1;
        wire has_f64 = mask & 2;
    }
    states {
        Entry: {
            has_f32 != 0 => EmitF32;
            _            => CheckF64;
        }
        EmitF32: {
            let _ = call emit_str(ctx, "declare float @llvm.minnum.f32(float, float)", 44);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "declare float @llvm.maxnum.f32(float, float)", 44);
            let _ = call emit_nl(ctx);
            _ => CheckF64;
        }
        CheckF64: {
            has_f64 != 0 => EmitF64;
            _            => Exit;
        }
        EmitF64: {
            let _ = call emit_str(ctx, "declare double @llvm.minnum.f64(double, double)", 47);
            let _ = call emit_nl(ctx);
            let _ = call emit_str(ctx, "declare double @llvm.maxnum.f64(double, double)", 47);
            let _ = call emit_nl(ctx);
            _ => Exit;
        }
        Exit: {
            _ => return ctx.out_pos;
        }
    }
}

machine ssac_codegen(prog: *ProgramDef, alloc_obj: *BumpAlloc, out_buf: *u8, max_len: u32) -> i32 {
    flow {
        reg res: i32 = 0;
    }
    states {
        Entry: {
            let ctx = call alloc_codegen_context();
            ctx.prog         <- prog;
            ctx.alloc        <- alloc_obj;
            ctx.out_buf      <- out_buf;
            ctx.out_pos      <- 0;
            ctx.max_len      <- max_len;
            ctx.main_buf     <- out_buf;
            ctx.main_pos     <- 0;
            ctx.main_cap     <- max_len;
            ctx.tmp_id       <- 0;
            ctx.str_id       <- 0;
            ctx.type_map_cnt <- 0;
            ctx.string_cnt   <- 0;
            ctx.cur_env_cnt  <- 0;
            ctx.phi_cnt      <- 0;
            ctx.block_cnt    <- 0;
            ctx.error_code   <- 0;
            ctx.cur_state_p  <- null;
            ctx.cur_state_l  <- 0;

            ctx.node_prefix_p     <- null;
            ctx.node_prefix_l     <- 0;
            ctx.fused_is_last     <- 0;
            ctx.fused_ret_cnt     <- 0;
            ctx.fused_prev_type_p <- null;
            ctx.fused_prev_type_l <- 0;

            // バッファ確保 (大容量アリーナから安全に切り出し)
            let type_map_mem = call bump_alloc(alloc_obj, 65536, 8);
            let string_mem   = call bump_alloc(alloc_obj, 65536, 8);
            let env_mem      = call bump_alloc(alloc_obj, 65536, 8);
            let phi_mem      = call bump_alloc(alloc_obj, 262144, 8);
            let blocks_mem   = call bump_alloc(alloc_obj, 262144, 8);
            let ret_mem      = call bump_alloc(alloc_obj, 4096, 8);

            ctx.type_map       <- type_map_mem;
            ctx.strings        <- string_mem;
            ctx.cur_env        <- env_mem;
            ctx.phi_entries    <- phi_mem;
            ctx.blocks         <- blocks_mem;
            ctx.fused_ret_vals <- ret_mem;

            // 1. 型レジストリ初期化 (エイリアス展開含む)
            let _ = call init_type_registry(ctx);

            // 1.5. 全型定義・シグネチャ妥当性検証 (FAIL-FAST)
            let _ = call validate_all_program_types(ctx);
            let early_err = ctx.error_code;
            early_err != 0 => Exit [ res <= early_err ];

            // 2. LLVM IR ヘッダ
            let _ = call emit_header(ctx);

            // 3. 型定義出力 (エイリアスは除外)
            let _ = call emit_all_types(ctx);

            // 4. 外部関数宣言出力
            let _ = call emit_all_externs(ctx);

            ctx.main_pos <- ctx.out_pos;

            // 5. ノード封印マーク
            let _ = call mark_sealed_machines(prog);

            // 6. 各マシン出力
            let _ = call emit_all_machines(ctx);

            // 7. 各ネットワーク出力 (Same-Stack Fusion)
            let _ = call emit_all_networks(ctx);

            // 8. 文字列定数出力
            ctx.out_buf <- ctx.main_buf;
            ctx.out_pos <- ctx.main_pos;
            ctx.max_len <- ctx.main_cap;
            let _ = call emit_all_strings(ctx);

            // 9. Bounded Intrinsics declare 出力 (Shield 4)
            let _ = call emit_bounded_intrinsics(ctx);

            let err = ctx.error_code;
            let pos = ctx.out_pos;
            err != 0 => Exit [ res <= err ];
            _        => Exit [ res <= pos ];
        }
        Exit: {
            _ => return res;
        }
    }
}

machine alloc_codegen_context() -> *CodegenCtx {
    flow {}
    states {
        Entry: {
            let mem = call malloc(256);
            _ => return mem;
        }
    }
}

machine calc_compiler_required_memory(src_len: u32) -> u32 {
    flow {
        wire scaled    = src_len * 500;
        wire estimated = scaled + 1048576;
        wire is_small  = estimated < 2097152;
    }
    states {
        Entry: {
            is_small != 0 => MinCap;
            _             => CalcCap;
        }
        MinCap: {
            _ => return 2097152; // 2MB
        }
        CalcCap: {
            _ => return estimated;
        }
    }
}

machine ssac_compile_source(src_ptr: *u8, src_len: u32, out_buf: *u8, max_len: u32) -> i32 {
    flow {
        reg root_ptr:  *u8 = null;
        reg ret_code:  i32 = 0;
        reg tok_mem:   *u8 = null;
        reg tok_cnt:   u32 = 0;
        reg prog_ptr:  *ProgramDef = null;
        reg alloc_obj: *BumpAlloc = null;

        wire total_mem = call calc_compiler_required_memory(src_len);
        wire alloc_mem = call malloc(16);
    }
    states {
        Entry: {
            // 【一括確保】静的算定した総メモリ量を一発 malloc
            let mem = call malloc(total_mem);
            let alloc = call bump_init(alloc_mem, mem, total_mem);

            // トークン配列をアリーナから切り出し (最大 src_len + 1024 トークン, 1トークン 32B)
            let max_toks = src_len + 1024;
            let tok_bytes = max_toks * 32;
            let t_mem = call bump_alloc(alloc, tok_bytes, 8);

            // ProgramDef をアリーナから切り出し (64B)
            let p_mem = call bump_alloc(alloc, 64, 8);

            // 1. Lexer
            let num_toks = call ssac_tokenize(src_ptr, src_len, t_mem, max_toks);
            num_toks < 0 => LexError [ root_ptr <= mem, ret_code <= -10 ];
            _            => DoParse  [ root_ptr <= mem, tok_mem <= t_mem, tok_cnt <= num_toks, prog_ptr <= p_mem, alloc_obj <= alloc ];
        }

        DoParse: {
            // 2. Parser
            let ret_p = call ssac_parse(tok_mem, tok_cnt, alloc_obj, prog_ptr);
            ret_p != 0 => ParseError [ ret_code <= ret_p ];
            _          => DoCodegen;
        }

        DoCodegen: {
            // 3. Codegen (ゼロコピーで大容量アリーナを渡す)
            let ret_cg = call ssac_codegen(prog_ptr, alloc_obj, out_buf, max_len);
            _ => CleanUp [ ret_code <= ret_cg ];
        }

        LexError: {
            _ => CleanUp;
        }

        ParseError: {
            _ => CleanUp;
        }

        CleanUp: {
            // 【一括解放】コンパイル終了時に唯一の free
            let _ = call free(root_ptr);
            let _ = call free(alloc_mem);
            _ => return ret_code;
        }
    }
}

