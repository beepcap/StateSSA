machine emit_cast_op(ctx: *CodegenCtx, op_p: *u8, op_l: u32, src_t: *u8, src_l: u32, dst_t: *u8, dst_l: u32, val: *u8) -> *u8 {
    flow {}
    states {
        Entry: {
            let res = call fresh_tmp_str(ctx, op_p, op_l);
            let map_src_p = call map_type_ptr(ctx, src_t, src_l);
            let map_src_l = call map_type_len(ctx, src_t, src_l);
            let map_dst_p = call map_type_ptr(ctx, dst_t, dst_l);
            let map_dst_l = call map_type_len(ctx, dst_t, dst_l);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res, call strlen(res));
            let _ = call emit_str(ctx, " = ", 3);
            let _ = call emit_str(ctx, op_p, op_l);
            let _ = call emit_char(ctx, 32); // ' '
            let _ = call emit_str(ctx, map_src_p, map_src_l);
            let _ = call emit_char(ctx, 32); // ' '
            let _ = call emit_str(ctx, val, call strlen(val));
            let _ = call emit_str(ctx, " to ", 4);
            let _ = call emit_str(ctx, map_dst_p, map_dst_l);
            let _ = call emit_nl(ctx);
            _ => return res;
        }
    }
}

machine find_bounded_type(prog: *ProgramDef, name_p: *u8, name_l: u32) -> *TypeDef {
    flow {
        reg i: u32 = 0;
        wire cnt = prog.type_count;
        wire has_more = i < cnt;
        wire fld_t = prog.types;
        wire t = fld_t + i;
        wire is_match = call str_eq(t.name_ptr, t.name_len, name_p, name_l);
    }
    states {
        Entry: {
            name_p == null => NotFound;
            _              => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            t.kind == 2   => CheckName;
            _             => Next;
        }
        CheckName: {
            is_match != 0 => Found;
            _             => Next;
        }
        Next: {
            _ => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return t;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine emit_clamp_f32(ctx: *CodegenCtx, val_reg: *u8, type_def: *TypeDef) -> *u8 {
    flow {
        wire min_lit = type_def.min_ptr;
        wire min_len = type_def.min_len;
        wire max_lit = type_def.max_ptr;
        wire max_len = type_def.max_len;
    }
    states {
        Entry: {
            let min_c = call fresh_tmp_str(ctx, "c_min", 5);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, min_c, call strlen(min_c));
            let _ = call emit_str(ctx, " = fptrunc double ", 18);
            let _ = call emit_str(ctx, min_lit, min_len);
            let _ = call emit_str(ctx, " to float", 9);
            let _ = call emit_nl(ctx);

            let max_c = call fresh_tmp_str(ctx, "c_max", 5);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, max_c, call strlen(max_c));
            let _ = call emit_str(ctx, " = fptrunc double ", 18);
            let _ = call emit_str(ctx, max_lit, max_len);
            let _ = call emit_str(ctx, " to float", 9);
            let _ = call emit_nl(ctx);

            let t1 = call fresh_tmp_str(ctx, "clamp_max", 9);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, t1, call strlen(t1));
            let _ = call emit_str(ctx, " = call float @llvm.maxnum.f32(float ", 37);
            let _ = call emit_str(ctx, val_reg, call strlen(val_reg));
            let _ = call emit_str(ctx, ", float ", 8);
            let _ = call emit_str(ctx, min_c, call strlen(min_c));
            let _ = call emit_char(ctx, 41); // ')'
            let _ = call emit_nl(ctx);

            let t2 = call fresh_tmp_str(ctx, "clamped", 7);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, t2, call strlen(t2));
            let _ = call emit_str(ctx, " = call float @llvm.minnum.f32(float ", 37);
            let _ = call emit_str(ctx, t1, call strlen(t1));
            let _ = call emit_str(ctx, ", float ", 8);
            let _ = call emit_str(ctx, max_c, call strlen(max_c));
            let _ = call emit_char(ctx, 41); // ')'
            let _ = call emit_nl(ctx);
            _ => return t2;
        }
    }
}

machine emit_clamp_f64(ctx: *CodegenCtx, val_reg: *u8, type_def: *TypeDef) -> *u8 {
    flow {
        wire min_lit = type_def.min_ptr;
        wire min_len = type_def.min_len;
        wire max_lit = type_def.max_ptr;
        wire max_len = type_def.max_len;
    }
    states {
        Entry: {
            let t1 = call fresh_tmp_str(ctx, "clamp_max", 9);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, t1, call strlen(t1));
            let _ = call emit_str(ctx, " = call double @llvm.maxnum.f64(double ", 40);
            let _ = call emit_str(ctx, val_reg, call strlen(val_reg));
            let _ = call emit_str(ctx, ", double ", 9);
            let _ = call emit_str(ctx, min_lit, min_len);
            let _ = call emit_char(ctx, 41); // ')'
            let _ = call emit_nl(ctx);

            let t2 = call fresh_tmp_str(ctx, "clamped", 7);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, t2, call strlen(t2));
            let _ = call emit_str(ctx, " = call double @llvm.minnum.f64(double ", 40);
            let _ = call emit_str(ctx, t1, call strlen(t1));
            let _ = call emit_str(ctx, ", double ", 9);
            let _ = call emit_str(ctx, max_lit, max_len);
            let _ = call emit_char(ctx, 41); // ')'
            let _ = call emit_nl(ctx);
            _ => return t2;
        }
    }
}

machine emit_clamp_float(ctx: *CodegenCtx, val_reg: *u8, type_def: *TypeDef) -> *u8 {
    flow {
        wire is_f32 = call str_eq(type_def.base_ptr, type_def.base_len, "f32", 3);
    }
    states {
        Entry: {
            is_f32 != 0 => DoF32;
            _           => DoF64;
        }
        DoF32: {
            let res = call emit_clamp_f32(ctx, val_reg, type_def);
            _ => return res;
        }
        DoF64: {
            let res = call emit_clamp_f64(ctx, val_reg, type_def);
            _ => return res;
        }
    }
}

machine emit_clamp_int_body(
    ctx: *CodegenCtx,
    val_reg: *u8,
    llvm_t_p: *u8,
    llvm_t_l: u32,
    min_lit: *u8,
    min_len: u32,
    max_lit: *u8,
    max_len: u32,
    cmp_lt: *u8,
    cmp_gt: *u8
) -> *u8 {
    flow {}
    states {
        Entry: {
            let c1 = call fresh_tmp_str(ctx, "cmp_min", 7);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, c1, call strlen(c1));
            let _ = call emit_str(ctx, " = icmp ", 8);
            let _ = call emit_str(ctx, cmp_lt, 3);
            let _ = call emit_char(ctx, 32);
            let _ = call emit_str(ctx, llvm_t_p, llvm_t_l);
            let _ = call emit_char(ctx, 32);
            let _ = call emit_str(ctx, val_reg, call strlen(val_reg));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, min_lit, min_len);
            let _ = call emit_nl(ctx);

            let s1 = call fresh_tmp_str(ctx, "val_min", 7);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, s1, call strlen(s1));
            let _ = call emit_str(ctx, " = select i1 ", 13);
            let _ = call emit_str(ctx, c1, call strlen(c1));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, llvm_t_p, llvm_t_l);
            let _ = call emit_char(ctx, 32);
            let _ = call emit_str(ctx, min_lit, min_len);
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, llvm_t_p, llvm_t_l);
            let _ = call emit_char(ctx, 32);
            let _ = call emit_str(ctx, val_reg, call strlen(val_reg));
            let _ = call emit_nl(ctx);

            let c2 = call fresh_tmp_str(ctx, "cmp_max", 7);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, c2, call strlen(c2));
            let _ = call emit_str(ctx, " = icmp ", 8);
            let _ = call emit_str(ctx, cmp_gt, 3);
            let _ = call emit_char(ctx, 32);
            let _ = call emit_str(ctx, llvm_t_p, llvm_t_l);
            let _ = call emit_char(ctx, 32);
            let _ = call emit_str(ctx, s1, call strlen(s1));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, max_lit, max_len);
            let _ = call emit_nl(ctx);

            let s2 = call fresh_tmp_str(ctx, "clamped", 7);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, s2, call strlen(s2));
            let _ = call emit_str(ctx, " = select i1 ", 13);
            let _ = call emit_str(ctx, c2, call strlen(c2));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, llvm_t_p, llvm_t_l);
            let _ = call emit_char(ctx, 32);
            let _ = call emit_str(ctx, max_lit, max_len);
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, llvm_t_p, llvm_t_l);
            let _ = call emit_char(ctx, 32);
            let _ = call emit_str(ctx, s1, call strlen(s1));
            let _ = call emit_nl(ctx);
            _ => return s2;
        }
    }
}

machine emit_clamp_int(ctx: *CodegenCtx, val_reg: *u8, type_def: *TypeDef) -> *u8 {
    flow {
        wire b_p = type_def.base_ptr;
        wire b_l = type_def.base_len;
        wire is_u = *b_p == 117; // 'u'
        wire llvm_t_p = call map_type_ptr(ctx, b_p, b_l);
        wire llvm_t_l = call map_type_len(ctx, b_p, b_l);
        wire min_lit = type_def.min_ptr;
        wire min_len = type_def.min_len;
        wire max_lit = type_def.max_ptr;
        wire max_len = type_def.max_len;
    }
    states {
        Entry: {
            is_u != 0 => EmitUnsigned;
            _         => EmitSigned;
        }
        EmitUnsigned: {
            let res = call emit_clamp_int_body(ctx, val_reg, llvm_t_p, llvm_t_l, min_lit, min_len, max_lit, max_len, "ult", "ugt");
            _ => return res;
        }
        EmitSigned: {
            let res = call emit_clamp_int_body(ctx, val_reg, llvm_t_p, llvm_t_l, min_lit, min_len, max_lit, max_len, "slt", "sgt");
            _ => return res;
        }
    }
}

machine emit_clamp(ctx: *CodegenCtx, val_reg: *u8, type_def: *TypeDef) -> *u8 {
    flow {
        wire b_p = type_def.base_ptr;
        wire b_l = type_def.base_len;
        wire is_f32 = call str_eq(b_p, b_l, "f32", 3);
        wire is_f64 = call str_eq(b_p, b_l, "f64", 3);
        wire is_fp = is_f32 | is_f64;
    }
    states {
        Entry: {
            is_fp != 0 => ClampFloat;
            _          => ClampInt;
        }
        ClampFloat: {
            let res = call emit_clamp_float(ctx, val_reg, type_def);
            _ => return res;
        }
        ClampInt: {
            let res = call emit_clamp_int(ctx, val_reg, type_def);
            _ => return res;
        }
    }
}

machine emit_cast_expr(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg src_is_ptr: u32 = 0;
        reg dst_is_ptr: u32 = 0;
        reg src_bits:   u32 = 32;
        reg dst_bits:   u32 = 32;
        reg val_str:    *u8 = null;
        reg s_type:     *u8 = null;
        reg d_type:     *u8 = null;
        reg ext_val:    *u8 = null;
        reg shr_val:    *u8 = null;

        wire operand = expr.left;
        wire target_t_p = expr.str_ptr;
        wire target_t_l = expr.str_len;
    }
    states {
        Entry: {
            operand == null => FailOperand;
            let op_k = operand.kind;
            op_k == 11 => CheckFastReal;
            _          => NormalEntry;
        }
        CheckFastReal: {
            let is_f64 = call str_eq(target_t_p, target_t_l, "f64", 3);
            let is_double = call str_eq(target_t_p, target_t_l, "double", 6);
            let is_fp64 = is_f64 | is_double;
            is_fp64 != 0 => FastRealLitF64;

            let is_f32 = call str_eq(target_t_p, target_t_l, "f32", 3);
            let is_float = call str_eq(target_t_p, target_t_l, "float", 5);
            let is_fp32 = is_f32 | is_float;
            is_fp32 != 0 => FastRealLitF32;

            _          => NormalEntry;
        }
        NormalEntry: {
            let ok = call check_base_type_valid(ctx, target_t_p, target_t_l);
            ok == 0 => UndefinedCastErr;
            let val = call emit_expr(ctx, operand);
            let st = call get_expr_type(ctx, operand);
            let dt = call make_cstr(ctx.alloc, target_t_p, target_t_l);

            let s_ptr = call is_ptr_type(st);
            let d_ptr = call is_ptr_type(dt);

            _ => Classify [ val_str <= val, s_type <= st, d_type <= dt, src_is_ptr <= s_ptr, dst_is_ptr <= d_ptr ];
        }
        UndefinedCastErr: {
            let _ = call report_undefined_type(ctx, target_t_p, target_t_l, "cast", 4);
            _ => return "null";
        }
        FastRealLitF64: {
            let raw_cstr = call make_cstr(ctx.alloc, operand.str_ptr, operand.str_len);
            _ => return raw_cstr;
        }
        FastRealLitF32: {
            // Note: LLVM IR constraint.
            // In LLVM IR text format (.ll), writing an inexact decimal literal directly for 'float'
            // triggers 'error: floating point constant invalid for type' because LLVM disallows
            // lossy decimal-to-float parsing. Therefore, we emit it as 'double' and convert via 'fptrunc'.
            let raw_cstr = call make_cstr(ctx.alloc, operand.str_ptr, operand.str_len);
            let tmp_f = call fresh_tmp_str(ctx, "lit_f32", 7);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, tmp_f, call strlen(tmp_f));
            let _ = call emit_str(ctx, " = fptrunc double ", 18);
            let _ = call emit_str(ctx, raw_cstr, call strlen(raw_cstr));
            let _ = call emit_str(ctx, " to float", 9);
            let _ = call emit_nl(ctx);
            _ => return tmp_f;
        }
        FailOperand: {
            _ => return "null";
        }
        Classify: {
            let s_l = call strlen(s_type);
            let d_l = call strlen(d_type);
            let is_same = call str_eq(s_type, s_l, d_type, d_l);
            is_same != 0 => ReturnNop;

            let map_s = call map_type_ptr(ctx, s_type, s_l);
            let map_s_l = call map_type_len(ctx, s_type, s_l);
            let map_d = call map_type_ptr(ctx, d_type, d_l);
            let map_d_l = call map_type_len(ctx, d_type, d_l);
            let is_llvm_same = call str_eq(map_s, map_s_l, map_d, map_d_l);
            is_llvm_same != 0 => ReturnNop;

            let is_dst_q = call is_type_q64(d_type);
            is_dst_q != 0 => CastToQ64;

            let is_src_q = call is_type_q64(s_type);
            is_src_q != 0 => CastFromQ64;

            src_is_ptr != 0 => SrcIsPtr;
            dst_is_ptr != 0 => SrcIsInt;

            let is_src_fp = call is_type_float_or_vec(s_type, s_l);
            let is_dst_fp = call is_type_float_or_vec(d_type, d_l);
            is_src_fp != 0 => SrcIsFloat;
            is_dst_fp != 0 => DstIsFloat;

            _               => SrcIsInt;
        }
        SrcIsFloat: {
            let d_l = call strlen(d_type);
            let is_dst_fp = call is_type_float_or_vec(d_type, d_l);
            is_dst_fp != 0 => FpToFp;
            _              => FpToInt;
        }
        DstIsFloat: {
            _ => IntToFp;
        }
        FpToFp: {
            let s_l = call strlen(s_type);
            let is_f32 = call str_eq(s_type, s_l, "f32", 3);
            is_f32 != 0 => DoFpExt;
            _           => DoFpTrunc;
        }
        DoFpExt: {
            let res = call emit_cast_op(ctx, "fpext", 5, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        DoFpTrunc: {
            let res = call emit_cast_op(ctx, "fptrunc", 7, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        IntToFp: {
            let is_signed = call is_type_signed(s_type);
            is_signed != 0 => DoSitofp;
            _              => DoUitofp;
        }
        DoSitofp: {
            let res = call emit_cast_op(ctx, "sitofp", 6, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        DoUitofp: {
            let res = call emit_cast_op(ctx, "uitofp", 6, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        FpToInt: {
            let is_signed = call is_type_signed(d_type);
            is_signed != 0 => DoFptosi;
            _              => DoFptoui;
        }
        DoFptosi: {
            let res = call emit_cast_op(ctx, "fptosi", 6, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        DoFptoui: {
            let res = call emit_cast_op(ctx, "fptoui", 6, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        ReturnNop: {
            _ => return val_str;
        }
        CastToQ64: {
            let s_l = call strlen(s_type);
            let is_src_fp = call is_type_float_or_vec(s_type, s_l);
            is_src_fp != 0 => CastToQ64_Fp;

            let s_bits = call get_type_bit_width(s_type);
            s_bits < 64 => CastToQ64_Ext;
            _           => CastToQ64_Shl [ ext_val <= val_str ];
        }
        CastToQ64_Fp: {
            let s_l = call strlen(s_type);
            let is_f32 = call str_eq(s_type, s_l, "f32", 3);
            let is_float = call str_eq(s_type, s_l, "float", 5);
            let is_fp32 = is_f32 | is_float;
            is_fp32 != 0 => CastToQ64_Fpext;
            _ => CastToQ64_Mul [ ext_val <= val_str ];
        }
        CastToQ64_Fpext: {
            let ext = call emit_cast_op(ctx, "fpext", 5, s_type, call strlen(s_type), "double", 6, val_str);
            _ => CastToQ64_Mul [ ext_val <= ext ];
        }
        CastToQ64_Mul: {
            let tmp_mul = call fresh_tmp_str(ctx, "fmul_q", 6);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, tmp_mul, call strlen(tmp_mul));
            let _ = call emit_str(ctx, " = fmul double ", 15);
            let _ = call emit_str(ctx, ext_val, call strlen(ext_val));
            let _ = call emit_str(ctx, ", 4294967296.0", 14);
            let _ = call emit_nl(ctx);

            let res = call emit_cast_op(ctx, "fptosi", 6, "double", 6, "i64", 3, tmp_mul);
            _ => return res;
        }
        CastToQ64_Ext: {
            let is_signed = call is_type_signed(s_type);
            is_signed != 0 => CastToQ64_Sext;
            _              => CastToQ64_Zext;
        }
        CastToQ64_Sext: {
            let ext = call emit_cast_op(ctx, "sext", 4, s_type, call strlen(s_type), "i64", 3, val_str);
            _ => CastToQ64_Shl [ ext_val <= ext ];
        }
        CastToQ64_Zext: {
            let ext = call emit_cast_op(ctx, "zext", 4, s_type, call strlen(s_type), "i64", 3, val_str);
            _ => CastToQ64_Shl [ ext_val <= ext ];
        }
        CastToQ64_Shl: {
            let res = call fresh_tmp_str(ctx, "shl_q", 5);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res, call strlen(res));
            let _ = call emit_str(ctx, " = shl i64 ", 11);
            let _ = call emit_str(ctx, ext_val, call strlen(ext_val));
            let _ = call emit_str(ctx, ", 32", 4);
            let _ = call emit_nl(ctx);
            _ => return res;
        }
        CastFromQ64: {
            let d_l = call strlen(d_type);
            let is_dst_fp = call is_type_float_or_vec(d_type, d_l);
            is_dst_fp != 0 => CastFromQ64_Fp;
            _              => CastFromQ64_Int;
        }
        CastFromQ64_Fp: {
            let tmp_sitofp = call fresh_tmp_str(ctx, "q2fp", 4);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, tmp_sitofp, call strlen(tmp_sitofp));
            let _ = call emit_str(ctx, " = sitofp i64 ", 14);
            let _ = call emit_str(ctx, val_str, call strlen(val_str));
            let _ = call emit_str(ctx, " to double", 10);
            let _ = call emit_nl(ctx);

            let tmp_div = call fresh_tmp_str(ctx, "q_div", 5);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, tmp_div, call strlen(tmp_div));
            let _ = call emit_str(ctx, " = fdiv double ", 15);
            let _ = call emit_str(ctx, tmp_sitofp, call strlen(tmp_sitofp));
            let _ = call emit_str(ctx, ", 4294967296.0", 14);
            let _ = call emit_nl(ctx);

            let d_l = call strlen(d_type);
            let is_f32 = call str_eq(d_type, d_l, "f32", 3);
            let is_float = call str_eq(d_type, d_l, "float", 5);
            let is_either = is_f32 | is_float;
            is_either != 0 => CastFromQ64_TruncFp [ shr_val <= tmp_div ];
            _ => return tmp_div;
        }
        CastFromQ64_TruncFp: {
            let res = call emit_cast_op(ctx, "fptrunc", 7, "double", 6, "float", 5, shr_val);
            _ => return res;
        }
        CastFromQ64_Int: {
            let shr = call fresh_tmp_str(ctx, "shr_q", 5);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, shr, call strlen(shr));
            let _ = call emit_str(ctx, " = ashr i64 ", 12);
            let _ = call emit_str(ctx, val_str, call strlen(val_str));
            let _ = call emit_str(ctx, ", 32", 4);
            let _ = call emit_nl(ctx);

            let d_bits = call get_type_bit_width(d_type);
            d_bits < 64 => CastFromQ64_Trunc [ shr_val <= shr ];
            _           => ReturnShr [ shr_val <= shr ];
        }
        ReturnShr: {
            _ => return shr_val;
        }
        CastFromQ64_Trunc: {
            let res = call emit_cast_op(ctx, "trunc", 5, "i64", 3, d_type, call strlen(d_type), shr_val);
            _ => return res;
        }
        SrcIsPtr: {
            dst_is_ptr != 0 => PtrToPtr;
            _               => PtrToInt;
        }
        SrcIsInt: {
            dst_is_ptr != 0 => IntToPtr;
            _               => IntToInt;
        }
        PtrToPtr: {
            let res = call emit_cast_op(ctx, "bitcast", 7, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        PtrToInt: {
            let res = call emit_cast_op(ctx, "ptrtoint", 8, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        IntToPtr: {
            let res = call emit_cast_op(ctx, "inttoptr", 8, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        IntToInt: {
            let s_bits = call get_type_bit_width(s_type);
            let d_bits = call get_type_bit_width(d_type);

            s_bits < d_bits => CheckIntSign;
            s_bits > d_bits => DoTrunc;
            _               => ReturnNop;
        }
        CheckIntSign: {
            let is_signed = call is_type_signed(s_type);
            is_signed != 0 => DoSext;
            _              => DoZext;
        }
        DoSext: {
            let res = call emit_cast_op(ctx, "sext", 4, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        DoZext: {
            let res = call emit_cast_op(ctx, "zext", 4, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
        DoTrunc: {
            let res = call emit_cast_op(ctx, "trunc", 5, s_type, call strlen(s_type), d_type, call strlen(d_type), val_str);
            _ => return res;
        }
    }
}

machine emit_expr(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg cast_res: *u8 = null;
        reg cast_bt:  *TypeDef = null;
        wire kind = expr.kind;
    }
    states {
        Entry: {
            expr == null => ReturnNull;
            kind == 1    => EmitIntLit;
            kind == 2    => EmitStringLit;
            kind == 3    => EmitNullLit;
            kind == 4    => EmitVarExpr;
            kind == 5    => EmitBinaryExpr;
            kind == 6    => EmitUnaryExpr;
            kind == 7    => EmitFieldExpr;
            kind == 8    => EmitCallExpr;
            kind == 9    => EmitStructLit;
            kind == 10   => EmitCastExpr;
            kind == 11   => EmitIntLit;
            _            => ReturnNull;
        }
        ReturnNull: {
            _ => return "null";
        }
        EmitVarExpr: {
            let res = call emit_var(ctx, expr);
            _ => return res;
        }
        EmitIntLit: {
            let res = call emit_int_lit(ctx, expr);
            _ => return res;
        }
        EmitStringLit: {
            let res = call emit_string_lit(ctx, expr);
            _ => return res;
        }
        EmitNullLit: {
            _ => return "null";
        }
        EmitBinaryExpr: {
            let res = call emit_bin_expr(ctx, expr);
            _ => return res;
        }
        EmitUnaryExpr: {
            let res = call emit_un_expr(ctx, expr);
            _ => return res;
        }
        EmitCallExpr: {
            let res = call emit_call_expr(ctx, expr);
            _ => return res;
        }
        EmitFieldExpr: {
            let res = call emit_field_expr(ctx, expr);
            _ => return res;
        }
        EmitStructLit: {
            let res = call emit_struct_lit(ctx, expr);
            _ => return res;
        }
        EmitCastExpr: {
            let res = call emit_cast_expr(ctx, expr);
            let btype = call find_bounded_type(ctx.prog, expr.str_ptr, expr.str_len);
            btype != null => ClampCast [ cast_res <= res, cast_bt <= btype ];
            _             => return res;
        }
        ClampCast: {
            let cr = call emit_clamp(ctx, cast_res, cast_bt);
            _ => return cr;
        }
    }
}

machine emit_var(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg res_p: *u8 = null;
        reg wire_matched: *WireDef = null;
        reg wire_mask_reg: u64 = 0;
        reg clamped_res: *u8 = null;
        reg cur_btype: *TypeDef = null;
        wire name_p = expr.str_ptr;
        wire name_l = expr.str_len;
        wire m = ctx.cur_machine;
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            // "null" チェック
            let is_null = call str_eq(name_p, name_l, "null", 4);
            is_null != 0 => ReturnNull;

            // 現在のブロック環境 (cur_env) に登録されているか？
            let ssa_p = call env_get_ptr(ctx, name_p, name_l);
            ssa_p != null => ReturnEnv [ res_p <= ssa_p ];

            // マシンパラメータか？ -> "%arg_name"
            let is_param = call find_param_idx(m, name_p, name_l);
            is_param >= 0 => ReturnParam;

            // マシンのワイヤーか？ -> オンデマンド展開して env に記録
            let wire_ptr = call find_wire(m, name_p, name_l);
            wire_ptr != null => ExpandWire;

            _ => FailUndefined;
        }
        FailUndefined: {
            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            let _ = call diag_str("COMPILATION ERROR: Undefined operand variable '");
            let _ = call diag_write(name_p, name_l);
            let _ = call diag_str("'");
            m != null => PrintOperandMachine;
            _ => PrintOperandState;
        }
        PrintOperandMachine: {
            let _ = call diag_str(" in machine '");
            let _ = call diag_write(m.name_ptr, m.name_len);
            let _ = call diag_str("'");
            _ => PrintOperandState;
        }
        PrintOperandState: {
            let sp = ctx.cur_state_p;
            sp != null => PrintOperandStateName;
            _ => EndOperandError;
        }
        PrintOperandStateName: {
            let _ = call diag_str(" state '");
            let _ = call diag_write(ctx.cur_state_p, ctx.cur_state_l);
            let _ = call diag_str("'");
            _ => EndOperandError;
        }
        EndOperandError: {
            let _ = call diag_nl();
            let _ = call diag_str("Deterministic Definition Violation: Operand variable must be strictly defined in scope.");
            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            ctx.error_code <- -51;
            _ => ReturnNull;
        }
        ReturnNull: {
            _ => return "null";
        }
        ReturnParam: {
            let b_p_start = alloc.base_ptr;
            let off_p_start = alloc.offset;
            let p_start = b_p_start + off_p_start;
            let _ = call append_str_to_alloc(alloc, "%arg_", 5);
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let _ = call append_char_to_alloc(alloc, 0);
            _ => return p_start;
        }
        ReturnEnv: {
            _ => return res_p;
        }
        ExpandWire: {
            let widx = call find_wire_idx(m, name_p, name_l);
            widx < 0 => ReturnNull;
            let u_widx = cast(u64) widx;
            let one64 = cast(u64) 1;
            let mask = one64 << u_widx;
            let in_prog = ctx.wire_in_progress;
            let in_prog_masked = in_prog & mask;
            let is_cyclic = in_prog_masked != 0;
            is_cyclic != 0 => EmitCyclicWireError;

            // Mark wire in progress
            let next_prog = in_prog | mask;
            ctx.wire_in_progress <- next_prog;

            let wire_ptr = m.wires + widx;
            _ => DoExpandWire [ wire_matched <= wire_ptr, wire_mask_reg <= cast(u64) mask ];
        }
        DoExpandWire: {
            let wire_res = call emit_expr(ctx, wire_matched.expr);

            // Unmark wire
            let cur_prog = ctx.wire_in_progress;
            let unmark_prog = cur_prog ^ wire_mask_reg;
            ctx.wire_in_progress <- unmark_prog;

            let wt = call get_expr_type(ctx, wire_matched.expr);
            let btype = call find_bounded_type(ctx.prog, wt, call strlen(wt));
            btype != null => ClampWire [ clamped_res <= wire_res, cur_btype <= btype ];
            _ => return wire_res;
        }
        ClampWire: {
            let c_res = call emit_clamp(ctx, clamped_res, cur_btype);
            _ => return c_res;
        }
        EmitCyclicWireError: {
            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            let _ = call diag_str("[StateSSA Compile Error]: Cyclic wire dependency detected for wire '");
            let _ = call diag_write(name_p, name_l);
            let _ = call diag_str("' (CWE-674/CWE-400 Prevention).");
            let _ = call diag_nl();
            let _ = call diag_str("Recursive or cyclic wire definitions are strictly prohibited.");
            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            ctx.error_code <- -61;
            _ => return "null";
        }
    }
}

machine emit_int_lit(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {
        reg start_p: *u8 = null;
        wire val = expr.int_val;
        wire alloc = ctx.alloc;
        wire b_cur_p = alloc.base_ptr;
        wire off_cur_p = alloc.offset;
        wire cur_p = b_cur_p + off_cur_p;
    }
    states {
        Entry: {
            _ => Emit [ start_p <= cur_p ];
        }
        Emit: {
            let _ = call append_i64_to_alloc(alloc, val);
            let _ = call append_char_to_alloc(alloc, 0); // null終端
            _ => Exit;
        }
        Exit: {
            _ => return start_p;
        }
    }
}

machine emit_string_lit(ctx: *CodegenCtx, expr: *ExprNode) -> *u8 {
    flow {}
    states {
        Entry: {
            let sym_id = call collect_string_const(ctx, expr.str_ptr, expr.str_len);
            let res_var = call fresh_tmp_str(ctx, "str", 3);
            let fld_byte_len = expr.str_len;
            let byte_len = fld_byte_len + 1;

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = getelementptr inbounds [", 27);
            let _ = call emit_u32(ctx, byte_len);
            let _ = call emit_str(ctx, " x i8], [", 9);
            let _ = call emit_u32(ctx, byte_len);
            let _ = call emit_str(ctx, " x i8]* @.str_", 14);
            let _ = call emit_u32(ctx, sym_id);
            let _ = call emit_str(ctx, ", i64 0, i64 0", 14);
            let _ = call emit_nl(ctx);

            _ => return res_var;
        }
    }
}

machine emit_ptr_cmp_op(ctx: *CodegenCtx, op: u32) -> u32 {
    flow {}
    states {
        Entry: {
            op == 46 => EmitEq;
            _        => EmitNe;
        }
        EmitEq: {
            let _ = call emit_str(ctx, "eq ptr ", 7);
            _ => return 0;
        }
        EmitNe: {
            let _ = call emit_str(ctx, "ne ptr ", 7);
            _ => return 0;
        }
    }
}

machine emit_ext_to_type(ctx: *CodegenCtx, src_t: *u8, target_t: *u8, val: *u8) -> *u8 {
    flow {
        reg op_p: *u8 = "zext";
    }
    states {
        Entry: {
            src_t == null => ReturnSame;
            let sl = call strlen(src_t);
            let tl = call strlen(target_t);
            let sm_p = call map_type_ptr(ctx, src_t, sl);
            let sm_l = call map_type_len(ctx, src_t, sl);
            let tm_p = call map_type_ptr(ctx, target_t, tl);
            let tm_l = call map_type_len(ctx, target_t, tl);
            let is_same = call str_eq(sm_p, sm_l, tm_p, tm_l);
            is_same != 0 => ReturnSame;

            let is_i8 = call str_eq(src_t, sl, "i8", 2);
            is_i8 != 0 => SetSext;
            let is_i16 = call str_eq(src_t, sl, "i16", 3);
            is_i16 != 0 => SetSext;
            let is_i32 = call str_eq(src_t, sl, "i32", 3);
            is_i32 != 0 => SetSext;
            _ => DoEmit;
        }
        ReturnSame: {
            _ => return val;
        }
        SetSext: {
            _ => DoEmit [ op_p <= "sext" ];
        }
        DoEmit: {
            let sl = call strlen(src_t);
            let tl = call strlen(target_t);
            let sm_p = call map_type_ptr(ctx, src_t, sl);
            let sm_l = call map_type_len(ctx, src_t, sl);
            let tm_p = call map_type_ptr(ctx, target_t, tl);
            let tm_l = call map_type_len(ctx, target_t, tl);

            let res_var = call fresh_tmp_str(ctx, "ext", 3);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = ", 3);
            let _ = call emit_str(ctx, op_p, 4);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, sm_p, sm_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, val, call strlen(val));
            let _ = call emit_str(ctx, " to ", 4);
            let _ = call emit_str(ctx, tm_p, tm_l);
            let _ = call emit_nl(ctx);
            _ => return res_var;
        }
    }
}

machine emit_ptr_gep(ctx: *CodegenCtx, left_val: *u8, left_type_p: *u8, right_val: *u8, right_type_p: *u8) -> *u8 {
    flow {
        reg res_var_reg: *u8 = null;
    }
    states {
        Entry: {
            let res_var = call fresh_tmp_str(ctx, "gep", 3);
            let elem_p = left_type_p + 1;
            let elem_l = call strlen(elem_p);
            let mapped_p = call map_type_ptr(ctx, elem_p, elem_l);
            let mapped_l = call map_type_len(ctx, elem_p, elem_l);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = getelementptr inbounds ", 26);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, mapped_p, mapped_l);
            let _ = call emit_str(ctx, "* ", 2);
            let _ = call emit_str(ctx, left_val, call strlen(left_val));

            let is_64 = call is_type_64(right_type_p);
            is_64 != 0 => EmitGep64 [ res_var_reg <= res_var ];
            _          => EmitGep32 [ res_var_reg <= res_var ];
        }
        EmitGep64: {
            let _ = call emit_str(ctx, ", i64 ", 6);
            _ => EmitGepTail;
        }
        EmitGep32: {
            let _ = call emit_str(ctx, ", i32 ", 6);
            _ => EmitGepTail;
        }
        EmitGepTail: {
            let _ = call emit_str(ctx, right_val, call strlen(right_val));
            let _ = call emit_nl(ctx);
            _ => return res_var_reg;
        }
    }
}

machine emit_ptr_diff(ctx: *CodegenCtx, left_val: *u8, left_type_p: *u8, right_val: *u8, right_type_p: *u8) -> *u8 {
    flow {
        reg diff_var: *u8 = null;
        reg elem_sz_r: u32 = 1;
    }
    states {
        Entry: {
            let t1 = call fresh_tmp_str(ctx, "p2i", 3);
            let t2 = call fresh_tmp_str(ctx, "p2i", 3);
            let raw_diff = call fresh_tmp_str(ctx, "diff", 4);

            let l_len = call strlen(left_type_p);
            let lm_p = call map_type_ptr(ctx, left_type_p, l_len);
            let lm_l = call map_type_len(ctx, left_type_p, l_len);

            let r_len = call strlen(right_type_p);
            let rm_p = call map_type_ptr(ctx, right_type_p, r_len);
            let rm_l = call map_type_len(ctx, right_type_p, r_len);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, t1, call strlen(t1));
            let _ = call emit_str(ctx, " = ptrtoint ", 12);
            let _ = call emit_str(ctx, lm_p, lm_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, left_val, call strlen(left_val));
            let _ = call emit_str(ctx, " to i64", 7);
            let _ = call emit_nl(ctx);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, t2, call strlen(t2));
            let _ = call emit_str(ctx, " = ptrtoint ", 12);
            let _ = call emit_str(ctx, rm_p, rm_l);
            let _ = call emit_str(ctx, " ", 1);
            let _ = call emit_str(ctx, right_val, call strlen(right_val));
            let _ = call emit_str(ctx, " to i64", 7);
            let _ = call emit_nl(ctx);

            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, raw_diff, call strlen(raw_diff));
            let _ = call emit_str(ctx, " = sub i64 ", 11);
            let _ = call emit_str(ctx, t1, call strlen(t1));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, t2, call strlen(t2));
            let _ = call emit_nl(ctx);

            let elem_t = left_type_p + 1; // skip '*'
            let elem_l = l_len - 1;
            let elem_sz = call get_type_byte_size(ctx.prog, elem_t, elem_l);
            elem_sz > 1 => DivElem [ diff_var <= raw_diff, elem_sz_r <= elem_sz ];
            _           => ReturnDiff [ diff_var <= raw_diff ];
        }
        DivElem: {
            let scaled_diff = call fresh_tmp_str(ctx, "scaled_diff", 11);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, scaled_diff, call strlen(scaled_diff));
            let _ = call emit_str(ctx, " = sdiv i64 ", 12);
            let _ = call emit_str(ctx, diff_var, call strlen(diff_var));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_u32(ctx, elem_sz_r);
            let _ = call emit_nl(ctx);
            _ => ReturnDiff [ diff_var <= scaled_diff ];
        }
        ReturnDiff: {
            _ => return diff_var;
        }
    }
}

machine emit_ptr_cmp(ctx: *CodegenCtx, left_val: *u8, right_val: *u8, op: u32) -> *u8 {
    flow {}
    states {
        Entry: {
            let res_var = call fresh_tmp_str(ctx, "pcmp", 4);
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res_var, call strlen(res_var));
            let _ = call emit_str(ctx, " = icmp ", 8);
            let _ = call emit_ptr_cmp_op(ctx, op);
            let _ = call emit_operands(ctx, left_val, right_val);
            let _ = call emit_nl(ctx);
            _ => return res_var;
        }
    }
}

machine promote_bin_operand(ctx: *CodegenCtx, expr: *ExprNode, type_p: *u8, val: *u8, op_mode: u32) -> *u8 {
    flow {
        wire is_i1 = op_mode == 1;
        wire is_lit = expr.kind == 1; // INT_LIT
        wire skip = is_i1 || is_lit;
        wire is_64 = (op_mode == 2) || (op_mode == 3);
    }
    states {
        Entry: {
            skip  => ReturnDirect;
            is_64 => Promote64;
            _     => Promote32;
        }
        ReturnDirect: {
            _ => return val;
        }
        Promote64: {
            let res = call emit_ext_to_type(ctx, type_p, "i64", val);
            _ => return res;
        }
        Promote32: {
            let res = call emit_ext_to_type(ctx, type_p, "i32", val);
            _ => return res;
        }
    }
}

machine emit_q64_mul(ctx: *CodegenCtx, left_val: *u8, right_val: *u8) -> *u8 {
    flow {}
    states {
        Entry: {
            let sext_l = call fresh_tmp_str(ctx, "qmul_l", 6);
            let sext_r = call fresh_tmp_str(ctx, "qmul_r", 6);
            let mul128 = call fresh_tmp_str(ctx, "qmul128", 7);
            let shr128 = call fresh_tmp_str(ctx, "qmul_shr", 8);
            let res    = call fresh_tmp_str(ctx, "qmul_res", 8);

            // %sext_l = sext i64 %left_val to i128
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, sext_l, call strlen(sext_l));
            let _ = call emit_str(ctx, " = sext i64 ", 12);
            let _ = call emit_str(ctx, left_val, call strlen(left_val));
            let _ = call emit_str(ctx, " to i128", 8);
            let _ = call emit_nl(ctx);

            // %sext_r = sext i64 %right_val to i128
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, sext_r, call strlen(sext_r));
            let _ = call emit_str(ctx, " = sext i64 ", 12);
            let _ = call emit_str(ctx, right_val, call strlen(right_val));
            let _ = call emit_str(ctx, " to i128", 8);
            let _ = call emit_nl(ctx);

            // %mul128 = mul i128 %sext_l, %sext_r
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, mul128, call strlen(mul128));
            let _ = call emit_str(ctx, " = mul i128 ", 11);
            let _ = call emit_str(ctx, sext_l, call strlen(sext_l));
            let _ = call emit_str(ctx, ", ", 2);
            let _ = call emit_str(ctx, sext_r, call strlen(sext_r));
            let _ = call emit_nl(ctx);

            // %shr128 = ashr i128 %mul128, 32
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, shr128, call strlen(shr128));
            let _ = call emit_str(ctx, " = ashr i128 ", 12);
            let _ = call emit_str(ctx, mul128, call strlen(mul128));
            let _ = call emit_str(ctx, ", 32", 4);
            let _ = call emit_nl(ctx);

            // %res = trunc i128 %shr128 to i64
            let _ = call emit_str(ctx, "  ", 2);
            let _ = call emit_str(ctx, res, call strlen(res));
            let _ = call emit_str(ctx, " = trunc i128 ", 13);
            let _ = call emit_str(ctx, shr128, call strlen(shr128));
            let _ = call emit_str(ctx, " to i64", 7);
            let _ = call emit_nl(ctx);

            _ => return res;
        }
    }
}

machine emit_q64_div(ctx: *CodegenCtx, left_val: *u8, right_val: *u8) -> *u8 {
    flow {}
    states {
        Entry: {
            let sext_l = call fresh_tmp_str(ctx, "qdiv_l", 6);
