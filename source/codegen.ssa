machine register_type_map(ctx: *CodegenCtx, src_p: *u8, src_l: u32, llvm_p: *u8, llvm_l: u32) -> u32 {
    flow {
        wire idx = ctx.type_map_cnt;
        wire fld_entry = ctx.type_map;
        wire entry = fld_entry + idx;
    }
    states {
        Entry: {
            entry.src_ptr  <- src_p;
            entry.src_len  <- src_l;
            entry.llvm_ptr <- llvm_p;
            entry.llvm_len <- llvm_l;
            ctx.type_map_cnt <- idx + 1;
            _ => return ctx.type_map_cnt;
        }
    }
}

machine init_builtin_types(ctx: *CodegenCtx) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call register_type_map(ctx, "i32", 3, "i32", 3);
            let _ = call register_type_map(ctx, "*i32", 4, "i32*", 4);
            let _ = call register_type_map(ctx, "u32", 3, "i32", 3);
            let _ = call register_type_map(ctx, "*u32", 4, "i32*", 4);
            let _ = call register_type_map(ctx, "i64", 3, "i64", 3);
            let _ = call register_type_map(ctx, "*i64", 4, "i64*", 4);
            let _ = call register_type_map(ctx, "u64", 3, "i64", 3);
            let _ = call register_type_map(ctx, "*u64", 4, "i64*", 4);
            let _ = call register_type_map(ctx, "u16", 3, "i16", 3);
            let _ = call register_type_map(ctx, "*u16", 4, "i16*", 4);
            let _ = call register_type_map(ctx, "i16", 3, "i16", 3);
            let _ = call register_type_map(ctx, "*i16", 4, "i16*", 4);
            let _ = call register_type_map(ctx, "u8", 2, "i8", 2);
            let _ = call register_type_map(ctx, "*u8", 3, "i8*", 3);
            let _ = call register_type_map(ctx, "i8", 2, "i8", 2);
            let _ = call register_type_map(ctx, "*i8", 3, "i8*", 3);
            let _ = call register_type_map(ctx, "i1", 2, "i1", 2);
            let _ = call register_type_map(ctx, "*i1", 3, "i1*", 3);
            let _ = call register_type_map(ctx, "*void", 5, "i8*", 3);
            let _ = call register_type_map(ctx, "void", 4, "void", 4);
            let _ = call register_type_map(ctx, "q64", 3, "i64", 3);
            let _ = call register_type_map(ctx, "*q64", 4, "i64*", 4);
            let _ = call register_type_map(ctx, "f32", 3, "float", 5);
            let _ = call register_type_map(ctx, "*f32", 4, "float*", 6);
            let _ = call register_type_map(ctx, "f64", 3, "double", 6);
            let _ = call register_type_map(ctx, "*f64", 4, "double*", 7);
            let _ = call register_type_map(ctx, "f32x4", 5, "<4 x float>", 12);
            let _ = call register_type_map(ctx, "*f32x4", 6, "<4 x float>*", 13);
            let _ = call register_type_map(ctx, "f32x8", 5, "<8 x float>", 12);
            let _ = call register_type_map(ctx, "*f32x8", 6, "<8 x float>*", 13);
            let _ = call register_type_map(ctx, "f32x16", 6, "<16 x float>", 13);
            let _ = call register_type_map(ctx, "*f32x16", 7, "<16 x float>*", 14);
            let _ = call register_type_map(ctx, "f64x2", 5, "<2 x double>", 13);
            let _ = call register_type_map(ctx, "*f64x2", 6, "<2 x double>*", 14);
            let _ = call register_type_map(ctx, "f64x4", 5, "<4 x double>", 13);
            let _ = call register_type_map(ctx, "*f64x4", 6, "<4 x double>*", 14);
            let _ = call register_type_map(ctx, "f64x8", 5, "<8 x double>", 13);
            let _ = call register_type_map(ctx, "*f64x8", 6, "<8 x double>*", 14);
            let _ = call register_type_map(ctx, "i32x4", 5, "<4 x i32>", 10);
            let _ = call register_type_map(ctx, "*i32x4", 6, "<4 x i32>*", 11);
            let _ = call register_type_map(ctx, "i32x8", 5, "<8 x i32>", 10);
            let _ = call register_type_map(ctx, "*i32x8", 6, "<8 x i32>*", 11);
            let _ = call register_type_map(ctx, "i32x16", 6, "<16 x i32>", 11);
            let _ = call register_type_map(ctx, "*i32x16", 7, "<16 x i32>*", 12);
            let _ = call register_type_map(ctx, "u8x16", 5, "<16 x i8>", 10);
            let _ = call register_type_map(ctx, "*u8x16", 6, "<16 x i8>*", 11);
            let _ = call register_type_map(ctx, "u8x32", 5, "<32 x i8>", 10);
            let _ = call register_type_map(ctx, "*u8x32", 6, "<32 x i8>*", 11);
            let _ = call register_type_map(ctx, "u8x64", 5, "<64 x i8>", 10);
            let _ = call register_type_map(ctx, "*u8x64", 6, "<64 x i8>*", 11);
            _ => return 0;
        }
    }
}

machine register_struct_type_map(ctx: *CodegenCtx, name_p: *u8, name_l: u32) -> u32 {
    flow {
        wire alloc = ctx.alloc;
    }
    states {
        Entry: {
            // "%struct.Name"
            let b_s_start = alloc.base_ptr;
            let off_s_start = alloc.offset;
            let s_start = b_s_start + off_s_start;
            let _ = call append_str_to_alloc(alloc, "%struct.", 8);
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let s_len = name_l + 8;
            let _ = call register_type_map(ctx, name_p, name_l, s_start, s_len);

            // "*Name" -> "%struct.Name*"
            let b_star_start = alloc.base_ptr;
            let off_star_start = alloc.offset;
            let star_start = b_star_start + off_star_start;
            let _ = call append_char_to_alloc(alloc, 42); // '*'
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let star_src_len = name_l + 1;

            let b_sptr_start = alloc.base_ptr;
            let off_sptr_start = alloc.offset;
            let sptr_start = b_sptr_start + off_sptr_start;
            let _ = call append_str_to_alloc(alloc, "%struct.", 8);
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let _ = call append_char_to_alloc(alloc, 42); // '*'
            let sptr_len = name_l + 9;

            let _ = call register_type_map(ctx, star_start, star_src_len, sptr_start, sptr_len);
            _ => return 0;
        }
    }
}

machine register_alias_type_map(ctx: *CodegenCtx, name_p: *u8, name_l: u32, base_p: *u8, base_l: u32) -> u32 {
    flow {
        wire alloc = ctx.alloc;
        wire mapped_llvm = call map_type_ptr(ctx, base_p, base_l);
        wire mapped_len = call map_type_len(ctx, base_p, base_l);
    }
    states {
        Entry: {
            let _ = call register_type_map(ctx, name_p, name_l, mapped_llvm, mapped_len);

            let b_star = alloc.base_ptr;
            let off_star = alloc.offset;
            let star_src_p = b_star + off_star;
            let _ = call append_char_to_alloc(alloc, 42); // '*'
            let _ = call append_str_to_alloc(alloc, name_p, name_l);
            let _ = call append_char_to_alloc(alloc, 0);
            let star_src_l = name_l + 1;

            let b_llvm = alloc.base_ptr;
            let off_llvm = alloc.offset;
            let star_llvm_p = b_llvm + off_llvm;
            let _ = call append_str_to_alloc(alloc, mapped_llvm, mapped_len);
            let _ = call append_char_to_alloc(alloc, 42); // '*'
            let _ = call append_char_to_alloc(alloc, 0);
            let star_llvm_l = mapped_len + 1;

            let _ = call register_type_map(ctx, star_src_p, star_src_l, star_llvm_p, star_llvm_l);
            _ => return 0;
        }
    }
}

machine register_one_type_def(ctx: *CodegenCtx, t_ptr: *TypeDef) -> u32 {
    flow {}
    states {
        Entry: {
            let k = t_ptr.kind;
            k == 1 => RegAliasKind;
            k == 2 => RegAliasKind;
            let f_cnt = t_ptr.field_count;
            f_cnt == 1 => CheckAlias;
            _          => RegStruct;
        }
        RegAliasKind: {
            let _ = call register_alias_type_map(ctx, t_ptr.name_ptr, t_ptr.name_len, t_ptr.base_ptr, t_ptr.base_len);
            _ => return 0;
        }
        CheckAlias: {
            let f0 = t_ptr.fields;
            let f0_nl = f0.name_len;
            f0_nl == 0 => RegAlias;
            _          => RegStruct;
        }
        RegAlias: {
            let f0 = t_ptr.fields;
            let _ = call register_alias_type_map(ctx, t_ptr.name_ptr, t_ptr.name_len, f0.type_ptr, f0.type_len);
            _ => return 0;
        }
        RegStruct: {
            let _ = call register_struct_type_map(ctx, t_ptr.name_ptr, t_ptr.name_len);
            _ => return 0;
        }
    }
}

machine init_type_registry(ctx: *CodegenCtx) -> u32 {
    flow {
        reg t_idx: u32 = 0;
        wire prog = ctx.prog;
        wire t_cnt = prog.type_count;
        wire has_more_types = t_idx < t_cnt;
        wire fld_t_ptr = prog.types;
        wire t_ptr = fld_t_ptr + t_idx;
    }
    states {
        Entry: {
            let _ = call init_builtin_types(ctx);
            _ => TypesLoop [ t_idx <= 0 ];
        }
        TypesLoop: {
            has_more_types != 0 => ProcessType;
            _                   => Exit;
        }
        ProcessType: {
            let _ = call register_one_type_def(ctx, t_ptr);
            _ => TypesLoop [ t_idx <= t_idx + 1 ];
        }
        Exit: {
            _ => return ctx.type_map_cnt;
        }
    }
}

machine find_type_map_entry(ctx: *CodegenCtx, type_p: *u8, type_l: u32) -> *TypeMapEntry {
    flow {
        reg i: u32 = 0;
        wire cnt = ctx.type_map_cnt;
        wire has_more = i < cnt;
        wire fld_entry = ctx.type_map;
        wire cur_entry = fld_entry + i;
        wire is_match = call str_eq(cur_entry.src_ptr, cur_entry.src_len, type_p, type_l);
    }
    states {
        Entry: {
            _ => Loop [ i <= 0 ];
        }
        Loop: {
            has_more == 0 => NotFound;
            is_match != 0 => Found;
            _             => Loop [ i <= i + 1 ];
        }
        Found: {
            _ => return cur_entry;
        }
        NotFound: {
            _ => return null;
        }
    }
}

machine map_type_ptr(ctx: *CodegenCtx, type_p: *u8, type_l: u32) -> *u8 {
    flow {
        reg m_matched: *TypeMapEntry = null;
    }
    states {
        Entry: {
            let m = call find_type_map_entry(ctx, type_p, type_l);
            m == null => ReturnDefault;
            _         => ReturnMapped [ m_matched <= m ];
        }
        ReturnMapped: {
            let p = m_matched.llvm_ptr;
            _ => return p;
        }
        ReturnDefault: {
            _ => return type_p;
        }
    }
}

machine map_type_len(ctx: *CodegenCtx, type_p: *u8, type_l: u32) -> u32 {
    flow {
        reg m_matched: *TypeMapEntry = null;
    }
    states {
        Entry: {
            let m = call find_type_map_entry(ctx, type_p, type_l);
            m == null => ReturnDefault;
            _         => ReturnMapped [ m_matched <= m ];
        }
        ReturnMapped: {
            let l = m_matched.llvm_len;
            _ => return l;
        }
        ReturnDefault: {
            _ => return type_l;
        }
    }
}

machine check_base_type_valid(ctx: *CodegenCtx, t_p: *u8, t_l: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire has_more = i < t_l;
        wire ch_p = t_p + i;
        wire ch = *ch_p;
    }
    states {
        Entry: {
            t_p == null => RetInvalid;
            t_l == 0    => RetInvalid;
            _           => StripPtrLoop [ i <= 0 ];
        }
        StripPtrLoop: {
            has_more == 0 => CheckBase;
            ch == 42      => StripPtrNext; // '*'
            ch == 32      => StripPtrNext; // ' '
            ch == 9       => StripPtrNext; // '\t'
            _             => CheckBase;
        }
        StripPtrNext: {
            _ => StripPtrLoop [ i <= i + 1 ];
        }
        CheckBase: {
            let base_p = t_p + i;
            let base_l = t_l - i;
            base_l == 0 => RetInvalid;
            let entry = call find_type_map_entry(ctx, base_p, base_l);
            entry != null => RetValid;
            _             => RetInvalid;
        }
        RetValid: {
            _ => return 1;
        }
        RetInvalid: {
            _ => return 0;
        }
    }
}

machine report_undefined_type(ctx: *CodegenCtx, t_p: *u8, t_l: u32, loc_p: *u8, loc_l: u32) -> u32 {
    flow {
        reg i: u32 = 0;
        wire has_more = i < t_l;
        wire ch_p = t_p + i;
        wire ch = *ch_p;
    }
    states {
        Entry: {
            t_p == null => PrintUnknown;
            t_l == 0    => PrintUnknown;
            _           => StripPtrLoop [ i <= 0 ];
        }
        StripPtrLoop: {
            has_more == 0 => PrintErr;
            ch == 42      => StripPtrNext; // '*'
            ch == 32      => StripPtrNext; // ' '
            ch == 9       => StripPtrNext; // '\t'
            _             => PrintErr;
        }
        StripPtrNext: {
            _ => StripPtrLoop [ i <= i + 1 ];
        }
        PrintErr: {
            let base_p = t_p + i;
            let base_l = t_l - i;

            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            let _ = call diag_str("COMPILATION ERROR: Unknown base type '");
            let _ = call diag_write(base_p, base_l);
            let _ = call diag_str("'");
            loc_p != null => PrintLoc;
            _             => EndErr;
        }
        PrintUnknown: {
            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            let _ = call diag_str("COMPILATION ERROR: Unknown base type '<null>'");
            loc_p != null => PrintLoc;
            _             => EndErr;
        }
        PrintLoc: {
            let _ = call diag_str(" in '");
            let _ = call diag_write(loc_p, loc_l);
            let _ = call diag_str("'");
            _ => EndErr;
        }
        EndErr: {
            let _ = call diag_nl();
            let _ = call diag_str("================================================================================");
            let _ = call diag_nl();
            ctx.error_code <- -53;
            _ => return 0;
        }
    }
}

machine validate_type_or_err(ctx: *CodegenCtx, t_p: *u8, t_l: u32, loc_p: *u8, loc_l: u32) -> u32 {
    flow {}
    states {
        Entry: {
            t_p == null => RetOk;
            t_l == 0    => RetOk;
            let ok = call check_base_type_valid(ctx, t_p, t_l);
            ok == 0 => ReportErr;
            _       => RetOk;
        }
        ReportErr: {
            let _ = call report_undefined_type(ctx, t_p, t_l, loc_p, loc_l);
            _ => return 0;
        }
        RetOk: {
            _ => return 1;
        }
    }
}

machine validate_typedef_types(ctx: *CodegenCtx) -> u32 {
    flow {
        reg i: u32 = 0;
        reg j: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.type_count;
        wire has_more = i < cnt;
        wire fld_t = prog.types;
        wire cur_t = fld_t + i;
    }
    states {
        Entry: {
            cnt == 0 => Exit;
            _ => TypeLoop [ i <= 0 ];
        }
        TypeLoop: {
            has_more == 0 => Exit;
            let k = cur_t.kind;
            k == 0 => CheckStructFields [ j <= 0 ];
            _      => CheckBaseType;
        }
        CheckStructFields: {
            let f_cnt = cur_t.field_count;
            j >= f_cnt => NextType;
            let fld_arr = cur_t.fields;
            let cur_f = fld_arr + j;
            let _ = call validate_type_or_err(ctx, cur_f.type_ptr, cur_f.type_len, cur_t.name_ptr, cur_t.name_len);
            _ => CheckStructFields [ j <= j + 1 ];
        }
        CheckBaseType: {
            let _ = call validate_type_or_err(ctx, cur_t.base_ptr, cur_t.base_len, cur_t.name_ptr, cur_t.name_len);
            _ => NextType;
        }
        NextType: {
            _ => TypeLoop [ i <= i + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine validate_extern_types(ctx: *CodegenCtx) -> u32 {
    flow {
        reg i: u32 = 0;
        reg j: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.extern_count;
        wire has_more = i < cnt;
        wire fld_e = prog.externs;
        wire cur_e = fld_e + i;
    }
    states {
        Entry: {
            cnt == 0 => Exit;
            _ => ExternLoop [ i <= 0 ];
        }
        ExternLoop: {
            has_more == 0 => Exit;
            let _ = call validate_type_or_err(ctx, cur_e.ret_type_ptr, cur_e.ret_type_len, cur_e.name_ptr, cur_e.name_len);
            _ => ParamLoop [ j <= 0 ];
        }
        ParamLoop: {
            let p_cnt = cur_e.param_count;
            j >= p_cnt => NextExtern;
            let fld_p = cur_e.params;
            let cur_p = fld_p + j;
            let _ = call validate_type_or_err(ctx, cur_p.type_ptr, cur_p.type_len, cur_e.name_ptr, cur_e.name_len);
            _ => ParamLoop [ j <= j + 1 ];
        }
        NextExtern: {
            _ => ExternLoop [ i <= i + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine validate_machine_types(ctx: *CodegenCtx) -> u32 {
    flow {
        reg i: u32 = 0;
        reg j: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.machine_count;
        wire has_more = i < cnt;
        wire fld_m = prog.machines;
        wire cur_m = fld_m + i;
    }
    states {
        Entry: {
            cnt == 0 => Exit;
            _ => MachineLoop [ i <= 0 ];
        }
        MachineLoop: {
            has_more == 0 => Exit;
            let _ = call validate_type_or_err(ctx, cur_m.ret_type_ptr, cur_m.ret_type_len, cur_m.name_ptr, cur_m.name_len);
            _ => ParamLoop [ j <= 0 ];
        }
        ParamLoop: {
            let p_cnt = cur_m.param_count;
            j >= p_cnt => RegLoop [ j <= 0 ];
            let fld_p = cur_m.params;
            let cur_p = fld_p + j;
            let _ = call validate_type_or_err(ctx, cur_p.type_ptr, cur_p.type_len, cur_m.name_ptr, cur_m.name_len);
            _ => ParamLoop [ j <= j + 1 ];
        }
        RegLoop: {
            let r_cnt = cur_m.reg_count;
            j >= r_cnt => NextMachine;
            let fld_r = cur_m.regs;
            let cur_r = fld_r + j;
            let _ = call validate_type_or_err(ctx, cur_r.type_ptr, cur_r.type_len, cur_m.name_ptr, cur_m.name_len);
            _ => RegLoop [ j <= j + 1 ];
        }
        NextMachine: {
            _ => MachineLoop [ i <= i + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine validate_network_types(ctx: *CodegenCtx) -> u32 {
    flow {
        reg i: u32 = 0;
        reg j: u32 = 0;
        wire prog = ctx.prog;
        wire cnt = prog.network_count;
        wire has_more = i < cnt;
        wire fld_n = prog.networks;
        wire cur_n = fld_n + i;
    }
    states {
        Entry: {
            cnt == 0 => Exit;
            _ => NetLoop [ i <= 0 ];
        }
        NetLoop: {
            has_more == 0 => Exit;
            let _ = call validate_type_or_err(ctx, cur_n.ret_type_ptr, cur_n.ret_type_len, cur_n.name_ptr, cur_n.name_len);
            _ => ParamLoop [ j <= 0 ];
        }
        ParamLoop: {
            let p_cnt = cur_n.param_count;
            j >= p_cnt => NextNet;
            let fld_p = cur_n.params;
            let cur_p = fld_p + j;
            let _ = call validate_type_or_err(ctx, cur_p.type_ptr, cur_p.type_len, cur_n.name_ptr, cur_n.name_len);
            _ => ParamLoop [ j <= j + 1 ];
        }
        NextNet: {
            _ => NetLoop [ i <= i + 1 ];
        }
        Exit: {
            _ => return 0;
        }
    }
}

machine validate_all_program_types(ctx: *CodegenCtx) -> u32 {
    flow {}
    states {
        Entry: {
            let _ = call validate_typedef_types(ctx);
            let _ = call validate_extern_types(ctx);
            let _ = call validate_machine_types(ctx);
            let _ = call validate_network_types(ctx);
            _ => return 0;
        }
    }
}

machine is_type_64(t: *u8) -> u32 {
    flow {}
    states {
        Entry: {
            t == null => RetZero;
            let l = call strlen(t);
            let is_i64 = call str_eq(t, l, "i64", 3);
            is_i64 != 0 => RetOne;
            let is_u64 = call str_eq(t, l, "u64", 3);
            is_u64 != 0 => RetOne;
            let is_q64 = call str_eq(t, l, "q64", 3);
            is_q64 != 0 => RetOne;
            _ => RetZero;
        }
        RetOne:  { _ => return 1; }
        RetZero: { _ => return 0; }
    }
}

